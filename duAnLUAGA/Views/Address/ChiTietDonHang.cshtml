@using duAnLUAGA.Domain.Entitie
@model Hoadon

@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng #" + Model.MaHd;

    // Lấy thông tin User từ Model để hiển thị Sidebar
    var avatarSrc = !string.IsNullOrEmpty(Model.MaKhNavigation?.HinhAnh)
                    ? $"/img/{Model.MaKhNavigation.HinhAnh}"
                    : "/image/avatar.png";
    var fullName = Model.MaKhNavigation?.HoVaTen ?? "Thành viên";
}

<style>
    /* --- CSS CHUNG (Đồng bộ Sidebar) --- */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, sans-serif;
    }

    body {
        background: #f5f5f5;
        color: #333;
    }

    .profile-container {
        width: 1200px;
        margin: 20px auto;
        display: flex;
        gap: 20px;
    }

    /* Sidebar */
    .sidebar {
        width: 250px;
        background: #fff;
        padding: 20px;
        border-radius: 2px;
        height: fit-content;
        box-shadow: 0 1px 1px 0 rgba(0,0,0,.05);
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 15px;
        padding-bottom: 20px;
        border-bottom: 1px solid #efefef;
        margin-bottom: 15px;
    }

        .user-info img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid #e1e1e1;
        }

    .username {
        font-weight: 600;
        font-size: 14px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .menu {
        list-style: none;
    }

        .menu li {
            margin-bottom: 15px;
        }

        .menu a {
            text-decoration: none;
            color: #333;
            font-size: 14px;
            display: block;
            cursor: pointer;
            transition: 0.2s;
        }

            .menu a:hover, .menu a.active {
                color: #ee4d2d;
                font-weight: 500;
            }

    /* Content */
    .content {
        flex: 1;
    }
    /* Không set background trắng để các card tách rời */

    /* --- DETAIL ORDER STYLES --- */
    .btn-back-top {
        text-decoration: none;
        color: #555;
        font-size: 13px;
        display: inline-block;
        margin-bottom: 15px;
    }

        .btn-back-top:hover {
            color: #ee4d2d;
        }

    .card {
        background: #fff;
        border-radius: 2px;
        box-shadow: 0 1px 1px 0 rgba(0,0,0,.05);
        margin-bottom: 15px;
        overflow: hidden;
    }

    /* Header Trạng Thái */
    .status-header {
        padding: 20px 25px;
        border-bottom: 1px solid #eaeaea;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .status-text {
        color: #ee4d2d;
        text-transform: uppercase;
        font-weight: 500;
        font-size: 14px;
    }

    .order-id-text {
        font-size: 14px;
        color: #333;
    }

    /* Địa chỉ & Timeline */
    .address-section {
        padding: 25px 30px;
        display: flex;
        justify-content: space-between;
    }

    .section-title {
        font-size: 16px;
        font-weight: 500;
        margin-bottom: 15px;
        color: #333;
    }

    .addr-col {
        width: 45%;
        font-size: 14px;
        line-height: 1.6;
        color: #555;
    }

        .addr-col strong {
            color: #333;
        }

    .shipping-timeline {
        border-left: 1px solid #eaeaea;
        padding-left: 40px;
        width: 50%;
    }

    .timeline-item {
        position: relative;
        padding-left: 20px;
        margin-bottom: 10px;
    }

    .timeline-dot {
        position: absolute;
        left: 0;
        top: 6px;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #26aa99;
    }

    .timeline-time {
        color: #888;
        font-size: 12px;
        margin-bottom: 2px;
    }

    .timeline-desc {
        color: #26aa99;
        font-size: 13px;
    }

    /* Danh sách sản phẩm */
    .product-list {
        padding: 0 30px;
    }

    .product-item {
        display: flex;
        padding: 20px 0;
        border-bottom: 1px solid #eaeaea;
        align-items: center;
    }

        .product-item:last-child {
            border-bottom: none;
        }

    .prod-img {
        width: 80px;
        height: 80px;
        border: 1px solid #e1e1e1;
        object-fit: cover;
        margin-right: 15px;
    }

    .prod-info {
        flex: 1;
    }

    .prod-name {
        font-size: 14px;
        color: #333;
        margin-bottom: 5px;
        line-height: 1.4;
    }

    .prod-meta {
        font-size: 12px;
        color: #888;
    }

    .prod-price {
        font-size: 14px;
        color: #333;
        text-align: right;
        width: 120px;
    }

    /* Thanh toán */
    .payment-info-row {
        background: #fafdff;
        padding: 20px 30px;
        border-top: 1px solid #eaeaea;
        display: flex;
        justify-content: flex-end;
        gap: 40px;
    }

    .payment-method-col {
        margin-right: auto;
        font-size: 14px;
        max-width: 40%;
    }

    .pay-label {
        font-weight: 500;
        margin-bottom: 5px;
        display: block;
        color: #333;
    }

    .pay-val {
        color: #555;
    }

    .summary-box {
        width: 350px;
        font-size: 14px;
    }

    .sum-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
        color: #757575;
    }

        .sum-row.total {
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px dashed #ddd;
            align-items: center;
        }

    .final-price {
        font-size: 24px;
        color: #ee4d2d;
        font-weight: bold;
    }
</style>

<div class="profile-container">

    <aside class="sidebar">
        <div class="user-info">
            <img src="@avatarSrc" asp-append-version="true">
            <div class="username">@fullName</div>
        </div>

        <ul class="menu">
            <li><a href="/Address/Index"><i class="fa-solid fa-user"></i> Tài Khoản Của Tôi</a></li>
            <li><a class="active" href="/Address/Index#orders"><i class="fa-solid fa-clipboard-list"></i> Đơn Mua</a></li>
            <li><a href="/Address/Vouchers"><i class="fa-solid fa-ticket"></i> Kho Voucher</a></li>
            <li><a href="/Address/AddressBook"><i class="fa-solid fa-location-dot"></i> Địa Chỉ</a></li>
            <li><a href="/Address/DoiMK"><i class="fa-solid fa-lock"></i> Đổi Mật Khẩu</a></li>
        </ul>
    </aside>

    <main class="content">
        <a href="/Address/Index#orders" class="btn-back-top">
            <i class="fa-solid fa-chevron-left"></i> TRỞ LẠI
        </a>

        <div class="card">
            <div class="status-header">
                <div class="order-id-text">
                    MÃ ĐƠN HÀNG: #@Model.MaHd <span style="color:#ddd; margin:0 10px">|</span> @Model.NgayXuatHoaDon.ToString("dd-MM-yyyy HH:mm")
                </div>
                <div class="status-text">
                    @if (Model.TrangThai == "ChoXacNhan")
                    {
                        <span>CHỜ XÁC NHẬN</span>
                    }
                    else if (Model.TrangThai == "DaGiao")
                    {

                        <span style="color:#26aa99">ĐÃ GIAO HÀNG</span>
                    }
                    else if (Model.TrangThai == "DaHuy")
                    {

                        <span style="color:#888">ĐÃ HỦY</span>
                    }
                    else
                    {

                        <span>@Model.TrangThai</span>
                    }
                </div>
            </div>

            <div class="address-section">
                <div class="addr-col">
                    <div class="section-title">Địa Chỉ Nhận Hàng</div>
                    @if (Model.IdNavigation != null)
                    {
                        <div style="margin-bottom:5px;"><strong>@Model.IdNavigation.TenNhanHang</strong></div>
                        <div style="margin-bottom:5px; color:#888;">@Model.IdNavigation.Sdt</div>
                        <div style="color:#888;">
                            @Model.IdNavigation.DiaChiChiTiet<br>
                            @Model.IdNavigation.XaPhuong, @Model.IdNavigation.Tinh
                        </div>
                    }
                    else
                    {
                        <p>(Không tìm thấy thông tin địa chỉ)</p>
                    }
                </div>

                <div class="shipping-timeline">
                    <div class="section-title">Trạng Thái Vận Chuyển</div>
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-time">@Model.NgayXuatHoaDon.ToString("HH:mm dd-MM-yyyy")</div>
                        <div class="timeline-desc">Đặt hàng thành công</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="product-list">
                @foreach (var item in Model.Chitiethoadons)
                {
                    <div class="product-item">
                        <img src="@(string.IsNullOrEmpty(item.MaSpNavigation?.HinhDaiDien) ? "/img/no-image.png" : $"/img/{item.MaSpNavigation.HinhDaiDien}")" class="prod-img">
                        <div class="prod-info">
                            <div class="prod-name">@item.MaSpNavigation?.TenSanPham</div>
                            <div class="prod-meta">Phân loại: @(item.MaSpNavigation?.TacGia ?? "Mặc định")</div>
                            <div class="prod-meta">x @item.SoLuong</div>
                        </div>
                        <div class="prod-price">@item.DonGia.ToString("N0")₫</div>
                    </div>
                }
            </div>

            <div class="payment-info-row">
                <div class="payment-method-col">
                    <span class="pay-label">Phương thức thanh toán</span>
                    <span class="pay-val">
                        @if (Model.Httt == "COD")
                        {
                            <span>Thanh toán khi nhận hàng</span>
                        }
                        else if (Model.Httt == "LUAGAPAY")
                        {

                            <span>Ví LUAGAPAY</span>
                        }
                        else if (Model.Httt == "VNPAY")
                        {

                            <span>VNPAY / Thẻ ATM</span>
                        }
                        else
                        {

                            <span>@Model.Httt</span>
                        }
                    </span>
                </div>

                <div class="summary-box">
                    <div class="sum-row">
                        <span>Tổng tiền hàng</span>
                        <span>@((Model.ThanhTien - Model.PhiVanChuyen + Model.TienGiamGia).ToString("N0"))₫</span>
                    </div>
                    <div class="sum-row">
                        <span>Phí vận chuyển</span>
                        <span>@Model.PhiVanChuyen.ToString("N0")₫</span>
                    </div>
                    @if (Model.TienGiamGia > 0)
                    {
                        <div class="sum-row">
                            <span>Voucher giảm giá</span>
                            <span>-@Model.TienGiamGia.ToString("N0")₫</span>
                        </div>
                    }
                    <div class="sum-row total">
                        <span>Tổng thanh toán</span>
                        <span class="final-price">@Model.ThanhTien.ToString("N0")₫</span>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>