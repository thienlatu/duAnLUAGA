@using duAnLUAGA.ViewModel
@model AddressVM
@{
    ViewData["Title"] = "Đổi Mật Khẩu";
}

<style>
    /* --- CSS CHUNG (Đồng bộ toàn hệ thống) --- */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, sans-serif;
    }

    body {
        background: #f5f5f5;
        color: #333;
    }

    .profile-container {
        width: 1200px;
        margin: 20px auto;
        display: flex;
        gap: 20px;
    }

    /* Sidebar */
    .sidebar {
        width: 250px;
        background: #fff;
        padding: 20px;
        border-radius: 2px;
        height: fit-content;
        box-shadow: 0 1px 1px 0 rgba(0,0,0,.05);
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 15px;
        padding-bottom: 20px;
        border-bottom: 1px solid #efefef;
        margin-bottom: 15px;
    }

        .user-info img {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            object-fit: cover;
            border: 1px solid #e1e1e1;
        }

    .username {
        font-weight: 600;
        font-size: 14px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .menu {
        list-style: none;
    }

        .menu li {
            margin-bottom: 15px;
        }

        .menu a {
            text-decoration: none;
            color: #333;
            font-size: 14px;
            display: block;
            cursor: pointer;
            transition: 0.2s;
        }

            .menu a:hover, .menu a.active {
                color: #ee4d2d;
                font-weight: 500;
            }

    /* Content */
    .content {
        flex: 1;
        background: #fff;
        padding: 30px;
        border-radius: 2px;
        box-shadow: 0 1px 1px 0 rgba(0,0,0,.05);
        min-height: 600px;
    }

    /* Header */
    .header-section {
        border-bottom: 1px solid #efefef;
        padding-bottom: 15px;
        margin-bottom: 30px;
    }

    .header-title {
        font-size: 18px;
        font-weight: 500;
        margin-bottom: 5px;
    }

    .header-desc {
        font-size: 14px;
        color: #555;
    }

    /* Form Style */
    .form-container {
        max-width: 700px;
    }

    .form-group {
        margin-bottom: 20px;
        display: flex;
        align-items: center;
    }

    .form-label {
        width: 180px;
        text-align: right;
        margin-right: 20px;
        color: #555;
        font-size: 14px;
    }

    .form-input-wrap {
        flex: 1;
        position: relative;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #e0e0e0;
        border-radius: 2px;
        outline: none;
        transition: 0.3s;
        height: 40px;
    }

        .form-control:focus {
            border-color: #888;
        }

    .btn-save {
        background: #ee4d2d;
        color: #fff;
        border: none;
        padding: 10px 30px;
        border-radius: 2px;
        cursor: pointer;
        font-size: 14px;
        margin-left: 200px;
        transition: 0.2s;
    }

        .btn-save:hover {
            background: #d73211;
        }

    .text-danger {
        font-size: 12px;
        color: #dc3545;
        margin-top: 5px;
        display: block;
    }

    .message {
        padding: 10px;
        margin-bottom: 20px;
        border-radius: 4px;
        font-size: 14px;
    }

        .message.success {
            background: #eaf8f0;
            color: #1d8f4d;
            border: 1px solid #1d8f4d;
        }
</style>

<div class="profile-container">

    <aside class="sidebar">
        <div class="user-info">
            @{
                var avatarSrc = !string.IsNullOrEmpty(Model.ProfileAvatarPath)
                ? $"~/img/{Model.ProfileAvatarPath}"
                : "~/img/avatar.png";
            }
            <img src="@avatarSrc" asp-append-version="true">
            <div class="username">@(!string.IsNullOrWhiteSpace(Model.ProfileFullName) ? Model.ProfileFullName : "Thành viên")</div>
        </div>

        <ul class="menu">
            <li><a href="/Address/Index"><i class="fa-solid fa-user"></i> Tài Khoản Của Tôi</a></li>
            <li><a href="/Address/Index#orders"><i class="fa-solid fa-clipboard-list"></i> Đơn Mua</a></li>
            <li><a href="/Address/Vouchers"><i class="fa-solid fa-ticket"></i> Kho Voucher</a></li>
            <li><a href="/Address/AddressBook"><i class="fa-solid fa-location-dot"></i> Địa Chỉ</a></li>
            <li><a class="active" href="/Address/DoiMK"><i class="fa-solid fa-lock"></i> Đổi Mật Khẩu</a></li>
        </ul>
    </aside>

    <main class="content">
        <div class="header-section">
            <h3 class="header-title">Đổi Mật Khẩu</h3>
            <div class="header-desc">Để bảo mật tài khoản, vui lòng không chia sẻ mật khẩu cho người khác</div>
        </div>

        @if (TempData["PasswordMessage"] != null)
        {
            <div class="message success" id="notificationMessage">
                <i class="fa-solid fa-check-circle"></i> @TempData["PasswordMessage"]
            </div>
        }

        <div class="form-container">
            <form asp-action="DoiMK" method="post" id="changePasswordForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaKh" />

                <div class="form-group">
                    <label class="form-label">Mật khẩu hiện tại</label>
                    <div class="form-input-wrap">
                        <input asp-for="OldPassword" type="password" class="form-control" required />
                        <span asp-validation-for="OldPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Mật khẩu mới</label>
                    <div class="form-input-wrap">
                        <input asp-for="NewPassword" type="password" class="form-control" required />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Xác nhận mật khẩu</label>
                    <div class="form-input-wrap">
                        <input asp-for="ConfirmPassword" type="password" class="form-control" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="btn-save">Xác Nhận</button>
            </form>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            var form = $('#changePasswordForm');
            var newPassword = $('#NewPassword');
            var confirmPassword = $('#ConfirmPassword');
            var oldPassword = $('#OldPassword');

            // 1. Auto hide notification
            var msg = $('#notificationMessage');
            if (msg.length > 0) {
                setTimeout(function() {
                    msg.fadeOut(500);
                }, 3000);
            }

            // 2. Real-time validation match password
            function validateMatch() {
                if (confirmPassword.val() !== '' && newPassword.val() !== '') {
                    if (confirmPassword.val() !== newPassword.val()) {
                        confirmPassword[0].setCustomValidity('Mật khẩu xác nhận không khớp.');
                    } else {
                        confirmPassword[0].setCustomValidity('');
                    }
                }
            }

            confirmPassword.on('input', validateMatch);
            newPassword.on('input', validateMatch);

            // 3. Form submit
            form.on('submit', function (e) {
                validateMatch(); // Check lần cuối
                if (!form[0].checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                form.addClass('was-validated');
            });
        });
    </script>
}