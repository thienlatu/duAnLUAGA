@model duAnLUAGA.ViewModel.HomModel
@{
    ViewData["Title"] = "Home Page";
}

<link href="~/css/index.css" rel="stylesheet" />

<section class="home-hero">
    <div class="home-hero__inner">
        <!-- BANNER LỚN BÊN TRÁI -->
        <div class="hero-banner" data-hero-slider>
            <div class="hero-banner__viewport" data-slider-viewport>
                <div class="hero-banner__track" data-slider-track>
                    <!-- Slide 1 -->
                    <a class="hero-banner__slide"
                       data-slider-slide
                       href="#">
                        <img src="https://cdn1.fahasa.com/media/magentothem/banner7/PartnershipT11_Resize_840x320.png" alt="Banner 1 - Deal mỹ phẩm" />
                    </a>

                    <!-- Slide 2 -->
                    <a class="hero-banner__slide"
                       data-slider-slide
                       href="#">
                        <img src="https://cdn1.fahasa.com/media/magentothem/banner7/NgoaiVanT11_840x320_v2.png" alt="Banner 2 - Freeship 0đ" />
                    </a>

                    <!-- Slide 3 -->
                    <a class="hero-banner__slide"
                       data-slider-slide
                       href="">
                        <img src="https://bookbuy.vn/Res/Images/Album/0617c31a-18b5-44dd-af71-defe9654abd4.jpg?w=880&scale=both&h=320&mode=crop" alt="Banner 3 - Super Brand Day" />
                    </a>
                </div>

                <!-- Nút điều hướng -->
                <button class="hero-banner__arrow hero-banner__arrow--prev"
                        type="button"
                        data-slider-prev
                        aria-label="Ảnh trước">
                    <span>&lt;</span>
                </button>
                <button class="hero-banner__arrow hero-banner__arrow--next"
                        type="button"
                        data-slider-next
                        aria-label="Ảnh sau">
                    <span>&gt;</span>
                </button>

                <!-- Dots -->
                <div class="hero-banner__dots">
                    <button class="hero-banner__dot is-active" type="button" data-slider-dot></button>
                    <button class="hero-banner__dot" type="button" data-slider-dot></button>
                    <button class="hero-banner__dot" type="button" data-slider-dot></button>
                </div>
            </div>
        </div>

        <!-- 2 BANNER NHỎ BÊN PHẢI -->
        <div class="home-hero__side">
            <a class="home-hero__side-item"
               href="">
                <img src="https://cdn1.fahasa.com/media/wysiwyg/Thang-11-2025/chienthannguvan_t11_310x210.png"
                     alt="Thanh toán Visa Apple Pay" />
            </a>
            <a class="home-hero__side-item"
               href="https://example.com/freeship-bedroom">
                <img src="https://cdn1.fahasa.com/media/wysiwyg/Thang-11-2025/Homepage_T11_SmallBanner_1125_310x210_MCbooks.png"
                     alt="Freeship 0đ đơn hàng nệm" />
            </a>
        </div>
    </div>
</section>



@await Html.PartialAsync("_DanhSachSanPham", Model)

<style>
    .text-decoration-line-through {
        text-decoration: line-through;
    }

    .mt-n1 {
        margin-top: -0.25rem !important;
    }

</style>
<br />
<hr />
<div class="random-section-wrapper">
    <div class="random-title-container">
        <h2 class="random-title">Gợi Ý Cho Bạn</h2>
    </div>

    <div class="random-products-grid">
        @if (ViewBag.sanPhamNgauNhien != null)
        {
            @foreach (var sanpham in ViewBag.sanPhamNgauNhien)
            {
                bool coGiamGia = sanpham.PhanTramGiam > 0;

                string hinhAnh = !string.IsNullOrEmpty(sanpham.HinhDaiDien)
                ? sanpham.HinhDaiDien
                : "https://placehold.co/300x450/f0f0f0/333?text=No+Image";

                <div class="product-card">
                    <a asp-controller="ChiTSP" asp-action="Index" asp-route-id="@sanpham.MaSp"
                       class="card-link">

                        <div class="card-img-wrapper">
                            <img src="~/image/@hinhAnh"
                                 alt="@ShortText(@sanpham.TenSanPham, 20)"
                                 class="card-img" />

                            @if (coGiamGia)
                            {
                                <div class="badge-discount">
                                    -@sanpham.PhanTramGiam%
                                </div>
                            }
                        </div>

                        <div class="card-info">
                            <h3 class="card-name" title="@sanpham.TenSanPham">
                                <span>@ShortText(@sanpham.TenSanPham, 20)</span>
                            </h3>

                            <div class="card-author">
                                Tác giả: @(sanpham.TacGia ?? "Đang cập nhật")
                            </div>

                            <div class="card-price-group">
                                @if (coGiamGia)
                                {
                                    <div class="price-current">
                                        @sanpham.GiaSauGiam.ToString("#,##0")đ
                                    </div>
                                    <div class="price-old">
                                        @sanpham.Gia.ToString("#,##0")đ
                                    </div>
                                }
                                else
                                {
                                    <div class="price-current">
                                        @sanpham.Gia.ToString("#,##0")đ
                                    </div>
                                }
                            </div>

                            
                        </div>
                    </a>
                    <div class="card-footer">
                        <button class="btn-cart"
                                type="button"
                                data-masp="@sanpham.MaSp">
                            <i class="fa-solid fa-cart-plus"></i> Thêm giỏ hàng
                        </button>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="random-empty-message">Không tìm thấy sản phẩm đề xuất nào.</div>
        }
    </div>
</div>

<div class="random-btn-more-container ">
    <a href="@Url.Action("Index", "SanPham")" class="random-btn-more">
        Xem thêm sản phẩm
        <i class="fa-solid fa-arrow-right"></i>
    </a>
</div>
<div style="margin-top: 50px;">
</div>
<style>
    /* Container chính */
    .random-section-wrapper {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 15px;
    }

    .random-title {
        font-size: 28px;
        font-weight: 700;
        color: #333;
        margin: 0;
        padding: 20px 30px;
        border-radius: 50px;
        text-align: center;
        margin-left: 50px;
    }

    /* Grid sản phẩm */
    .random-products-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
    }

    .random-product-item {
        width: 100%;
    }

    btn-cart {
        width: 100%;
        background: white;
        border: 1px solid var(--primary-red);
        color: var(--primary-red);
        padding: 6px;
        border-radius: 4px;
        font-weight: 500;
        font-size: 13px;
        cursor: pointer;
        margin-top: 8px;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .btn-cart:hover {
        background: var(--primary-red);
        color: white;
    }
    /* Card sản phẩm */
    .random-product-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        transition: all 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        position: relative;
    }

        .random-product-card:hover {
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            transform: translateY(-5px);
        }

    /* Badge đề xuất */
    .random-badge-recommend {
        position: absolute;
        top: 10px;
        left: 10px;
        background: #17a2b8;
        color: white;
        font-size: 11px;
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 20px;
        z-index: 2;
        text-transform: uppercase;
    }

    /* Badge giảm giá */
    .random-badge-discount {
        position: absolute;
        top: 10px;
        right: 10px;
        background: #ffc107;
        color: #333;
        font-size: 13px;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 20px;
        z-index: 2;
    }

    /* Hình ảnh */
    .random-img-wrapper {
        width: 100%;
        height: 250px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        padding: 15px;
    }

    .random-img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        transition: transform 0.3s ease;
    }

    .random-product-card:hover .random-img {
        transform: scale(1.05);
    }

    /* Body card */
    .random-card-body {
        padding: 15px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .random-product-name {
        font-size: 16px;
        font-weight: 600;
        color: #333;
        margin: 0 0 10px 0;
        line-height: 1.4;
        height: 44px;
        overflow: hidden;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    /* Giá */
    .random-price-section {
        margin-bottom: 10px;
    }

    .random-price-old {
        font-size: 13px;
        color: #999;
        text-decoration: line-through;
        margin: 0 0 5px 0;
    }

    .random-price-new {
        font-size: 20px;
        font-weight: 700;
        color: #C92127;
        margin: 0;
    }

    /* Tác giả */
    .random-author {
        font-size: 13px;
        color: #666;
        margin: 0 0 15px 0;
    }

    /* Nút xem chi tiết */
    .random-btn-detail {
        display: block;
        width: 100%;
        height: 50px;
        padding: 10px;
        background: #C92127;
        color: white;
        text-align: center;
        border-radius: 6px;
        font-weight: 600;
        text-decoration: none;
        margin-top: auto;
        transition: all 0.3s ease;
    }

        .random-btn-detail:hover {
            background: #a01a1f;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(201, 33, 39, 0.3);
        }

    /* Message rỗng */
    .random-empty-message {
        grid-column: 1 / -1;
        text-align: center;
        color: #999;
        font-size: 16px;
        padding: 40px;
    }

    .random-btn-more-container {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 40px;
        width: 100%;
    }

    .random-btn-more {
        display: inline-flex;
        align-items: center;
        border: 2px solid red;
        gap: 10px;
        padding: 15px 40px;
        background-color: white;
        color: red;
        font-size: 16px;
        font-weight: 700;
        text-decoration: none;
        border-radius: 15px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        box-shadow: none !important; /* ✔ XÓA BÓNG */
    }

        .random-btn-more:hover {
            background: var(--primary-red);
            color: white;
            transform: translateY(-3px);
            box-shadow: none !important; /* ✔ XÓA BÓNG */
        }

        .random-btn-more i {
            transition: transform 0.3s ease;
        }

        .random-btn-more:hover i {
            transform: translateX(5px);
        }


    /* Message rỗng */
    .random-empty-message {
        grid-column: 1 / -1;
        text-align: center;
        color: #999;
        font-size: 16px;
        padding: 40px;
    }
</style>
<script>
    @functions {
                            public string ShortText(string text, int length = 20)
                            {
                                                    if (string.IsNullOrEmpty(text)) return "";
                                                    return text.Length > length ? text.Substring(0, length) + "..." : text;
                            }
    }
</script>
<script src="~/assets/js/banner.js"></script>