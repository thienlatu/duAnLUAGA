<script>
    lucide.createIcons();

    (function () {
        const scope = document.getElementById("luxIsolatedBanner");
        if (!scope) return;

        const slides = Array.from(scope.querySelectorAll(".lux-slide"));
        const dots = Array.from(scope.querySelectorAll(".lux-dot"));
        const prevBtn = scope.querySelector("[data-lux-prev]");
        const nextBtn = scope.querySelector("[data-lux-next]");

        let currentSlide = 0;
        let slideInterval = null;

        function renderSlides() {
            slides.forEach((el, idx) => {
                if (idx === currentSlide) {
                    el.classList.remove("tw-opacity-0", "tw-z-0");
                    el.classList.add("tw-opacity-100", "tw-z-10");
                } else {
                    el.classList.remove("tw-opacity-100", "tw-z-10");
                    el.classList.add("tw-opacity-0", "tw-z-0");
                }
            });

            dots.forEach((dot, idx) => {
                if (idx === currentSlide) {
                    dot.classList.remove("tw-bg-white/60", "tw-w-1.5", "md:tw-w-2");
                    dot.classList.add("tw-bg-primary", "tw-w-6", "md:tw-w-8");
                } else {
                    dot.classList.remove("tw-bg-primary", "tw-w-6", "md:tw-w-8");
                    dot.classList.add("tw-bg-white/60", "tw-w-1.5", "md:tw-w-2");
                }
            });
        }

        function nextSlide() {
            currentSlide = (currentSlide + 1) % slides.length;
            renderSlides();
        }

        function prevSlide() {
            currentSlide = (currentSlide - 1 + slides.length) % slides.length;
            renderSlides();
        }

        function resetTimer() {
            clearInterval(slideInterval);
            slideInterval = setInterval(nextSlide, 5000);
        }

        if (nextBtn) nextBtn.addEventListener("click", () => { nextSlide(); resetTimer(); });
        if (prevBtn) prevBtn.addEventListener("click", () => { prevSlide(); resetTimer(); });

        dots.forEach((dot) => {
            dot.addEventListener("click", () => {
                const idx = Number(dot.getAttribute("data-lux-dot"));
                if (!Number.isNaN(idx)) {
                    currentSlide = idx;
                    renderSlides();
                    resetTimer();
                }
            });
        });

        renderSlides();
        resetTimer();
    })();
</script>

