<style>
    /* --- CSS CHAT (GIỮ NGUYÊN) --- */
    #lx-wrapper {
        position: fixed;
        bottom: 0;
        right: 0;
        z-index: 2147483647;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        line-height: 1.5;
        color: #333;
    }

        #lx-wrapper * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            outline: none;
            font-size: 14px;
            text-decoration: none;
            list-style: none;
        }

    /* Nút mở chat */
    #lx-btn-main {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 60px !important;
        height: 60px !important;
        border-radius: 50% !important;
        background: linear-gradient(135deg, #DC2626, #B91C1C) !important;
        border: none !important;
        box-shadow: 0 4px 14px rgba(220, 38, 38, 0.4) !important;
        cursor: pointer;
        color: white !important;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s ease;
        z-index: 999999;
    }

        #lx-btn-main:hover {
            transform: scale(1.05);
        }

    /* Khung chat */
    #lx-box-container {
        position: fixed;
        bottom: 100px;
        right: 30px;
        width: 360px !important;
        height: 500px !important;
        background-color: #ffffff !important;
        border-radius: 16px !important;
        box-shadow: 0 10px 40px rgba(0,0,0,0.15) !important;
        display: none;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid #eee;
        z-index: 999999;
        animation: lxFadeInUp 0.3s ease;
    }

    @@keyframes lxFadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Header */
    .lx-header {
        background: linear-gradient(135deg, #DC2626, #B91C1C) !important;
        padding: 15px !important;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: white !important;
    }

    .lx-header-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .lx-avatar {
        width: 32px;
        height: 32px;
        background: rgba(255,255,255,0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .lx-info {
        display: flex;
        flex-direction: column;
    }

    .lx-name {
        font-weight: 600;
        font-size: 15px;
        color: white;
    }

    .lx-status {
        font-size: 11px;
        opacity: 0.9;
        color: white;
    }

    #lx-btn-close {
        background: transparent !important;
        border: none !important;
        cursor: pointer;
        padding: 5px;
    }

        #lx-btn-close:hover {
            opacity: 0.8;
        }

    /* Body */
    #lx-body-content {
        flex: 1;
        background-color: #f8f9fa !important;
        padding: 15px !important;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .lx-msg-row {
        display: flex;
        width: 100%;
        margin-bottom: 5px;
    }

    .lx-row-user {
        justify-content: flex-end;
    }

    .lx-row-bot {
        justify-content: flex-start;
    }

    .lx-bubble {
        max-width: 80%;
        padding: 10px 14px !important;
        border-radius: 12px !important;
        line-height: 1.4;
        word-wrap: break-word;
        white-space: pre-wrap;
    }

    .lx-bubble-bot {
        background: white !important;
        color: #333 !important;
        border: 1px solid #e5e5e5;
        border-bottom-left-radius: 2px !important;
    }

    .lx-bubble-user {
        background: linear-gradient(135deg, #DC2626, #B91C1C) !important;
        color: white !important;
        border-bottom-right-radius: 2px !important;
    }

    /* Product Cards in Chat */
    .lx-bubble-products {
        max-width: 100% !important;
        background: transparent !important;
        border: none !important;
        padding: 0 !important;
    }

    .lx-product-title {
        margin-bottom: 10px;
        font-weight: 600;
        background: white;
        padding: 8px 12px;
        border-radius: 12px;
        display: inline-block;
        border: 1px solid #e5e5e5;
    }

    .lx-product-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .lx-p-card {
        background: #fff;
        border: 1px solid #eee;
        border-radius: 10px;
        overflow: hidden;
        padding: 8px;
        display: flex;
        flex-direction: column;
    }

    .lx-p-link {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    .lx-p-card img {
        width: 100%;
        height: 100px;
        object-fit: cover;
        border-radius: 8px;
        background: #f3f3f3;
        margin-bottom: 6px;
    }

    .lx-p-name {
        font-weight: 600;
        font-size: 13px;
        line-height: 1.3;
        margin-bottom: 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 34px;
    }

    .lx-p-price {
        font-weight: 700;
        color: #d32f2f;
        margin-bottom: 8px;
    }

        .lx-p-price .old {
            font-weight: 400;
            text-decoration: line-through;
            color: #999;
            font-size: 12px;
            margin-left: 5px;
        }

    .lx-btn-addcart {
        width: 100%;
        margin-top: auto;
        height: 32px;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        background: #DC2626;
        color: #fff;
        font-size: 12px;
        font-weight: 600;
    }

        .lx-btn-addcart:disabled {
            background: #ccc;
            cursor: not-allowed;
        }

    /* Footer */
    .lx-footer {
        padding: 15px !important;
        background: white !important;
        border-top: 1px solid #eee;
        display: flex;
        align-items: center;
        gap: 10px;
        height: 70px;
    }

    #lx-input-field {
        flex: 1;
        height: 40px !important;
        border: 1px solid #ddd !important;
        border-radius: 20px !important;
        padding: 0 15px !important;
        background: white !important;
        color: #333 !important;
    }

        #lx-input-field:focus {
            border-color: #DC2626 !important;
        }

        #lx-input-field:disabled {
            background-color: #f0f0f0 !important;
            cursor: not-allowed;
        }

    #lx-btn-send {
        width: 40px !important;
        height: 40px !important;
        border-radius: 50% !important;
        background: #DC2626 !important;
        border: none !important;
        color: white !important;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        #lx-btn-send:disabled {
            background: #ccc !important;
            cursor: not-allowed;
        }

    /* Typing Animation */
    .lx-typing {
        display: flex;
        gap: 4px;
        padding: 12px 15px;
        background: white;
        border-radius: 12px;
        border-bottom-left-radius: 2px;
        width: fit-content;
        border: 1px solid #eee;
    }

    .lx-dot {
        width: 6px;
        height: 6px;
        background: #DC2626;
        border-radius: 50%;
        animation: lxBounce 1.4s infinite ease-in-out;
    }

        .lx-dot:nth-child(1) {
            animation-delay: -0.32s;
        }

        .lx-dot:nth-child(2) {
            animation-delay: -0.16s;
        }

    @@keyframes lxBounce {
        0%, 80%, 100% {
            transform: scale(0);
        }

        40% {
            transform: scale(1);
        }
    }

    /* Mobile */
    @@media (max-width: 480px) {
        #lx-box-container {
            width: 90% !important;
            right: 5%;
            bottom: 80px;
            height: 60vh !important;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // --- CẤU HÌNH ---
        const STORAGE_KEY = "LX_CHAT_HISTORY_V1";      // Tên khóa lưu dữ liệu
        const TIME_KEY = "LX_CHAT_LAST_ACTIVE";        // Tên khóa lưu thời gian
        const EXPIRE_DAYS = 2;                          // Số ngày hết hạn
        const EXPIRE_MS = EXPIRE_DAYS * 24 * 60 * 60 * 1000; // Đổi ra mili-giây

        // --- KHAI BÁO BIẾN UI ---
        const lxWrapper = document.getElementById('lx-wrapper');
        const lxBtnMain = document.getElementById('lx-btn-main');
        const lxBox = document.getElementById('lx-box-container');
        const lxBtnClose = document.getElementById('lx-btn-close');
        const lxInput = document.getElementById('lx-input-field');
        const lxBtnSend = document.getElementById('lx-btn-send');
        const lxBody = document.getElementById('lx-body-content');

        let isProcessing = false;

        // --- 1. LOAD LỊCH SỬ (CÓ KIỂM TRA HẠN SỬ DỤNG) ---
        loadChatHistory();

        function loadChatHistory() {
            const lastActive = localStorage.getItem(TIME_KEY);
            const currentTime = new Date().getTime();

            // KIỂM TRA: Nếu đã quá 2 ngày chưa chat -> Xóa sạch
            if (lastActive && (currentTime - lastActive > EXPIRE_MS)) {
                console.log("Lịch sử chat đã hết hạn (2 ngày). Đang xóa...");
                localStorage.removeItem(STORAGE_KEY);
                localStorage.removeItem(TIME_KEY);
                return; // Không load gì cả
            }

            // Nếu còn hạn -> Load bình thường
            const history = localStorage.getItem(STORAGE_KEY);
            if (history) {
                // Xóa tin nhắn chào mặc định
                const defaultMsg = document.querySelector('.lx-msg-row');
                if(defaultMsg) defaultMsg.remove();

                try {
                    const parsedHistory = JSON.parse(history);
                    parsedHistory.forEach(item => {
                        if (item.type === 'text') {
                            renderMessageText(item.content, item.sender);
                        } else if (item.type === 'products') {
                            renderProductsMessage(item.content.title, item.content.products);
                        }
                    });
                } catch (e) {
                    console.error("Lỗi đọc history cũ", e);
                    // Nếu lỗi format JSON thì xóa luôn cho sạch
                    localStorage.removeItem(STORAGE_KEY);
                }
            }
        }

        // --- 2. HÀM LƯU VÀO LOCALSTORAGE (KÈM TIMESTAMP) ---
        function saveToStorage(sender, type, content) {
            let history = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]");

            history.push({
                sender: sender,
                type: type,
                content: content,
                timestamp: new Date().getTime()
            });

            if (history.length > 50) history = history.slice(history.length - 50);

            // 1. Lưu nội dung chat
            localStorage.setItem(STORAGE_KEY, JSON.stringify(history));

            // 2. Cập nhật thời gian hoạt động mới nhất (Reset bộ đếm 2 ngày)
            localStorage.setItem(TIME_KEY, new Date().getTime());
        }

        // --- CÁC HÀM UI & LOGIC CHAT (GIỮ NGUYÊN) ---
        function scrollToBottom() { lxBody.scrollTop = lxBody.scrollHeight; }
        function formatVnd(n) { return new Intl.NumberFormat('vi-VN').format(n || 0) + " đ"; }
        function normalizeImage(src) {
            if (!src) return "/image/no-image.png";
            if (src.startsWith("~/")) return src.replace("~/", "/");
            if (src.startsWith("http") || src.startsWith("/")) return src;
            return "/image/" + src;
        }

        // Open Chat
        lxBtnMain.addEventListener('click', (e) => {
            e.stopPropagation();
            lxBox.style.display = 'flex';
            lxBtnMain.style.display = 'none';
            lxInput.focus();
            scrollToBottom();
        });

        // Close Chat
        lxBtnClose.addEventListener('click', () => closeChat());
        document.addEventListener('click', function(event) {
            if (lxBox.style.display === 'flex') {
                if (!lxBox.contains(event.target) && !lxBtnMain.contains(event.target)) {
                    closeChat();
                }
            }
        });
        function closeChat() {
            lxBox.style.display = 'none';
            lxBtnMain.style.display = 'flex';
        }

        // Send Message Logic
        async function sendMessage() {
            const text = lxInput.value.trim();
            if (isProcessing || !text) return;

            isProcessing = true;
            lxInput.disabled = true;
            lxBtnSend.disabled = true;

            // Render & Save User Message
            renderMessageText(text, 'user');
            saveToStorage('user', 'text', text);

            lxInput.value = '';
            showTyping();

            try {
                const response = await fetch('/Chat/GetReply', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: text })
                });

                const data = await response.json();
                removeTyping();

                if (data.type === "products" && Array.isArray(data.products)) {
                    renderProductsMessage(data.reply || "", data.products);
                    saveToStorage('bot', 'products', { title: data.reply, products: data.products });
                } else {
                    const replyText = data.reply || "Không có phản hồi.";
                    renderMessageText(replyText, 'bot');
                    saveToStorage('bot', 'text', replyText);
                }

            } catch (error) {
                console.error(error);
                removeTyping();
                renderMessageText("Lỗi kết nối server. Vui lòng thử lại sau.", 'bot');
            } finally {
                isProcessing = false;
                lxInput.disabled = false;
                lxInput.focus();
                lxBtnSend.disabled = true;
            }
        }

        // Render Text
        function renderMessageText(text, sender) {
            const rowDiv = document.createElement('div');
            rowDiv.className = `lx-msg-row lx-row-${sender}`;
            const bubbleDiv = document.createElement('div');
            bubbleDiv.className = `lx-bubble lx-bubble-${sender}`;
            bubbleDiv.innerHTML = text;
            rowDiv.appendChild(bubbleDiv);
            lxBody.appendChild(rowDiv);
            scrollToBottom();
        }

        // Render Products
        function renderProductsMessage(title, products) {
            const rowDiv = document.createElement('div');
            rowDiv.className = 'lx-msg-row lx-row-bot';
            const bubbleDiv = document.createElement('div');
            bubbleDiv.className = 'lx-bubble lx-bubble-bot lx-bubble-products';

            if (title) {
                const titleDiv = document.createElement('div');
                titleDiv.className = 'lx-product-title';
                titleDiv.textContent = title;
                bubbleDiv.appendChild(titleDiv);
            }

            const grid = document.createElement('div');
            grid.className = 'lx-product-grid';

            (products || []).forEach(p => {
                const card = document.createElement('div');
                card.className = 'lx-p-card';
                const detailUrl = `/ChiTSP/Index/${p.maSp}`;

                // Image Link
                const linkImg = document.createElement('a');
                linkImg.href = detailUrl;
                linkImg.className = 'lx-p-link';
                const img = document.createElement('img');
                img.src = normalizeImage(p.hinhDaiDien);
                linkImg.appendChild(img);
                card.appendChild(linkImg);

                // Name Link
                const linkName = document.createElement('a');
                linkName.href = detailUrl;
                linkName.className = 'lx-p-link lx-p-name';
                linkName.textContent = p.tenSanPham || "Sản phẩm";
                card.appendChild(linkName);

                // Price
                const price = document.createElement('div');
                price.className = 'lx-p-price';
                const hasSale = (p.giaSauGiam && p.gia && p.giaSauGiam < p.gia);
                if (hasSale) {
                    price.innerHTML = `${formatVnd(p.giaSauGiam)} <span class="old">${formatVnd(p.gia)}</span>`;
                } else {
                    price.textContent = formatVnd(p.gia || 0);
                }
                card.appendChild(price);

                // Add to Cart Button
                const btn = document.createElement('button');
                btn.className = 'lx-btn-addcart';
                btn.textContent = 'Thêm vào giỏ';
                btn.addEventListener('click', async () => {
                    btn.disabled = true;
                    btn.textContent = "...";
                    await addToCart(p.maSp, 1);
                    btn.disabled = false;
                    btn.textContent = "Thêm vào giỏ";
                });
                card.appendChild(btn);
                grid.appendChild(card);
            });

            bubbleDiv.appendChild(grid);
            rowDiv.appendChild(bubbleDiv);
            lxBody.appendChild(rowDiv);
            scrollToBottom();
        }

        // UI Effects
        function showTyping() {
            const rowDiv = document.createElement('div');
            rowDiv.id = 'lx-typing-indicator';
            rowDiv.className = 'lx-msg-row lx-row-bot';
            rowDiv.innerHTML = `<div class="lx-typing"><div class="lx-dot"></div><div class="lx-dot"></div><div class="lx-dot"></div></div>`;
            lxBody.appendChild(rowDiv);
            scrollToBottom();
        }

        function removeTyping() {
            const el = document.getElementById('lx-typing-indicator');
            if (el) el.remove();
        }

        // Add to Cart Logic
        async function addToCart(maSp, soLuong = 1) {
            try {
                const body = new URLSearchParams();
                body.append("maSp", maSp);
                body.append("soLuong", soLuong);
                const res = await fetch("/Cart/AddToCart", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8" },
                    body: body.toString()
                });
                const data = await res.json();
                if (data.success) {
                    renderMessageText(`✅ Đã thêm vào giỏ! (Tổng: ${data.cartCount})`, 'bot');
                    // Không lưu thông báo hệ thống vào Storage để tránh rác
                } else {
                    renderMessageText(`❌ ${data.message || "Lỗi."}`, 'bot');
                }
            } catch (e) {
                renderMessageText("❌ Lỗi hệ thống.", 'bot');
            }
        }

        // Bind Events
        lxBtnSend.addEventListener('click', sendMessage);
        lxInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') sendMessage(); });
        lxInput.addEventListener('input', () => { if (!isProcessing) lxBtnSend.disabled = !lxInput.value.trim(); });
    });
</script>