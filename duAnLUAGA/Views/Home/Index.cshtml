<div class="random-section-wrapper">
    <div class="random-title-container">
        <h2 class="random-title">Gợi Ý Cho Bạn</h2>
    </div>

    <div class="random-products-grid">
        @if (ViewBag.sanPhamNgauNhien != null)
        {
            @foreach (var sanpham in ViewBag.sanPhamNgauNhien)
            {
                bool coGiamGia = sanpham.PhanTramGiam > 0;

                string hinhAnh = !string.IsNullOrEmpty(sanpham.HinhDaiDien)
                ? sanpham.HinhDaiDien
                : "https://placehold.co/300x450/f0f0f0/333?text=No+Image";

                <div class="product-card">
                    <a asp-controller="ChiTSP" asp-action="Index" asp-route-id="@sanpham.MaSp"
                       class="card-link">

                        <div class="card-img-wrapper">
                            <img src="~/image/@hinhAnh"
                                 alt="@ShortText(@sanpham.TenSanPham, 20)"
                                 class="card-img" />

                            @if (coGiamGia)
                            {
                                <div class="badge-discount">
                                    -@sanpham.PhanTramGiam%
                                </div>
                            }
                        </div>

                        <div class="card-info">
                            <h3 class="card-name" title="@sanpham.TenSanPham">
                                <span>@ShortText(@sanpham.TenSanPham, 20)</span>
                            </h3>

                            <div class="card-author">
                                Tác giả: @(sanpham.TacGia ?? "Đang cập nhật")
                            </div>

                            <div class="card-price-group">
                                @if (coGiamGia)
                                {
                                    <div class="price-current">
                                        @sanpham.GiaSauGiam.ToString("#,##0")đ
                                    </div>
                                    <div class="price-old">
                                        @sanpham.Gia.ToString("#,##0")đ
                                    </div>
                                }
                                else
                                {
                                    <div class="price-current">
                                        @sanpham.Gia.ToString("#,##0")đ
                                    </div>
                                }
                            </div>
                        </div>
                    </a>
                    <div class="card-footer">
                        <button class="btn-cart"
                                type="button"
                                data-masp="@sanpham.MaSp">
                            <i class="fa-solid fa-cart-plus"></i> Thêm giỏ hàng
                        </button>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="random-empty-message">Không tìm thấy sản phẩm đề xuất nào.</div>
        }
    </div>
</div>

