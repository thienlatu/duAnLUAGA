@{
    ViewData["Title"] = "Home Page";
}

<link href="~/css/index.css" rel="stylesheet" />

<section class="home-hero">
    <div class="home-hero__inner">
        <!-- BANNER LỚN BÊN TRÁI -->
        <div class="hero-banner" data-hero-slider>
            <div class="hero-banner__viewport" data-slider-viewport>
                <div class="hero-banner__track" data-slider-track>
                    <!-- Slide 1 -->
                    <a class="hero-banner__slide"
                       data-slider-slide
                       href="#">
                        <img src="https://cdn1.fahasa.com/media/magentothem/banner7/PartnershipT11_Resize_840x320.png" alt="Banner 1 - Deal mỹ phẩm" />
                    </a>

                    <!-- Slide 2 -->
                    <a class="hero-banner__slide"
                       data-slider-slide
                       href="#">
                        <img src="https://cdn1.fahasa.com/media/magentothem/banner7/NgoaiVanT11_840x320_v2.png" alt="Banner 2 - Freeship 0đ" />
                    </a>

                    <!-- Slide 3 -->
                    <a class="hero-banner__slide"
                       data-slider-slide
                       href="">
                        <img src="https://bookbuy.vn/Res/Images/Album/0617c31a-18b5-44dd-af71-defe9654abd4.jpg?w=880&scale=both&h=320&mode=crop" alt="Banner 3 - Super Brand Day" />
                    </a>
                </div>

                <!-- Nút điều hướng -->
                <button class="hero-banner__arrow hero-banner__arrow--prev"
                        type="button"
                        data-slider-prev
                        aria-label="Ảnh trước">
                    <span>&lt;</span>
                </button>
                <button class="hero-banner__arrow hero-banner__arrow--next"
                        type="button"
                        data-slider-next
                        aria-label="Ảnh sau">
                    <span>&gt;</span>
                </button>

                <!-- Dots -->
                <div class="hero-banner__dots">
                    <button class="hero-banner__dot is-active" type="button" data-slider-dot></button>
                    <button class="hero-banner__dot" type="button" data-slider-dot></button>
                    <button class="hero-banner__dot" type="button" data-slider-dot></button>
                </div>
            </div>
        </div>

        <!-- 2 BANNER NHỎ BÊN PHẢI -->
        <div class="home-hero__side">
            <a class="home-hero__side-item"
               href="">
                <img src="https://cdn1.fahasa.com/media/wysiwyg/Thang-11-2025/chienthannguvan_t11_310x210.png"
                     alt="Thanh toán Visa Apple Pay" />
            </a>
            <a class="home-hero__side-item"
               href="https://example.com/freeship-bedroom">
                <img src="https://cdn1.fahasa.com/media/wysiwyg/Thang-11-2025/Homepage_T11_SmallBanner_1125_310x210_MCbooks.png"
                     alt="Freeship 0đ đơn hàng nệm" />
            </a>
        </div>
    </div>
</section>



<script src="~/assets/js/banner.js"></script>