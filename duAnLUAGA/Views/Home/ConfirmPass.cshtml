@{
    Layout = "_Layout";
    ViewData["Title"] = "Đặt lại mật khẩu - LUAGA";
    var email = ViewBag.Email as string ?? Context.Request.Query["email"].ToString();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
<link href="~/css/ComPlete.css" rel="stylesheet" />

<main class="lv-auth" role="main">
    <div class="container-xl">
        <div class="lv-auth__shell">
            <!-- Brand -->
            <aside class="lv-auth__brand" aria-label="LUAGA brand">
                <h1 style="text-align : center" class="lv-brand__logo">LUAGA</h1>
                <p style="text-align : center" class="lv-brand__tag">LUXURY BOOK</p>
            </aside>

            <!-- Card -->
            <section class="lv-auth__card" aria-labelledby="lvResetTitle">
                <div class="lv-card__head">
                    <span class="lv-head__dash" aria-hidden="true"></span>
                    <h2 id="lvResetTitle" class="lv-head__title">Đặt lại mật khẩu</h2>
                    <p class="lv-head__subtitle">Tạo mật khẩu mới cho tài khoản của bạn</p>
                </div>

                <!-- Success / Error Message từ server -->
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="lv-success" style="background:#ffdddd;color:#c00;" aria-live="polite">
                        @TempData["ErrorMessage"]
                    </div>
                }
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="lv-success" aria-live="polite">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <div class="lv-success" id="lvSuccessMsg" aria-live="polite"></div>

                <form asp-action="ConfirmPass"
                      asp-controller="Home"
                      method="post"
                      class="lv-form"
                      id="lvResetForm"
                      >
                    <!-- Hidden email -->
                    <input type="hidden" name="email" value="@email" />

                    <!-- New Password -->
                    <div class="lv-field">
                        <label for="lvNewPassword" class="lv-label">Mật khẩu mới</label>
                        <div class="lv-password">
                            <input id="lvNewPassword"
                                   name="password"
                                   type="password"
                                   class="lv-input"
                                   placeholder="Nhập mật khẩu mới"
                                   autocomplete="new-password"
                                   required maxlength="40" />
                        </div>
                        <small class="lv-error" id="lvPasswordErr" aria-live="polite"></small>

                        <!-- Password Strength -->
                        <div class="lv-strength" id="lvStrength" style="display: none;">
                            <div class="lv-strength__bar">
                                <div class="lv-strength__fill" id="lvStrengthFill"></div>
                            </div>
                            <span class="lv-strength__text" id="lvStrengthText"></span>
                        </div>

                        <!-- Password Requirements -->
                        <ul class="lv-requirements" id="lvRequirements">
                            <li id="req-length">Ít nhất 8 ký tự</li>
                            <li id="req-upper">Có chữ hoa (A-Z)</li>
                            <li id="req-lower">Có chữ thường (a-z)</li>
                            <li id="req-number">Có số (0-9)</li>
                            <li id="req-special">Có ký tự đặc biệt ($!%*?&)</li>
                        </ul>
                    </div>

                    <!-- Confirm Password -->
                    <div class="lv-field">
                        <label for="lvConfirmPassword" class="lv-label">Xác nhận mật khẩu</label>
                        <div class="lv-password">
                            <input id="lvConfirmPassword"
                                   name="confirmPassword"
                                   type="password"
                                   class="lv-input"
                                   placeholder="Nhập lại mật khẩu mới"
                                   autocomplete="new-password"
                                   required  maxlength="40"/>
                        </div>
                        <small class="lv-error" id="lvConfirmErr" aria-live="polite"></small>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="lv-btn lv-btn--primary" id="lvSubmitBtn" disabled>
                        Đặt lại mật khẩu
                    </button>

                    <p class="lv-note">
                        Nhớ mật khẩu? <a asp-action="Login" asp-controller="Home" class="lv-link">Đăng nhập</a>
                    </p>
                </form>
            </section>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        // Elements
        const form = document.getElementById('lvResetForm');
        const newPassword = document.getElementById('lvNewPassword');
        const confirmPassword = document.getElementById('lvConfirmPassword');
        const passwordErr = document.getElementById('lvPasswordErr');
        const confirmErr = document.getElementById('lvConfirmErr');
        const submitBtn = document.getElementById('lvSubmitBtn');
        const strengthDiv = document.getElementById('lvStrength');
        const strengthFill = document.getElementById('lvStrengthFill');
        const strengthText = document.getElementById('lvStrengthText');

        // Bị thiếu cái này lúc trước
        const requirements = {
            length:  { regex: /.{8,}/,    element: document.getElementById('req-length') },
            upper:   { regex: /[A-Z]/,    element: document.getElementById('req-upper') },
            lower:   { regex: /[a-z]/,    element: document.getElementById('req-lower') },
            number:  { regex: /[0-9]/,    element: document.getElementById('req-number') },
            special: { regex: /[$!%*?&]/, element: document.getElementById('req-special') }
        };

        function checkPasswordStrength(password) {
            let score = 0;
            let validCount = 0;

            for (let key in requirements) {
                if (requirements[key].regex.test(password)) {
                    requirements[key].element.classList.add('valid');
                    validCount++;
                } else {
                    requirements[key].element.classList.remove('valid');
                }
            }

            if (password.length === 0) {
                strengthDiv.style.display = 'none';
                return { strength: 'none', score: 0 };
            }

            strengthDiv.style.display = 'block';

            if (validCount <= 2) {
                score = 1;
            } else if (validCount <= 4) {
                score = 2;
            } else {
                score = 3;
            }

            strengthFill.className = 'lv-strength__fill';
            strengthText.className = 'lv-strength__text';

            if (score === 1) {
                strengthFill.classList.add('weak');
                strengthText.classList.add('weak');
                strengthText.textContent = 'Mật khẩu yếu';
            } else if (score === 2) {
                strengthFill.classList.add('medium');
                strengthText.classList.add('medium');
                strengthText.textContent = 'Mật khẩu trung bình';
            } else {
                strengthFill.classList.add('strong');
                strengthText.classList.add('strong');
                strengthText.textContent = 'Mật khẩu mạnh';
            }

            return {
                strength: score === 1 ? 'weak' : (score === 2 ? 'medium' : 'strong'),
                score,
                validCount
            };
        }

        function validatePassword() {
            const password = newPassword.value;
            passwordErr.textContent = '';

            if (password.length === 0) {
                newPassword.classList.remove('error', 'success');
                strengthDiv.style.display = 'none';
                return false;
            }

            checkPasswordStrength(password);

            if (password.length < 8) {
                newPassword.classList.add('error');
                newPassword.classList.remove('success');
                passwordErr.textContent = 'Mật khẩu phải có ít nhất 8 ký tự';
                return false;
            }

            newPassword.classList.add('success');
            newPassword.classList.remove('error');
            return true;
        }

        function validateConfirmPassword() {
            const password = newPassword.value;
            const confirm = confirmPassword.value;
            confirmErr.textContent = '';

            if (confirm.length === 0) {
                confirmPassword.classList.remove('error', 'success');
                return false;
            }

            if (password !== confirm) {
                confirmPassword.classList.add('error');
                confirmPassword.classList.remove('success');
                confirmErr.textContent = 'Mật khẩu không khớp';
                return false;
            }

            confirmPassword.classList.add('success');
            confirmPassword.classList.remove('error');
            return true;
        }

        function updateSubmitButton() {
            const passwordValid = validatePassword();
            const confirmValid = validateConfirmPassword();
            submitBtn.disabled = !(passwordValid && confirmValid);
        }

        newPassword.addEventListener('input', () => {
            checkPasswordStrength(newPassword.value);
            updateSubmitButton();
        });

        newPassword.addEventListener('blur', validatePassword);

        confirmPassword.addEventListener('input', updateSubmitButton);
        confirmPassword.addEventListener('blur', validateConfirmPassword);
    </script>
}
