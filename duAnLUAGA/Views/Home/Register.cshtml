@model duAnLUAGA.ViewModel.RegisterVM
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/site.css" rel="stylesheet" />
<main class="lv-auth" id="page-register" role="main">
    <div class="container-xl">
        <div class="lv-auth__shell">
            <!-- Thương hiệu -->
            <aside class="lv-auth__brand" aria-label="LUAGA brand">
                <h1 class="lv-brand__logo text-center">LUAGA</h1>
                <p class="lv-brand__tag text-center">LUXURY BOOK</p>
            </aside>

            <!-- Card form -->
            <section class="lv-auth__card" aria-labelledby="lvRegisterTitle" style=" margin-bottom :0">
                <div class="lv-card__head">
                    <span class="lv-head__dash" aria-hidden="true"></span>
                    <h2 id="lvRegisterTitle" class="lv-head__title">Tạo tài khoản</h2>
                </div>

                <form asp-controller="Home" asp-action="Register" class="lv-form" method="post" novalidate>
                    <!-- Họ & tên -->
                    <div class="lv-field">
                        <label for="lvFullname" class="lv-label">Họ &amp; tên</label>
                        <input  id="lvFullname" asp-for ="HoVaTen" type="text"
                               class="lv-input"
                               placeholder="Nhập đúng họ và tên"
                               autocomplete="name" required>
                        <small class="lv-error" id="lvFullnameErr" aria-live="polite"></small>
                    </div>

                    <!-- Email -->
                    <div class="lv-field">
                        <label for="lvRegEmail" class="lv-label">Email</label>
                        <input id="lvRegEmail" asp-for="Email" type="email"
                               class="lv-input"
                               placeholder="your@email.com"
                               inputmode="email" autocomplete="email" required>
                        <small class="lv-error" id="lvRegEmailErr" aria-live="polite">@ViewBag.Error </small>
                    </div>

                    <!-- Mật khẩu -->
                    <div class="lv-field">
                        <label for="lvRegPassword" class="lv-label">Mật khẩu</label>
                        <div class="lv-password">
                            <input id="lvRegPassword" type="password"
                                    class="lv-input lv-password__input"
                                   placeholder="Tối thiểu 8 ký tự"
                                   minlength="8" autocomplete="new-password" required
                                   aria-describedby="lvPassHelp">
                            <button type="button" class="lv-password__toggle"
                                    aria-label="Hiện/ẩn mật khẩu" aria-pressed="false">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div id="lvPassHelp" class="lv-help">
                            Nên có chữ hoa, số &amp; ký tự đặc biệt.
                        </div>
                        <div class="lv-passmeter" aria-hidden="true">
                            <span class="lv-passmeter__bar" style="width:0%"></span>
                        </div>
                        <small class="lv-error" id="lvRegPassErr" aria-live="polite"></small>
                    </div>

                    <!-- Xác nhận mật khẩu -->
                    <div class="lv-field">
                        <label for="lvRegConfirm" class="lv-label">Xác nhận mật khẩu</label>
                        <div class="lv-password">
                            <input id="lvRegConfirm" asp-for="MatKhau" type="password"
                                   class="lv-input lv-password__input"
                                   placeholder="Nhập lại mật khẩu"
                                   minlength="8" autocomplete="new-password" required>
                            <button type="button" class="lv-password__toggle"
                                    aria-label="Hiện/ẩn mật khẩu" aria-pressed="false">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <small class="lv-error" id="lvRegConfirmErr" aria-live="polite"></small>
                    </div>
                   @* <span style="margin-bottom: 12px; margin-top:12px" class="text-danger"></span> *@
                    <!-- Submit -->
                    <button type="submit" class="lv-btn lv-btn--primary">Tạo tài khoản</button>

                    <!-- Divider -->
                    <div class="lv-divider" role="separator"><span>hoặc</span></div>

                    <!-- Google -->
                    <a class="lv-btn lv-btn--outline lv-btn--google"
                       asp-controller="Home" asp-action="LoginWithGoogle" role="button"
                       aria-label="Đăng ký bằng Google">
                        <span class="lv-btn__icon" aria-hidden="true">
                            <!-- Google G -->
                            <svg width="18" height="18" viewBox="0 0 48 48" focusable="false" aria-hidden="true">
                                <path fill="#FFC107" d="M43.611 20.083h-1.611V20H24v8h11.303c-1.645 4.657-6.08 8-11.303 8-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.153 7.948 3.052l5.657-5.657C34.316 6 29.392 4 24 4 12.954 4 4 12.954 4 24s8.954 20 20 20 20-8.954 20-20c0-1.339-.138-2.651-.389-3.917z" />
                                <path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.71 16.2 18.994 12 24 12c3.059 0 5.842 1.153 7.948 3.052l5.657-5.657C34.316 6 29.392 4 24 4 16.319 4 9.661 8.336 6.306 14.691z" />
                                <path fill="#4CAF50" d="M24 44c5.274 0 10.113-2.013 13.74-5.291l-6.341-5.405C29.339 35.147 26.809 36 24 36c-5.192 0-9.601-3.323-11.253-7.946l-6.499 5.01C8.569 39.688 15.758 44 24 44z" />
                                <path fill="#1976D2" d="M43.611 20.083h-1.611V20H24v8h11.303c-.788 2.442-2.365 4.5-4.556 5.974l.001-.001 6.341 5.405C39.23 36.933 44 31.333 44 24c0-1.339-.138-2.651-.389-3.917z" />
                            </svg>
                        </span>
                        Đăng ký bằng Google
                    </a>

                    <p class="lv-note">
                        Đã có tài khoản?
                        <a class="lv-link" asp-controller ="Home" asp-action="Login">Đăng nhập</a>
                    </p>
                </form>
            </section>
        </div>
    </div>
</main>
<style>

    /* --- Delta cho Register --- */

    /* Ẩn nút mở panel login ở trang ĐĂNG KÝ để không bị chồng chéo UI header */
    body.page-register #openLogin {
        display: none !important;
    }

    /* Gợi ý bên dưới input */
    .lv-help {
        margin-top: 8px;
        color: var(--lv-muted);
        font-size: .85rem;
    }

    /* Thanh đo độ mạnh mật khẩu */
    .lv-passmeter {
        height: 6px;
        background: #eee;
        border-radius: 999px;
        margin-top: 10px;
        overflow: hidden;
    }

    .lv-passmeter__bar {
        display: block;
        height: 100%;
        width: 0%;
        background: var(--lv-brand);
        transition: width .25s ease;
    }

    .lv-auth__card {
        width: 800px
    }
</style>

<script src="~/assets/js/index.js"></script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}






