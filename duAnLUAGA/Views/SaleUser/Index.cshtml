@model duAnLUAGA.Domain.Entitie.Flashsale

@{
    ViewData["Title"] = "Săn Deal Flash Sale";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var endTimeString = Model != null ? Model.NgayKetThuc.ToString("yyyy-MM-ddTHH:mm:ss") : "";
}

<style>
    :root {
        --lux-red: #d0021b;
        --lux-red-light: #ffebee;
        --lux-text: #333333;
        --lux-gray: #f5f5f5;
    }

    body {
        background-color: #fff;
        color: var(--lux-text);
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    }

    .fs-page-container {
        min-height: 80vh;
        padding-bottom: 80px;
    }

    .fs-header-white {
        background: #fff;
        border-bottom: 1px solid #eee;
        padding: 40px 0 30px;
        text-align: center;
        margin-bottom: 40px;
        position: relative;
    }

        .fs-header-white::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 50%;
            transform: translateX(-50%);
            width: 100px;
            height: 3px;
            background: var(--lux-red);
        }

    .fs-title-main {
        font-size: 2.2rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--lux-red);
        margin-bottom: 15px;
    }

    .fs-subtitle {
        color: #666;
        font-size: 1rem;
        margin-bottom: 25px;
    }

    .timer-white {
        display: inline-flex;
        gap: 15px;
        align-items: center;
        justify-content: center;
        background: var(--lux-red-light);
        padding: 10px 30px;
        border-radius: 50px;
        border: 1px solid #ffcdd2;
    }

    .tw-box {
        text-align: center;
        min-width: 50px;
    }

    .tw-num {
        display: block;
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--lux-red);
        line-height: 1;
        font-family: sans-serif;
    }

    .tw-lbl {
        font-size: 0.7rem;
        text-transform: uppercase;
        color: #d32f2f;
        margin-top: 4px;
        font-weight: 600;
    }

    .tw-sep {
        font-size: 1.5rem;
        color: #e57373;
        font-weight: 300;
        margin-top: -10px;
    }

    .card-white {
        background: #fff;
        border: 1px solid #eee;
        border-radius: 8px;
        overflow: hidden;
        transition: all 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        position: relative;
    }

        .card-white:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            border-color: var(--lux-red);
        }

    .cw-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        background: var(--lux-red);
        color: #fff;
        padding: 4px 10px;
        font-weight: 700;
        font-size: 0.8rem;
        border-radius: 4px;
        z-index: 5;
        box-shadow: 0 2px 5px rgba(208, 2, 27, 0.3);
    }

    .cw-img-wrap {
        position: relative;
        width: 100%;
        padding-top: 100%;
        overflow: hidden;
        background: #fafafa;
    }

    .cw-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
    }

    .card-white:hover .cw-img {
        transform: scale(1.08);
    }

    .cw-body {
        padding: 15px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .cw-name {
        font-size: 1rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 10px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 2.4em;
        line-height: 1.2em;
        transition: 0.2s;
    }

    .card-white:hover .cw-name {
        color: var(--lux-red);
    }

    .cw-price-row {
        margin-top: auto;
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin-bottom: 12px;
    }

    .cw-new {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--lux-red);
    }

    .cw-old {
        text-decoration: line-through;
        color: #999;
        font-size: 0.9rem;
    }

    .cw-progress {
        height: 6px;
        background: #ffebee;
        border-radius: 10px;
        overflow: hidden;
        position: relative;
    }

    .cw-fill {
        height: 100%;
        background: linear-gradient(90deg, #ff8a80, var(--lux-red));
        width: 0%;
        transition: width 1s ease;
        border-radius: 10px;
    }

    .cw-sold {
        font-size: 0.75rem;
        color: #666;
        margin-top: 5px;
        display: flex;
        justify-content: space-between;
        font-weight: 500;
    }

    .cw-btn {
        width: 100%;
        display: block;
        text-align: center;
        background: #fff;
        border: 1px solid var(--lux-red);
        color: var(--lux-red);
        padding: 8px;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        margin-top: 15px;
        border-radius: 4px;
        transition: 0.3s;
    }

        .cw-btn:hover {
            background: var(--lux-red);
            color: #fff;
            text-decoration: none;
        }
</style>

<div class="fs-page-container">
    @if (Model == null)
    {
        <div class="container text-center pt-5 mt-5">
            <div style="background: #fff; padding: 50px; border-radius: 10px; border: 1px dashed #ddd; display: inline-block;">
                <i class="fas fa-shopping-bag fa-3x text-muted mb-3" style="color: #eee;"></i>
                <h3 class="text-dark mb-2">Chưa có Flash Sale</h3>
                <p class="text-muted mb-4">Các chương trình khuyến mãi hấp dẫn sẽ sớm quay trở lại!</p>
                <a href="/" class="btn btn-outline-dark px-4 rounded-pill">Tiếp tục mua sắm</a>
            </div>
        </div>
    }
    else
    {
        <div class="fs-header-white">
            <div class="container">
                <h1 class="fs-title-main"> Flash Sale </h1>
                <p class="fs-subtitle">Cơ hội săn sách hàng hiệu với giá ưu đãi. Số lượng có hạn.</p>

                <div class="timer-white" id="big_countdown">
                    <div class="tw-box"><span class="tw-num" id="dh">00</span><span class="tw-lbl">Ngày</span></div>
                    <div class="tw-sep">:</div>
                    <div class="tw-box"><span class="tw-num" id="hh">00</span><span class="tw-lbl">Giờ</span></div>
                    <div class="tw-sep">:</div>
                    <div class="tw-box"><span class="tw-num" id="mh">00</span><span class="tw-lbl">Phút</span></div>
                    <div class="tw-sep">:</div>
                    <div class="tw-box"><span class="tw-num" id="sh">00</span><span class="tw-lbl">Giây</span></div>
                </div>
            </div>
        </div>

        <div class="container">
            <div class="row">
                @if (Model.Flashsaleitems != null && Model.Flashsaleitems.Any())
                {
                    foreach (var item in Model.Flashsaleitems)
                    {
                        // --- [LOGIC ẨN SẢN PHẨM HẾT HÀNG] ---
                        if ((item.SoLuong - item.SoLuongDaBan) <= 0)
                        {
                            continue;
                        }
                        // ------------------------------------

                        var giaGoc = item.MaSpNavigation.Gia;
                        var giaGiam = giaGoc * (1 - (item.PhanTramGiam / 100));
                        var percentSold = item.SoLuong > 0 ? (double)item.SoLuongDaBan / item.SoLuong * 100 : 0;
                        if (percentSold > 100) percentSold = 100;

                        <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                            <a asp-controller="ChiTSP" asp-action="Index" asp-route-id="@item.MaSp" class="text-decoration-none">
                                <div class="card-white">
                                    <span class="cw-badge">-@item.PhanTramGiam.ToString("0")%</span>

                                    <div class="cw-img-wrap">
                                        @if (!string.IsNullOrEmpty(item.MaSpNavigation.HinhDaiDien))
                                        {
                                            <img src="~/image/@item.MaSpNavigation.HinhDaiDien" class="cw-img" alt="@item.MaSpNavigation.TenSanPham">
                                        }
                                        else
                                        {
                                            <img src="~/images/no-image.png" class="cw-img" alt="No Image">
                                        }
                                    </div>

                                    <div class="cw-body">
                                        <div class="cw-name" title="@item.MaSpNavigation.TenSanPham">
                                            @item.MaSpNavigation.TenSanPham
                                        </div>

                                        <div class="cw-price-row">
                                            <span class="cw-new">@giaGiam.ToString("N0")đ</span>
                                            <span class="cw-old">@giaGoc.ToString("N0")đ</span>
                                        </div>

                                        <div class="cw-progress">
                                            <div class="cw-fill" style="width: @percentSold%"></div>
                                        </div>
                                        <div class="cw-sold">
                                            <span>Đã bán @item.SoLuongDaBan</span>
                                            @if (item.SoLuong - item.SoLuongDaBan < 5)
                                            {
                                                <span class="text-danger font-weight-bold">Sắp hết hàng</span>
                                            }
                                            else
                                            {
                                                <span>Còn @(item.SoLuong - item.SoLuongDaBan)</span>
                                            }
                                        </div>

                                        <div class="cw-btn" style="cursor: pointer;" onclick="buyNow(event, @item.MaSp)">
                                            Mua Ngay
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <p class="text-muted">Danh sách sản phẩm đang được cập nhật...</p>
                    </div>
                }
            </div>
        </div>

        <script>
            // 1. Script Đếm Ngược (Giữ nguyên)
            document.addEventListener("DOMContentLoaded", function() {
                const dh = document.getElementById('dh'), hh = document.getElementById('hh'), mh = document.getElementById('mh'), sh = document.getElementById('sh');
                const endStr = "@endTimeString";
                if (!endStr) return;
                const endTime = new Date(endStr).getTime();
                const pad = n => String(n).padStart(2, '0');

                function tick() {
                    const now = Date.now();
                    let diff = Math.floor((endTime - now) / 1000);

                    if (diff <= 0) {
                        if(document.getElementById('big_countdown'))
                             document.getElementById('big_countdown').innerHTML = "<span class='text-danger font-weight-bold'>CHƯƠNG TRÌNH ĐÃ KẾT THÚC</span>";
                        return;
                    }

                    const days = Math.floor(diff / (3600 * 24));
                    let rs = diff % (3600 * 24);
                    const h = Math.floor(rs / 3600);
                    rs %= 3600;
                    const m = Math.floor(rs / 60);
                    const s = rs % 60;

                    if(dh) dh.textContent = pad(days);
                    if(hh) hh.textContent = pad(h);
                    if(mh) mh.textContent = pad(m);
                    if(sh) sh.textContent = pad(s);

                    setTimeout(tick, 1000);
                }
                tick();
            });

            // 2. Script Xử Lý Mua Ngay (Thêm Mới)
            function buyNow(event, id) {
                // Ngăn chặn sự kiện click lan ra thẻ cha (thẻ a vào chi tiết)
                event.preventDefault();
                event.stopPropagation();

                // Tạo Form ẩn để POST dữ liệu lên CartController/BuyNow
                var form = document.createElement('form');
                form.method = 'POST';
                form.action = '/Cart/BuyNow'; // Chú ý: Tên Controller là 'Cart'

                // Input ID sản phẩm
                var inputId = document.createElement('input');
                inputId.type = 'hidden';
                inputId.name = 'id';
                inputId.value = id;
                form.appendChild(inputId);

                // Input Số lượng (mặc định 1)
                var inputQty = document.createElement('input');
                inputQty.type = 'hidden';
                inputQty.name = 'soLuong';
                inputQty.value = 1;
                form.appendChild(inputQty);

                // Gửi Form
                document.body.appendChild(form);
                form.submit();
            }
        </script>
    }
</div>