@{
    var list = ViewBag.DanhSachSanPhamHienThi as IEnumerable<dynamic>;
}

@{
    ViewData["Title"] = "Nhà Sách Online";
}

<style>
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Roboto', sans-serif;
        background-color: #f3f4f6;
        color: #444;
        font-size: 16px; /* Chỉnh lại font size chuẩn cho dễ đọc */
    }

    a {
        text-decoration: none;
        color: inherit;
    }

    ul {
        list-style: none;
    }

    img {
        max-width: 100%;
        display: block;
    }

    :root {
        --primary-red: #C92127;
        --text-dark: #212529;
        --text-gray: #6c757d;
        --bg-white: #ffffff;
        --border-color: #e0e0e0;
    }

    /* === 1. CHỈNH SỬA CONTAINER CHO RỘNG RA === */
    .container {
        /* Đã tăng từ 1200px lên 1450px để lấp đầy khoảng trống 2 bên */
        max-width: 1450px;
        margin: 0 auto;
        padding: 20px 10px;
        display: flex;
        gap: 20px;
        align-items: flex-start;
    }

    .sidebar {
        width: 270px;
        flex-shrink: 0;
        background: var(--bg-white);
        border-radius: 8px;
        padding: 15px;
        /* Bỏ bóng mờ sidebar cho đồng bộ thiết kế phẳng */
        border: 1px solid #eee;
    }

    .filter-header {
        font-weight: bold;
        font-size: 16px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
        text-transform: uppercase;
    }

    .filter-group {
        margin-bottom: 20px;
        border-bottom: 1px solid #eee;
        padding-bottom: 20px;
    }

        .filter-group:last-child {
            border-bottom: none;
        }

    .filter-title {
        font-weight: 700;
        font-size: 14px;
        margin-bottom: 12px;
        display: flex;
        justify-content: space-between;
        cursor: pointer;
    }

    .filter-list li {
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
    }

    .filter-list input[type="checkbox"] {
        width: 18px;
        height: 18px;
        accent-color: var(--primary-red);
        cursor: pointer;
        border: 1px solid #ccc;
        border-radius: 4px;
    }

    .filter-list label {
        cursor: pointer;
        font-size: 14px;
        color: #444;
        flex: 1;
    }

    .count {
        font-size: 12px;
        color: #999;
    }

    .price-inputs {
        display: flex;
        align-items: center;
        gap: 5px;
        margin-top: 10px;
        background: #f8f9fa;
        padding: 8px;
        border-radius: 4px;
    }

        .price-inputs input {
            width: 100%;
            padding: 5px;
            border: 1px solid #ddd;
            border-radius: 4px;
            text-align: center;
            font-size: 13px;
            outline: none;
            color: var(--primary-red);
            font-weight: 500;
        }

    .main-content {
        flex: 1;
    }

    .sort-bar {
        background: var(--bg-white);
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 14px;
        border: 1px solid #eee;
    }

    .result-text b {
        color: var(--text-dark);
    }

    .sort-options {
        display: flex;
        gap: 15px;
        align-items: center;
    }

    .sort-item {
        cursor: pointer;
        color: #666;
        position: relative;
        padding: 5px 0;
    }

        .sort-item:hover, .sort-item.active {
            color: var(--primary-red);
            font-weight: 500;
            border-bottom: 2px solid var(--primary-red);
        }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px; /* Tăng khoảng cách một chút */
    }


    /* === PRODUCT CARD === */
    .product-card {
        background: var(--bg-white);
        border-radius: 8px;
        padding: 15px;
        position: relative;
        /* QUAN TRỌNG: Đặt viền mặc định là trong suốt */
        border: 1px solid transparent;
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        /* Hiệu ứng chuyển màu viền mượt mà trong 0.3s */
        transition: border-color 0.3s ease;
    }

        /* === HOVER EFFECT === */
        .product-card:hover {
            /* Khi hover: Viền đổi sang màu đỏ */
            border-color: var(--primary-red);
            /* Tắt bóng mờ để nhìn gọn gàng hơn (theo ý bạn) */
            box-shadow: none;
            z-index: 10;
        }

    .badge-discount {
        position: absolute;
        top: 0;
        left: 0;
        background: var(--primary-red);
        color: white;
        font-size: 12px;
        padding: 4px 10px;
        border-bottom-right-radius: 8px;
        font-weight: bold;
        z-index: 2;
    }

    .card-img-wrapper {
        height: 240px; /* Tăng chiều cao khung ảnh lên để ảnh to hơn [cite: 46] */
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 15px;
        padding: 5px;
        overflow: hidden; /* Bắt buộc để khi zoom ảnh không bị tràn ra ngoài */
    }

    .card-img {
        max-height: 100%;
        max-width: 100%;
        object-fit: contain;
        transition: transform 0.4s ease; /* Làm mượt hiệu ứng zoom */
        box-shadow: none; /* Xóa bóng mờ của ảnh gốc [cite: 48] */
    }

    /* HIỆU ỨNG ZOOM ẢNH: Chỉ phóng to ảnh khi hover */
    .product-card:hover .card-img {
        transform: scale(1.15); /* Tăng độ phóng to lên 1.15 cho rõ [cite: 49] */
    }

    .card-info {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .card-name {
        font-size: 15px; /* Tăng font chữ tên sách */
        font-weight: 500;
        color: #333;
        margin-bottom: 5px;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 42px;
        transition: color 0.2s;
    }

    .product-card:hover .card-name {
        color: var(--primary-red);
    }

    .card-author {
        font-size: 13px;
        color: #777;
        margin-bottom: 10px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .card-price-group {
        margin-bottom: 8px;
        display: flex;
        align-items: baseline;
        gap: 10px;
    }

    .price-current {
        color: var(--primary-red);
        font-size: 18px; /* Giá to hơn */
        font-weight: 700;
    }

    .price-old {
        font-size: 13px;
        color: #999;
        text-decoration: line-through;
    }

    .card-footer {
        margin-top: auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 10px;
        border-top: 1px solid #f5f5f5;
    }

    .rating {
        font-size: 12px;
        color: #ffc107;
        display: flex;
        align-items: center;
    }

    .sold-count {
        font-size: 12px;
        color: #888;
    }

    .btn-cart {
        width: 100%;
        background: white;
        border: 1px solid var(--primary-red);
        color: var(--primary-red);
        padding: 8px; /* Nút to hơn xíu */
        border-radius: 4px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        margin-top: 10px;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

        .btn-cart:hover {
            background: var(--primary-red);
            color: white;
        }

    /* CSS cho thanh trượt giá (NoUiSlider) */
    .noUi-target {
        height: 6px !important;
        border: none !important;
        background: #E5E7EB !important;
        box-shadow: none !important;
        margin-top: 10px;
    }

    .noUi-connect {
        background: #C92127 !important;
    }

    .noUi-horizontal .noUi-handle {
        width: 20px !important;
        height: 20px !important;
        right: -10px !important;
        top: -7px !important;
        background: #C92127 !important;
        border: 2px solid white !important;
        border-radius: 50% !important;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2) !important;
        cursor: pointer;
    }

    .noUi-handle:before, .noUi-handle:after {
        display: none !important;
    }

    /* CSS Nút xem thêm */
    .random-btn-more-container {
        display: flex;
        justify-content: center;
        align-items: center;
        margin-top: 40px;
        width: 100%;
    }

    .random-btn-more {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 15px 40px;
        background: #C92127;
        color: white;
        font-size: 16px;
        font-weight: 700;
        text-decoration: none;
        border-radius: 50px;
        box-shadow: 0 4px 15px rgba(201, 33, 39, 0.3);
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .random-btn-more:hover {
            background: #a01a1f;
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 6px 20px rgba(201, 33, 39, 0.4);
        }

        .random-btn-more i {
            transition: transform 0.3s ease;
        }

        .random-btn-more:hover i {
            transform: translateX(5px);
        }

    /* Responsive */
    @@media (max-width: 1200px) {
        .container {
            max-width: 100%;
            padding: 20px;
        }
    }

    @@media (max-width: 992px) {
        .sidebar {
            display: none;
        }

        .product-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 576px) {
        .product-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .sort-bar {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }
    }
</style>

<div class="container">
    <aside class="sidebar">
        <div class="filter-header">
            <i class="fa-solid fa-filter"></i> Bộ lọc tìm kiếm
        </div>

        <div class="filter-group mb-4">
            <div class="filter-title font-bold mb-2 flex justify-between items-center cursor-pointer">
                Mức giá <i class="fa-solid fa-chevron-up transition-transform duration-300"></i>
            </div>
            <div class="filter-content">
                <p style="margin-top: 10px; font-size: 12px; color: #666;">Nhập khoảng giá:</p>
                <div class="price-inputs flex items-center gap-2 mb-4">
                    <input type="number" id="input-min" class="border rounded px-2 py-1 w-full text-sm" placeholder="Thấp nhất">
                    <span>-</span>
                    <input type="number" id="input-max" class="border rounded px-2 py-1 w-full text-sm" placeholder="Cao nhất">
                </div>
                <div id="slider-price" class="mb-4 mx-2"></div>
                <button onclick="applyFilter()"
                        class="w-full bg-[#C92127] text-white py-1.5 rounded text-sm font-bold hover:bg-red-700 transition">
                    Áp dụng
                </button>
            </div>
        </div>

        <div class="filter-group">
            <div class="filter-title font-bold mb-2 flex justify-between items-center cursor-pointer">
                Danh mục <i class="fa-solid fa-chevron-up transition-transform duration-300"></i>
            </div>
            <ul class="filter-list filter-content">
                @if (ViewBag.DanhSachDanhMuc != null)
                {
                    foreach (var item in ViewBag.DanhSachDanhMuc)
                    {
                        bool isChecked = (ViewData["CurrentDm"] as int?) == item.MaDm;
                        <li>
                            <input type="checkbox"
                                   id="dm-@item.MaDm"
                                   value="@item.MaDm"
                                   @(isChecked ? "checked" : "")
                                   onchange="filterByCategory(this)">
                            <label for="dm-@item.MaDm" style="cursor: pointer;">@item.TenDanhMuc</label>
                            <span class="count">(@item.Sanphams.Count)</span>
                        </li>
                    }
                }
            </ul>
        </div>
    </aside>

    <main class="main-content">
        <div class="sort-bar">
            <div class="sort-options">
                @{
                    string currentSort = ViewData["CurrentSort"]?.ToString();
                }
                <span class="sort-item @(currentSort == "GiaTang" ? "active" : "")" onclick="sortProducts('GiaTang')">Giá thấp đến cao</span>
                <span class="sort-item @(currentSort == "GiaGiam" ? "active" : "")" onclick="sortProducts('GiaGiam')">Giá cao đến thấp</span>
                <span class="sort-item @(string.IsNullOrEmpty(currentSort) ? "active" : "")" onclick="sortProducts('')">Mới nhất</span>
            </div>
        </div>

        <div class="product-grid" id="productGrid">
            @if (ViewBag.DanhSachSanPhamHienThi != null)
            {
                @foreach (var sanpham in ViewBag.DanhSachSanPhamHienThi)
                {
                    bool coGiamGia = sanpham.PhanTramGiam > 0;
                    string hinhAnh = !string.IsNullOrEmpty(sanpham.HinhDaiDien)
                    ? sanpham.HinhDaiDien
                    : "https://placehold.co/300x450/f0f0f0/333?text=No+Image";

                    <div class="product-card">
                        <a asp-controller="ChiTSP" asp-action="Index" asp-route-id="@sanpham.MaSp" class="card-link">
                            <div class="card-img-wrapper">
                                <img src="~/image/@hinhAnh" alt="@ShortText(@sanpham.TenSanPham, 20)" class="card-img">
                                @if (coGiamGia)
                                {
                                    <div class="badge-discount">-@sanpham.PhanTramGiam%</div>
                                }
                            </div>
                            <div class="card-info">
                                <h3 class="card-name" title="@sanpham.TenSanPham"><span>@ShortText(@sanpham.TenSanPham, 20)</span></h3>
                                <div class="card-author">Tác giả: @sanpham.TacGia</div>
                                <div class="card-price-group">
                                    @if (coGiamGia)
                                    {
                                        <div class="price-current">@sanpham.GiaSauGiam.ToString("#,##0")đ</div>
                                        <div class="price-old">@sanpham.Gia.ToString("#,##0")đ</div>
                                    }
                                    else
                                    {
                                        <div class="price-current">@sanpham.Gia.ToString("#,##0")đ</div>
                                    }
                                </div>
                            </div>
                        </a>

                        @if (sanpham.SoLuong == 0 || sanpham.TrangThai == "Hết hàng")
                        {
                            <span class="text-danger">Hết hàng</span>
                        }
                        else
                        {
                            <button class="btn-cart"
                                    type="button"
                                    data-masp="@sanpham.MaSp">
                                <i class="fa-solid fa-cart-plus"></i> Thêm giỏ hàng
                            </button>
                        }
                        <div class="card-footer">
                            <div class="rating">
                                @{
                                    double diem = (double)sanpham.SaoTrungBinh;
                                    double diemLamTron = Math.Round(diem * 2, MidpointRounding.AwayFromZero) / 2;
                                    int saoDay = (int)diemLamTron;
                                    bool coSaoRuoi = (diemLamTron - saoDay) > 0;
                                }
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= saoDay)
                                    {
                                        <i class="fa-solid fa-star text-yellow-400"></i>
                                    }
                                    else if (i == saoDay + 1 && coSaoRuoi)
                                    {
                                        <i class="fa-solid fa-star-half-stroke text-yellow-400"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-star text-gray-300"></i>
                                    }
                                }
                                @if (diem > 0)
                                {
                                    <span style="font-weight: bold; color: #333; margin-left: 6px; font-size: 13px;">@diem.ToString("0.0")</span>
                                }
                            </div>
                            <div class="sold-count">(@sanpham.SoLuotDanhGia đánh giá)</div>
                        </div>

                    </div>
                }
            }
            else
            {
                <p>Không tìm thấy sản phẩm nào.</p>
            }
        </div>

        <div class="random-btn-more-container">
            <a href="@Url.Action("Index", "SanPham")" class="random-btn-more">
                Xem thêm sản phẩm <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>
    </main>
</div>

<script>
    function filterByCategory(checkbox) {
        var baseUrl = '@Url.Action("Index", "Home")';
        if (checkbox.checked) {
            window.location.href = baseUrl + '?madm=' + checkbox.value;
        } else {
            window.location.href = baseUrl;
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        var slider = document.getElementById('slider-price');
        var inputMin = document.getElementById('input-min');
        var inputMax = document.getElementById('input-max');

        var currentMin = @((ViewBag.MinPrice ?? 0));
        var currentMax = @((ViewBag.MaxPrice ?? 1000000));

        noUiSlider.create(slider, {
            start: [currentMin, currentMax],
            connect: true,
            range: { 'min': 0, 'max': 1000000 },
            step: 10000,
            format: { to: v => Math.round(v), from: v => Number(v) }
        });

        slider.noUiSlider.on('update', function (values, handle) {
            if (handle === 0) inputMin.value = values[0];
            else inputMax.value = values[1];
        });
        inputMin.addEventListener('change', function () {
            slider.noUiSlider.set([this.value, null]);
        });
        inputMax.addEventListener('change', function () {
            slider.noUiSlider.set([null, this.value]);
        });

        // Toggle Filter
        const toggles = document.querySelectorAll(".filter-title");
        toggles.forEach(toggle => {
            toggle.addEventListener("click", function () {
                const content = this.nextElementSibling;
                const icon = this.querySelector("i");
                if (content.style.display === "none") {
                    content.style.display = "block";
                    icon.style.transform = "rotate(0deg)";
                } else {
                    content.style.display = "none";
                    icon.style.transform = "rotate(180deg)";
                }
            });
        });
    });

    function applyFilter() {
        var min = document.getElementById('input-min').value;
        var max = document.getElementById('input-max').value;
        var urlParams = new URLSearchParams(window.location.search);
        urlParams.set('min', min);
        urlParams.set('max', max);
        window.location.search = urlParams.toString();
    }

    function sortProducts(criteria) {
        var urlParams = new URLSearchParams(window.location.search);
        if (criteria) urlParams.set('sortOrder', criteria);
        else urlParams.delete('sortOrder');
        window.location.search = urlParams.toString();
    }
    @functions {
                        public string ShortText(string text, int length = 20)
                        {
                                            if (string.IsNullOrEmpty(text)) return "";
                                            return text.Length > length ? text.Substring(0, length) + "..." : text;
                        }
    }
</script>