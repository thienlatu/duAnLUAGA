        }

            .addcart-modal-btn-confirm:hover {
                background: #d73211;
            }
    </style>

    <div class="addcart-modal-overlay" id="addToCartModal">
        <div class="addcart-modal-box">
            <div class="addcart-modal-header">Thêm Sản Phẩm</div>
            <div class="addcart-modal-body" id="addToCartMessage">
                Bạn có chắc chắn muốn thêm sản phẩm này vào giỏ hàng?
            </div>
            <div class="addcart-modal-footer">
                <button class="addcart-modal-btn addcart-modal-btn-cancel" id="addToCartCancel">Hủy</button>
                <button class="addcart-modal-btn addcart-modal-btn-confirm" id="addToCartOk">Xác Nhận</button>
            </div>
        </div>
    </div>

    <!-- Modal thông báo thêm giỏ hàng thành công -->
    <div class="addcart-modal-overlay" id="addToCartSuccessModal">
        <div class="addcart-modal-box">
            <div class="addcart-modal-header">Thêm Sản Phẩm</div>
            <div class="addcart-modal-body">
                Sản phẩm đã được thêm vào giỏ hàng thành công.
            </div>
            <div class="addcart-modal-footer">
                <button class="addcart-modal-btn addcart-modal-btn-confirm" id="addToCartSuccessOk">Đóng</button>
            </div>
        </div>
    </div>

    <script>
        let __pendingAddToCart = null;
        let __addToCartSuccessTimer = null;

        function openAddToCartModal(masp, qty) {
            const overlay = document.getElementById('addToCartModal');
            const msg = document.getElementById('addToCartMessage');
            const btnOk = document.getElementById('addToCartOk');
            const btnCancel = document.getElementById('addToCartCancel');

            if (!overlay || !btnOk || !btnCancel) return;

            __pendingAddToCart = { masp, qty };

            // reset listeners bằng cách clone nút (tránh chồng nhiều lần)
            const newOk = btnOk.cloneNode(true);
            const newCancel = btnCancel.cloneNode(true);
            btnOk.parentNode.replaceChild(newOk, btnOk);
            btnCancel.parentNode.replaceChild(newCancel, btnCancel);

            newOk.addEventListener('click', function () {
                closeAddToCartModal();
                if (__pendingAddToCart) {
                    doAddToCartRequest(__pendingAddToCart.masp, __pendingAddToCart.qty);
                }
            });

            newCancel.addEventListener('click', function () {
                closeAddToCartModal();
                __pendingAddToCart = null;
            });

            overlay.addEventListener('click', function (e) {
                if (e.target === overlay) {
                    closeAddToCartModal();
                    __pendingAddToCart = null;
                }
            });

            overlay.classList.add('active');
        }

        function closeAddToCartModal() {
            const overlay = document.getElementById('addToCartModal');
            if (overlay) {
                overlay.classList.remove('active');
            }
        }

        // Mở modal thông báo "thêm giỏ hàng thành công"
        function openAddToCartSuccessModal() {
            const overlay = document.getElementById('addToCartSuccessModal');
            const btnOk = document.getElementById('addToCartSuccessOk');
            if (!overlay || !btnOk) return;

            const newOk = btnOk.cloneNode(true);
            btnOk.parentNode.replaceChild(newOk, btnOk);

            newOk.addEventListener('click', function () {
                closeAddToCartSuccessModal();
            });

            overlay.addEventListener('click', function (e) {
                if (e.target === overlay) {
                    closeAddToCartSuccessModal();
                }
            });

            overlay.classList.add('active');

            // Tự động ẩn sau 5 giây nếu người dùng không bấm
            clearTimeout(__addToCartSuccessTimer);
            __addToCartSuccessTimer = setTimeout(() => {
                closeAddToCartSuccessModal();
            }, 5000);
        }

        function closeAddToCartSuccessModal() {
            const overlay = document.getElementById('addToCartSuccessModal');
            if (overlay) {
                overlay.classList.remove('active');
            }
            clearTimeout(__addToCartSuccessTimer);
        }

        // Thực hiện gọi API AddToCart
        function doAddToCartRequest(masp, qty) {
            fetch('/Cart/AddToCart', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8'
                },
                body: new URLSearchParams({
                    maSp: masp,
                    soLuong: qty
                })
            })
                .then(response => response.json())
                .then(data => {
                    if (data && data.success) {
                        // Sau khi thêm giỏ hàng (kể cả CHƯA đăng nhập), luôn gọi API đếm lại
                        // để badge nhảy ngay theo số sản phẩm hiện có trong giỏ
                        if (window.updateCartBadge) {
                            window.updateCartBadge();
                        }

                        // Hiển thị modal thông báo thêm sản phẩm thành công
                        openAddToCartSuccessModal();
                    } else {
                        alert((data && data.message) || 'Không thể thêm sản phẩm vào giỏ hàng.');
                    }
                })
                .catch(error => {
                    console.error('Lỗi khi thêm vào giỏ hàng:', error);
                    alert('Đã xảy ra lỗi khi thêm vào giỏ hàng. Vui lòng thử lại.');
                });
        }
        // Hàm cập nhật số sản phẩm trong giỏ hàng (badge trên icon)
        function updateCartBadge() {
            fetch('/Cart/GetCartCount')
                .then(response => response.json())
                .then(data => {
                    const badge = document.getElementById('cart-badge');
                    if (badge) {
                        if (data.count > 0) {
                            badge.textContent = data.count > 99 ? '99+' : data.count;
                            badge.style.display = 'flex';
                        } else {
                            badge.style.display = 'none';
                        }
                    }
                })
                .catch(error => {
                    console.error('Error updating cart badge:', error);
                });
        }

        // Hàm thêm vào giỏ hàng (dùng chung cho toàn site) - có popup xác nhận custom
        function addToCart(masp, soLuong) {
            if (!masp) return;
            const qty = soLuong && soLuong > 0 ? soLuong : 1;
            openAddToCartModal(masp, qty);
        }

        // Gán sự kiện click cho các nút "Thêm giỏ hàng" ở danh sách sản phẩm
        document.addEventListener('DOMContentLoaded', function () {
            // Cập nhật badge khi trang được tải
            updateCartBadge();

            // Lắng nghe click trên các nút có class .btn-cart và data-masp
            document.body.addEventListener('click', function (e) {
                const btn = e.target.closest('.btn-cart[data-masp]');
                if (!btn) return;

                const masp = parseInt(btn.getAttribute('data-masp'));
                if (!masp) return;

                addToCart(masp, 1);
            });

            // Nút "Thêm giỏ hàng" ở trang chi tiết sản phẩm (nếu có)
            const btnDetail = document.getElementById('btnAddToCartDetail');
            if (btnDetail) {
                btnDetail.addEventListener('click', function () {
                    const masp = parseInt(btnDetail.getAttribute('data-masp'));
                    const qtyInput = document.getElementById('qty');
                    let soLuong = 1;
                    if (qtyInput) {
                        const val = parseInt(qtyInput.value);
                        if (!isNaN(val) && val > 0) {
                            soLuong = val;
                        }
                    }

                    addToCart(masp, soLuong);
                });
            }
        });

        // Tạo hàm global để các trang khác có thể gọi
        window.updateCartBadge = updateCartBadge;
        window.addToCart = addToCart;
    </script>

    <!-- Script kiểm tra trạng thái tài khoản định kỳ (polling) -->
    <script>
        (function() {
            // Chỉ chạy nếu user đã đăng nhập
            var isLoggedIn = @(User?.Identity?.IsAuthenticated == true ? "true" : "false");

            if (!isLoggedIn) {
                return; // Không cần check nếu chưa đăng nhập
            }

            var checkInterval = 3000; // Check mỗi 3 giây
            var isChecking = false; // Tránh check đồng thời

            function checkAccountStatus() {
                if (isChecking) return;
                isChecking = true;

                fetch('/api/AccountStatus/check', {
                    method: 'GET',
                    credentials: 'include', // Gửi cookie
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    isChecking = false;

                    // Nếu tài khoản bị khóa
                    if (data.isLocked === true) {
                        // Dừng polling
                        clearInterval(intervalId);

                        // Thay vì dùng alert, chuyển hướng về trang đăng nhập
                        // Trang Login sẽ tự hiển thị popup "Thông báo bảo mật"
                        window.location.href = '/Home/Logout?returnUrl=' + encodeURIComponent('/Home/Login?locked=1');
                    }
                })
                .catch(error => {
                    isChecking = false;
                    console.error('Lỗi khi kiểm tra trạng thái tài khoản:', error);
                });
            }

            // Bắt đầu polling ngay lập tức
            checkAccountStatus();

            // Tiếp tục polling định kỳ
            var intervalId = setInterval(checkAccountStatus, checkInterval);

            // Dừng polling khi user rời trang
            window.addEventListener('beforeunload', function() {
                clearInterval(intervalId);
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>

</html>