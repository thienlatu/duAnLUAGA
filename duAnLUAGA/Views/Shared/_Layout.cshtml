<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>@ViewData["Title"] - LUAGA</title>
    <meta name="description" content="">
    <meta name="keywords" content="">
    <script src="https://kit.fontawesome.com/05da1950ae.js" crossorigin="anonymous"></script>

    <link href="~/assets/img/favicon.png" rel="icon">
    <link href="~/assets/img/apple-touch-icon.png" rel="apple-touch-icon">
    <link href="~/Edit/dangKy.css" rel="stylesheet" />

    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="~/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">
    <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

    <link href="~/assets/css/main.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.7.1/nouislider.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/noUiSlider/15.7.1/nouislider.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    @await RenderSectionAsync("Styles", required: false)

    <style>
        /* --- [BẮT ĐẦU] CSS CỐ ĐỊNH FOOTER (STICKY FOOTER) --- */
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh; /* Chiều cao tối thiểu 100% màn hình */
        }

        /* Class .main bao quanh @RenderBody sẽ giãn ra chiếm hết khoảng trống */
        .main {
            flex: 1;
        }

        footer {
            flex-shrink: 0; /* Footer không bị co lại */
        }
        /* --- [KẾT THÚC] CSS CỐ ĐỊNH FOOTER --- */

        /* Cart Badge Styles */
        .cart-badge {
            position: absolute;
            top: -8px;
            right: -8px;
            background: #ee4d2d;
            color: #fff;
            border-radius: 10px;
            min-width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: bold;
            padding: 0 6px;
            line-height: 1;
        }


        /* Nền mờ bên trái */
        .login-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
            z-index: 9998;
        }

        /* Panel bên phải */
        .login-panel {
            position: fixed;
            top: 0;
            right: -50%;
            width: 50%;
            max-width: 600px;
            height: 100%;
            background: white;
            z-index: 9999;
            overflow-y: auto;
            padding: 50px 60px;
            transition: right 0.4s ease;
            box-shadow: -2px 0 15px rgba(0, 0, 0, 0.1);
            display: flex;
            align-items: center;
        }

            .login-panel.active {
                right: 0;
            }

        /* Nút đóng */
        .close-login {
            position: absolute;
            top: 20px;
            right: 25px;
            font-size: 28px;
            cursor: pointer;
            color: #999;
            transition: color 0.3s;
            line-height: 1;
        }

            .close-login:hover {
                color: #1a1a1a;
            }

        .login-container {
            width: 100%;
            max-width: 450px;
            margin: 0 auto;
        }

        .logo {
            text-align: center;
        }

            .logo h1 {
                font-size: 32px;
                font-weight: 400;
                letter-spacing: 10px;
                color: #c41e3a;
                text-transform: uppercase;
            }

        .login-box {
            background: white;
            padding-top: 20px;
            border-top: 1px solid #e5e5e5;
        }

        .login-title {
            font-size: 24px;
            font-weight: 400;
            color: #1a1a1a;
            margin-bottom: 30px;
            text-align: center;
            letter-spacing: 1px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-size: 11px;
            color: #666;
            margin-bottom: 8px;
            letter-spacing: 1px;
            text-transform: uppercase;
            font-weight: 500;
        }

        .form-input {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #ddd;
            background: #f8f8f8;
            font-size: 14px;
            color: #1a1a1a;
            transition: all 0.3s;
        }

            .form-input:focus {
                outline: none;
                border-color: #c41e3a;
                background: white;
            }

            .form-input::placeholder {
                color: #bbb;
            }

        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
            font-size: 12px;
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .checkbox-group input {
                width: 16px;
                height: 16px;
                cursor: pointer;
            }

            .checkbox-group label {
                color: #666;
                cursor: pointer;
            }

        .forgot-link {
            color: #666;
            text-decoration: none;
            transition: color 0.3s;
        }

            .forgot-link:hover {
                color: #c41e3a;
            }

        .login-button {
            width: 100%;
            padding: 14px;
            background: #c41e3a;
            color: white;
            border: none;
            font-size: 13px;
            letter-spacing: 2px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 600;
        }

            .login-button:hover {
                background: #a01829;
            }

        .divider {
            text-align: center;
            margin: 24px 0;
            position: relative;
        }

            .divider::before {
                content: '';
                position: absolute;
                left: 0;
                top: 50%;
                width: 100%;
                height: 1px;
                background: #e5e5e5;
            }

            .divider span {
                background: white;
                padding: 0 20px;
                position: relative;
                color: black;
                font-size: 12px;
            }

        .social-login {
            margin-bottom: 24px;
        }

        .social-button {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            background: white;
            color: #666;
            font-size: 12px;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 500;
        }

            .social-button:hover {
                border-color: #c41e3a;
                color: #c41e3a;
            }

        .register-link {
            text-align: center;
            font-size: 13px;
            color: #666;
        }

            .register-link a {
                color: #c41e3a;
                text-decoration: none;
                font-weight: 500;
            }

                .register-link a:hover {
                    text-decoration: underline;
                }

        /* --- CSS NÚT SĂN VOUCHER NỔI --- */
        .float-voucher-btn {
            position: fixed;
            bottom: 100px; /* Cách đáy 100px để tránh nút Scroll Top nếu có */
            right: 20px;
            width: 60px;
            height: 60px;
            background: linear-gradient(135deg, #ff5722, #ee4d2d);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            box-shadow: 0 4px 15px rgba(238, 77, 45, 0.4);
            z-index: 9990;
            transition: transform 0.3s;
            animation: floatBounce 3s infinite ease-in-out;
        }

            .float-voucher-btn:hover {
                transform: scale(1.1);
            }

            .float-voucher-btn i {
                font-size: 28px;
                color: #fff;
            }

        .voucher-tooltip {
            position: absolute;
            right: 70px;
            background: #333;
            color: #fff;
            padding: 6px 12px;
            border-radius: 4px;
            font-size: 12px;
            white-space: nowrap;
            opacity: 0;
            transition: 0.3s;
            pointer-events: none;
        }

        .float-voucher-btn:hover .voucher-tooltip {
            opacity: 1;
            right: 75px;
        }

        @@keyframes floatBounce {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-10px);
            }
        }
    </style>
</head>

<body class="index-page">

    <header id="header" class="header d-flex align-items-center sticky-top">
        <div class="container-fluid container-xl position-relative d-flex align-items-center">

            <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center me-auto">
                <h1 class="sitename">LUAGA</h1>
            </a>

            <a href="/Voucher/Index" class="float-voucher-btn">
                <i class="fa-solid fa-ticket"></i>
                <span class="voucher-tooltip">Săn Voucher</span>
            </a>

            <form class="search-form d-flex" asp-controller="Home" asp-action="Search" method="get">
                <input class="search-input form-control" type="search" name="query" placeholder="Search..." aria-label="Search" style="margin-right: 12px;">
                <button class="search-btn" type="submit"><i class="bi bi-search"></i></button>
            </form>
            <nav id="navmenu" class="navmenu">
                <ul>
                    <li><a asp-controller="Home" asp-action="Index" class="active">Trang Chủ</a></li>
                    <li><a asp-controller="SanPham" asp-action="Index">Sản Phẩm</a></li>
                    <li><a asp-controller="Cart" asp-action="Index" style="position: relative;">
                        <i class="fa-solid fa-cart-shopping"></i>
                        <span id="cart-badge" class="cart-badge" style="display: none;">0</span>
                    </a></li>
                </ul>
                <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
            </nav>

            <div class="ms-3">
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-user"></i> @User.Identity.Name
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" asp-controller="Address" asp-action="Index">Profile</a></li>
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Logout">Logout</a></li>
                        </ul>
                    </div>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Login" class="btn-getstarted" id="openLogin">Login</a>
                }
            </div>


        </div>
    </header>


    <main class="main">
        @RenderBody()
    </main>

    <footer id="footer" class="footer dark-background">

        <div class="container footer-top">
            <div class="row gy-4">
                <div class="col-lg-4 col-md-6 footer-about">
                    <a asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center">
                        <span class="sitename">LUAGA</span>
                    </a>
                    <div class="footer-contact pt-3">
                        <p> Buon Ma Thuot,Dak Lak</p>
                        <p>Viet Nam, VE +84</p>
                        <p class="mt-3"><strong>Phone:</strong> <span>+84 0347361338</span></p>
                        <p class="mt-3"><strong>Email:</strong> <span>LUAGA@gmail.com</span></p>
                    </div>
                    <div class="social-links d-flex mt-4">
                        <a href="#"><i class="bi bi-twitter-x"></i></a>
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-instagram"></i></a>
                        <a href="#"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4>Đường Dẫn</h4>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Index">Trang Chủ</a></li>
                        <li><a asp-controller="Product" asp-action="Index">Sản Phẩm</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Chính sách và bảo mật</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy policy</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-md-3 footer-links">
                    <h4>Dịch Vụ</h4>
                    <ul>
                        <li><a href="#">Sản phẩm Sale</a></li>
                        <li><a href="#">Hot Copunent</a></li>
                        <li><a href="#">Thông tin tài khoản</a></li>
                        <li><a href="#">Sản phẩm</a></li>
                        <li><a href="#">Danh mục</a></li>
                    </ul>
                </div>

                <div class="col-lg-4 col-md-12 footer-newsletter">
                    <h4>Nhận Tư Vấn</h4>
                    <p>Đăng kí để chúng tôi nhận tư vấn trực tiếp về sản phẩm và dịch vụ LUAGA</p>
                    <form asp-controller="Home" asp-action="Subscribe" method="post">
                        <div class="newsletter-form">
                            <input type="email" name="email" required>
                            <input type="submit" value="Subscribe">
                        </div>
                        <div class="loading"></div>
                        <div class="error-message"></div>
                        <div class="sent-message"></div>
                    </form>
                </div>

            </div>
        </div>

        <div class="container copyright text-center mt-4">
            <p>© <span>Copyright</span> <strong class="px-1 sitename">LUAGA</strong> <span>All Rights Reserved</span></p>
            <div class="credits">
                Thực hiện bởi nhóm <a href="#">LUAGA</a> sinh viên trường <a href="#">Cao Đẳng FPT Polytechnic</a>
            </div>
        </div>

    </footer>


    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendor/php-email-form/validate.js"></script>
    <script src="~/assets/vendor/aos/aos.js"></script>
    <script src="~/assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="~/assets/vendor/imagesloaded/imagesloaded.pkgd.min.js"></script>
    <script src="~/assets/vendor/isotope-layout/isotope.pkgd.min.js"></script>
    <script src="~/assets/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="~/assets/vendor/waypoints/noframework.waypoints.js"></script>
    <script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/assets/js/main.js"></script>

    <script>
        // Hàm cập nhật số sản phẩm trong giỏ hàng
        function updateCartBadge() {
            fetch('/Cart/GetCartCount')
                .then(response => response.json())
                .then(data => {
                    const badge = document.getElementById('cart-badge');
                    if (badge) {
                        if (data.count > 0) {
                            badge.textContent = data.count > 99 ? '99+' : data.count;
                            badge.style.display = 'flex';
                        } else {
                            badge.style.display = 'none';
                        }
                    }
                })
                .catch(error => {
                    console.error('Error updating cart badge:', error);
                });
        }

        // Cập nhật badge khi trang được tải
        document.addEventListener('DOMContentLoaded', function() {
            updateCartBadge();
        });

        // Tạo hàm global để các trang khác có thể gọi
        window.updateCartBadge = updateCartBadge;
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>

</html>