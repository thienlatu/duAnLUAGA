@using duAnLUAGA.Infrastructure.Data
@inject DuanLuagaContext DbContext
@{
    string userAvatar = null;
    if (User?.Identity?.IsAuthenticated == true)
    {
        var userIdClaim = User.FindFirst("UserId") ?? User.FindFirst("MaKh");
        if (userIdClaim != null && int.TryParse(userIdClaim.Value, out var uid))
        {
            var kh = DbContext.Khachhangs.FirstOrDefault(k => k.MaKh == uid);
            userAvatar = kh?.HinhAnh;
        }
    }
}
