@model duAnLUAGA.Domain.Entitie.Sanpham

@{
    ViewData["Title"] = Model.TenSanPham;

}

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script>
    tailwind.config = {
        theme: { extend: { colors: { 'fahasa-red': '#C92127' } } }
    }
</script>

<div class="container mx-auto max-w-6xl p-2 md:p-4 my-4 font-sans">
    <div class="bg-white rounded-lg shadow-sm p-4 md:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">

        <div class="lg:col-span-5 flex flex-col">
            <div class="mb-4 relative group">
                <img id="mainImage"
                     src="~/image/@Model.HinhDaiDien"
                     alt="@Model.TenSanPham"
                     class="w-full h-auto object-contain max-h-[450px] mx-auto rounded-sm cursor-pointer border border-gray-200">
            </div>



            <div class="grid grid-cols-2 gap-3 mb-6">
                <button onclick="addToCart(@Model.MaSp)" class="flex items-center justify-center space-x-2 border-2 border-fahasa-red text-fahasa-red font-bold py-3 rounded-lg bg-white hover:bg-red-50">
                    <i class="fa-solid fa-cart-shopping text-xl"></i> <span>Thêm giỏ hàng</span>
                </button>
                <button class="bg-fahasa-red text-white font-bold py-3 rounded-lg hover:bg-red-700 shadow-md">
                    Mua ngay
                </button>
            </div>
        </div>

        <div class="lg:col-span-7">
            <h1 class="text-2xl font-medium text-gray-800 mb-2 leading-snug">@Model.TenSanPham</h1>
            <div class="flex items-center gap-2 mb-4">
                <div class="flex text-yellow-400 text-sm">
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                    <i class="fa-solid fa-star"></i>
                </div>
                <span class="text-yellow-500 text-sm font-medium">(12 đánh giá)</span>
                <span class="text-gray-300">|</span>
                <span class="text-gray-500 text-sm">Đã bán 345</span>
            </div>
            <div class="flex flex-wrap gap-y-1 text-sm text-gray-600 mb-4">
                <div class="mr-4">Nhà cung cấp: <span class="text-blue-600 font-medium">@(Model.MaDmNavigation?.TenDanhMuc ?? "Đang cập nhật")</span></div>
                <div class="mr-4">Tác giả: <span class="text-blue-600 font-medium">@(Model.TacGia ?? "N/A")</span></div>
                <div class="mr-4">NXB: <span c lass="text-gray-900">@(Model.Nxb ?? "N/A")</span></div>
            </div>

            <div class="flex items-end gap-3 mb-2">
                <span class="text-3xl font-bold text-fahasa-red">@Model.Gia.ToString("#,##0") đ</span>

            </div>

            <div class="flex items-center gap-4 mb-8 mt-4">
                <span class="font-bold text-gray-800 text-sm">Số lượng:</span>
                <div class="flex items-center border border-gray-300 rounded">
                    <button class="px-3 py-1 font-bold hover:bg-gray-100" onclick="updateQty(-1)">-</button>
                    <input type="number" id="qty" value="1" class="w-12 text-center font-bold border-l border-r py-1" readonly>
                    <button class="px-3 py-1 font-bold hover:bg-gray-100" onclick="updateQty(1)">+</button>
                </div>
            </div>
            <i class="fa-solid fa-store mr-1.5"></i>Số Lượng còn: @Model.SoLuong
            <br /><br />
            <div class="bg-white">
                <h3 class="font-bold text-gray-800 mb-3">Chính sách ưu đãi</h3>
                <ul class="space-y-3 text-sm text-gray-600">
                    <li class="flex items-start"><i class="fa-solid fa-truck-fast text-fahasa-red mr-2 mt-1"></i><span>Giao hàng nhanh</span></li>
                    <li class="flex items-start"><i class="fa-solid fa-rotate text-fahasa-red mr-2 mt-1"></i><span>Đổi trả miễn phí</span></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm p-6 mt-4">
        <h2 class="text-xl font-bold text-gray-800 mb-4 border-l-4 border-fahasa-red pl-3 uppercase">Thông tin chi tiết</h2>
        <div class="grid grid-cols-1 gap-x-4 text-sm">
            <div class="grid grid-cols-3 py-2 border-b"><div class="text-gray-500">Mã hàng:</div><div>@Model.MaSp</div></div>
            <div class="grid grid-cols-3 py-2 border-b"><div class="text-gray-500">Tác giả:</div><div>@(Model.TacGia)</div></div>
            <div class="grid grid-cols-3 py-2 border-b"><div class="text-gray-500">Năm XB:</div><div>@(Model.NamXb)</div></div>
            <div class="grid grid-cols-3 py-2 border-b"><div class="text-gray-500">Số Trang:</div><div>@(Model.SoTrang)</div></div>
            <div class="grid grid-cols-3 py-2 border-b"><div class="text-gray-500">Trạng Thái:</div><div>@(Model.TrangThai)</div></div>
            <div class="grid grid-cols-3 py-2 border-b"><div class="text-gray-500">Ngôn ngữ: </div><div>@(Model.NgonNgu)</div></div>
        </div>

    </div>
</div>
<div class="bg-white rounded-lg shadow-sm p-6 mt-4">
    <div class="flex justify-between items-center mb-6 border-b pb-2">
        <h2 class="text-xl font-bold text-gray-800 uppercase">Đánh giá khách hàng</h2>
        <button onclick="openModal()"
                class="bg-fahasa-red text-white px-4 py-2 rounded-lg font-bold text-sm hover:bg-red-700 transition flex items-center gap-2">
            <i class="fa-solid fa-pen"></i> Viết đánh giá
        </button>
    </div>

    Nội dung bình luận
    <div class="flex gap-4 mb-6">
        <div class="w-12 h-12 rounded-full bg-gray-200 flex items-center justify-center font-bold text-gray-500">A</div>
        <div class="flex-1">
            <div class="flex justify-between">
                <span class="font-bold">Nguyễn Văn A</span>
                <span class="text-xs text-gray-400">20/10/2023</span>
            </div>
            <div class="text-yellow-400 text-xs my-1">
                <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
            </div>
            <p class="text-gray-600 text-sm">Sách rất hay, giao hàng nhanh chóng. Đóng gói cẩn thận.</p>
        </div>
    </div>
</div>

<div id="reviewModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50">
    <div class="bg-white w-full max-w-lg rounded-lg p-6 relative shadow-xl">
        <button onclick="closeModal()"
                class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-xl">
            &times;
        </button>
        <h3 class="text-xl font-bold mb-4 text-center text-gray-800">Viết đánh giá sản phẩm</h3>

        <div class="mb-4 text-center">
            <p class="text-sm text-gray-600 mb-2">Bạn thấy sản phẩm thế nào?</p>
            <div id="starRating" class="flex justify-center gap-2 text-3xl text-gray-300 cursor-pointer">
                <i class="fa-solid fa-star hover:text-yellow-400 transition" data-value="1"></i>
                <i class="fa-solid fa-star hover:text-yellow-400 transition" data-value="2"></i>
                <i class="fa-solid fa-star hover:text-yellow-400 transition" data-value="3"></i>
                <i class="fa-solid fa-star hover:text-yellow-400 transition" data-value="4"></i>
                <i class="fa-solid fa-star hover:text-yellow-400 transition" data-value="5"></i>
            </div>
            <input type="hidden" id="ratingValue" value="0">
        </div>

        <div class="mb-4">
            <textarea id="reviewText" rows="4"
                      class="w-full border border-gray-300 rounded p-3 focus:outline-none focus:border-blue-500 resize-none"
                      placeholder="Hãy chia sẻ cảm nhận của bạn về sản phẩm..."></textarea>
        </div>

        <div class="mb-6">
            <label class="block text-sm font-medium text-gray-700 mb-2">Thêm hình ảnh (tối đa 3)</label>
            <div class="flex gap-2">
                <label class="w-16 h-16 border-2 border-dashed border-gray-300 rounded flex items-center justify-center text-gray-400 cursor-pointer hover:border-blue-500 hover:text-blue-500 transition">
                    <i class="fa-solid fa-camera"></i>
                    <input type="file" class="hidden" id="imageUpload" accept="image/*" multiple
                           onchange="handleImageUpload(this)">
                </label>
                <div id="imagePreview" class="flex gap-2"></div>
            </div>
            <p id="uploadError" class="text-red-500 text-xs mt-1 hidden">Chỉ được chọn tối đa 3 ảnh.</p>
        </div>

        <div class="flex justify-end gap-3">
            <button onclick="closeModal()" class="px-4 py-2 border rounded text-gray-600 hover:bg-gray-50">Hủy bỏ</button>
            <button onclick="submitReview()"
                    class="px-6 py-2 bg-fahasa-red text-white rounded font-bold hover:bg-red-700">
                Gửi đánh giá
            </button>
        </div>
    </div>
</div>


<script>
    function changeImage(el, src) {
        document.getElementById('mainImage').src = src;
    }
    function updateQty(n) {
        var input = document.getElementById('qty');
        var val = parseInt(input.value) + n;
        if (val < 1) val = 1;
        input.value = val;
    }
    function updateQty(change) {
      const input = document.getElementById('qty');
      let val = parseInt(input.value);
      val += change;
      if (val < 1) val = 1;
      input.value = val;
    }

    // Logic Modal
    const modal = document.getElementById('reviewModal');
    const stars = document.querySelectorAll('#starRating i');
    const ratingInput = document.getElementById('ratingValue');

    function openModal() { modal.classList.remove('hidden'); }
    function closeModal() { modal.classList.add('hidden'); resetModal(); }

    // Xử lý click sao
    stars.forEach(star => {
      star.addEventListener('click', function () {
        const val = this.dataset.value;
        ratingInput.value = val;
        stars.forEach(s => {
          s.classList.remove('text-yellow-400', 'text-gray-300');
          if (s.dataset.value <= val) s.classList.add('text-yellow-400');
          else s.classList.add('text-gray-300');
        });
      });
    });

    // Upload ảnh
    function handleImageUpload(input) {
      const files = input.files;
      const preview = document.getElementById('imagePreview');
      const error = document.getElementById('uploadError');

      if (files.length > 3) {
        error.classList.remove('hidden');
        input.value = '';
        preview.innerHTML = '';
        return;
      }
      error.classList.add('hidden');
      preview.innerHTML = '';

      Array.from(files).forEach(file => {
        const reader = new FileReader();
        reader.onload = function (e) {
          const img = document.createElement('img');
          img.src = e.target.result;
          img.className = 'w-16 h-16 object-cover rounded border border-gray-200';
          preview.appendChild(img);
        }
        reader.readAsDataURL(file);
      });
    }

    function submitReview() {
      alert("Đánh giá của bạn đã được gửi!");
      closeModal();
    }

    // Thêm sản phẩm vào giỏ hàng
    // Biến lưu timeout ID
    var cartModalTimeout = null;
    
    // Hiển thị modal xác nhận thêm vào giỏ hàng
    function showConfirmModal(maSp, soLuong) {
        // Xóa modal cũ nếu có
        if ($('#cartModal').length > 0) {
            closeCartModal();
        }
        
        // Clear timeout cũ nếu có
        if (cartModalTimeout) {
            clearTimeout(cartModalTimeout);
            cartModalTimeout = null;
        }
        
        var modalHtml = '<div class="modal-overlay" id="cartModal" data-ma-sp="' + maSp + '" data-so-luong="' + soLuong + '">' +
            '<div class="modal-dialog">' +
            '<div class="modal-header">' +
            '<h3 class="modal-title">Thêm Vào Giỏ Hàng</h3>' +
            '</div>' +
            '<div class="modal-body">' +
            '<p>Bạn có muốn thêm sản phẩm này vào giỏ hàng không?</p>' +
            '</div>' +
            '<div class="modal-footer">' +
            '<button class="modal-btn modal-btn-cancel" id="cartModalCancelBtn">Hủy</button>' +
            '<button class="modal-btn modal-btn-confirm" id="cartModalConfirmBtn">Xác Nhận</button>' +
            '</div>' +
            '</div>' +
            '</div>';
        
        $('body').append(modalHtml);
        
        // Lưu giá trị vào data attribute của modal để dùng sau
        $('#cartModal').data('maSp', maSp).data('soLuong', soLuong);
        
        // Dùng event delegation để gắn event listener
        $(document).off('click', '#cartModalCancelBtn').on('click', '#cartModalCancelBtn', function(e) {
            e.preventDefault();
            e.stopPropagation();
            closeCartModalWithCallback(false);
        });
        
        $(document).off('click', '#cartModalConfirmBtn').on('click', '#cartModalConfirmBtn', function(e) {
            e.preventDefault();
            e.stopPropagation();
            var savedMaSp = $('#cartModal').data('maSp');
            var savedSoLuong = $('#cartModal').data('soLuong');
            if (savedMaSp && savedSoLuong) {
                confirmAddToCart(savedMaSp, savedSoLuong);
            } else {
                console.error('Không tìm thấy maSp hoặc soLuong');
                showModal('Thông Báo', 'Có lỗi xảy ra. Vui lòng thử lại.');
            }
        });
        
        // Gắn event listener cho overlay (click ngoài modal để đóng)
        $('#cartModal').on('click', function(e) {
            if ($(e.target).hasClass('modal-overlay')) {
                closeCartModalWithCallback(false);
            }
        });
        
        setTimeout(function() {
            $('#cartModal').addClass('show');
        }, 10);
    }
    
    // Hiển thị modal thông báo (sau khi thêm thành công)
    function showModal(title, message) {
        // Xóa modal cũ nếu có
        if ($('#cartModal').length > 0) {
            closeCartModal();
        }
        
        // Clear timeout cũ nếu có
        if (cartModalTimeout) {
            clearTimeout(cartModalTimeout);
            cartModalTimeout = null;
        }
        
        var modalHtml = '<div class="modal-overlay" id="cartModal">' +
            '<div class="modal-dialog">' +
            '<div class="modal-header">' +
            '<h3 class="modal-title">' + title + '</h3>' +
            '</div>' +
            '<div class="modal-body">' +
            '<p>' + message + '</p>' +
            '</div>' +
            '<div class="modal-footer">' +
            '<button class="modal-btn modal-btn-confirm" id="cartModalConfirmBtn">Xác Nhận</button>' +
            '</div>' +
            '</div>' +
            '</div>';
        
        $('body').append(modalHtml);
        
        // Gắn event listener cho nút Xác Nhận
        $('#cartModalConfirmBtn').on('click', function() {
            closeCartModalWithCallback(false);
        });
        
        // Gắn event listener cho overlay (click ngoài modal để đóng)
        $('#cartModal').on('click', function(e) {
            if ($(e.target).hasClass('modal-overlay')) {
                closeCartModalWithCallback(false);
            }
        });
        
        setTimeout(function() {
            $('#cartModal').addClass('show');
        }, 10);
        
        // Tự động đóng sau 5 giây
        cartModalTimeout = setTimeout(function() {
            closeCartModalWithCallback(false);
        }, 5000);
    }
    
    function closeCartModalWithCallback(hasCallback) {
        // Clear timeout nếu có
        if (cartModalTimeout) {
            clearTimeout(cartModalTimeout);
            cartModalTimeout = null;
        }
        
        var modal = $('#cartModal');
        if (modal.length > 0) {
            modal.removeClass('show');
            setTimeout(function() {
                modal.remove();
            }, 300);
        }
    }
    
    function closeCartModal() {
        closeCartModalWithCallback(false);
    }
    
    // Cập nhật số lượng giỏ hàng
    function updateCartCount(count) {
        var cartBadge = $('#cart-count');
        if (cartBadge.length > 0) {
            cartBadge.text(count);
            if (count > 0) {
                cartBadge.show();
            } else {
                cartBadge.hide();
            }
        }
    }
    
    // Load số lượng giỏ hàng từ server
    function loadCartCount() {
        $.ajax({
            url: '@Url.Action("GetCartCount", "Cart")',
            type: 'GET',
            success: function(response) {
                if (response && response.count !== undefined) {
                    updateCartCount(response.count);
                }
            }
        });
    }
    
    // Load số lượng giỏ hàng khi trang load
    $(document).ready(function() {
        loadCartCount();
    });

    // Thêm sản phẩm vào giỏ hàng
    function addToCart(maSp) {
        // Lấy số lượng từ input
        const qtyInput = document.getElementById('qty');
        const soLuong = parseInt(qtyInput ? qtyInput.value : 1);
        
        // Không cho phép thêm sản phẩm vào giỏ hàng nếu số lượng = 0 hoặc < 0
        if (soLuong <= 0) {
            showModal('Thông Báo', 'Số lượng phải lớn hơn 0. Không thể thêm sản phẩm với số lượng bằng 0.');
            return;
        }

        $.ajax({
            url: '@Url.Action("AddToCart", "Cart")',
            type: 'POST',
            data: {
                maSp: maSp,
                soLuong: soLuong
            },
            success: function (response) {
                if (response && response.success) {
                    // Cập nhật số lượng giỏ hàng
                    if (response.cartCount !== undefined) {
                        updateCartCount(response.cartCount);
                    } else {
                        loadCartCount();
                    }
                    showModal('Thêm Vào Giỏ Hàng', response.message || 'Đã thêm sản phẩm vào giỏ hàng.');
                } else {
                    showModal('Thông Báo', (response && response.message) || 'Không thêm được sản phẩm vào giỏ hàng.');
                }
            },
            error: function () {
                showModal('Thông Báo', 'Có lỗi xảy ra khi thêm vào giỏ hàng.');
            }
        });
    }

</script>
<style>
    .grid-cols-3 {
        font-weight: 900;
    }
    
    /* Modal Notification */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 10000;
        display: none;
        justify-content: center;
        align-items: center;
    }
    .modal-overlay.show {
        display: flex;
    }
    .modal-dialog {
        background: white;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        max-width: 400px;
        width: 90%;
        overflow: hidden;
    }
    .modal-header {
        padding: 15px 20px;
        border-bottom: 1px solid #e0e0e0;
    }
    .modal-title {
        font-size: 18px;
        font-weight: bold;
        color: #333;
        margin: 0;
    }
    .modal-body {
        padding: 20px;
        color: #666;
        font-size: 14px;
    }
    .modal-footer {
        padding: 15px 20px;
        border-top: 1px solid #e0e0e0;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }
    .modal-btn {
        padding: 8px 20px;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        font-size: 14px;
        font-weight: 500;
        transition: all 0.3s;
    }
    .modal-btn-cancel {
        background: white;
        border: 1px solid #ddd;
        color: #333;
    }
    .modal-btn-cancel:hover {
        background: #f5f5f5;
    }
    .modal-btn-confirm {
        background: #ee4d2d;
        color: white;
    }
    .modal-btn-confirm:hover {
        background: #d6301e;
    }
</style>