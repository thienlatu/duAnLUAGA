@model duAnLUAGA.ViewModel.HomModel

@{
    var sanpham = Model.SanPhamChiTiet;
    ViewData["Title"] = sanpham?.TenSanPham ?? "Chi Tiết Sản Phẩm";

    // --- [FLASH SALE LOGIC - CHÈN THÊM] ---
    // Lấy dữ liệu từ Controller truyền sang
    bool isFlashSale = ViewBag.IsFlashSale as bool? ?? false;
    DateTime? fsEndTime = ViewBag.FlashSaleEndTime as DateTime?;
    // ---------------------------------------
}

<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script>
    // Hàm Mua Ngay Toàn Cục
    // thamSoQty: (Tùy chọn) ID của ô nhập số lượng. Nếu không truyền, mặc định là 1.
    function globalBuyNow(event, productId, thamSoQtyId = null) {
        // 1. Chặn sự kiện click lan ra ngoài (nếu nút đặt trong thẻ <a>)
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }

        // 2. Xác định số lượng
        var soLuong = 1;
        if (thamSoQtyId) {
            var input = document.getElementById(thamSoQtyId);
            if (input && input.value) {
                soLuong = parseInt(input.value);
            }
        }

        // 3. Tạo form ẩn để POST
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '/Cart/BuyNow'; // Đảm bảo đúng tên Controller (Cart hoặc GioHang)

        var inputId = document.createElement('input');
        inputId.type = 'hidden';
        inputId.name = 'id';
        inputId.value = productId;
        form.appendChild(inputId);

        var inputQty = document.createElement('input');
        inputQty.type = 'hidden';
        inputQty.name = 'soLuong';
        inputQty.value = soLuong;
        form.appendChild(inputQty);

        document.body.appendChild(form);
        form.submit();
    }
</script>
<script>
    tailwind.config = {
        theme: { extend: { colors: { 'fahasa-red': '#C92127' } } }
    }
</script>

<div class="container mx-auto max-w-6xl p-2 md:p-4 my-4 font-sans">
    <div class="bg-white rounded-lg shadow-sm p-4 md:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6">

        @if (sanpham != null)
        {
            <div class="lg:col-span-5 flex flex-col">
                <div class="mb-4 relative group">
                    <img id="mainImage"
                         src="~/image/@sanpham.HinhDaiDien"
                         alt="@sanpham.TenSanPham"
                         class="w-full h-auto object-contain max-h-[450px] mx-auto rounded-sm cursor-pointer border border-gray-200"
                         onclick="openMainImage()">

                    @if (isFlashSale)
                    {
                        <div class="absolute top-0 left-0 bg-fahasa-red text-white text-xs font-bold px-3 py-1 rounded-br-lg shadow-md z-10 flex items-center gap-1">
                            <i class="fa-solid fa-bolt animate-pulse text-yellow-300"></i> FLASH SALE
                        </div>
                    }
                </div>
                <div class="relative group mt-4">
                    <button onclick="navigateGallery(-1)"
                            class="absolute left-0 top-1/2 -translate-y-1/2 z-10 bg-gray-400 hover:bg-gray-500 text-white p-2 rounded-full shadow-lg transition-opacity duration-300">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <div id="thumbSlider"
                         class="flex gap-2 px-1 overflow-x-auto scroll-smooth hide-scrollbar pb-2">
                        <div class="cursor-pointer border border-fahasa-red rounded-sm p-1 active-thumb flex-shrink-0 w-20 h-20 transition-all hover:opacity-80"
                             onclick="changeImage(this, '/image/@sanpham.HinhDaiDien')">
                            <img src="~/image/@sanpham.HinhDaiDien"
                                 class="w-full h-full object-cover"
                                 alt="Ảnh đại diện @sanpham.TenSanPham">
                        </div>
                        @foreach (var hinh in Model.DanhSachHinhAnh)
                        {
                            <div class="cursor-pointer border border-transparent hover:border-gray-300 rounded-sm p-1 flex-shrink-0 w-20 h-20 transition-all hover:opacity-80"
                                 onclick="changeImage(this)">
                                <img src="/image/@hinh.TenHinhAnh"
                                     class="w-full h-full object-cover"
                                     alt="">
                            </div>
                        }
                    </div>
                    <button onclick="navigateGallery(1)"
                            class="absolute right-0 top-1/2 -translate-y-1/2 z-10 bg-gray-400 hover:bg-gray-500 text-white p-2 rounded-full shadow-lg transition-opacity duration-300">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>

                @if (sanpham.SoLuong == 0 || sanpham.TrangThai == "Hết hàng")
                {
                    <span class="text-danger nnn">Hết hàng</span>
                }
                else
                {
                    <div class="grid grid-cols-2 gap-3 mb-6">
                        <button id="btnAddToCartDetail"
                                type="button"
                                data-masp="@sanpham.MaSp"
                                class="flex items-center justify-center space-x-2 border-2 border-fahasa-red text-fahasa-red font-bold py-3 rounded-lg bg-white hover:bg-red-50">
                            <i class="fa-solid fa-cart-shopping text-xl"></i> <span>Thêm giỏ hàng</span>
                        </button>
                        <button class="bg-fahasa-red text-white font-bold py-3 rounded-lg hover:bg-red-700 shadow-md">
                            Mua ngay
                        </button>
                    </div>
                }
            </div>

            <div class="lg:col-span-7">
                <h1 class="text-2xl font-medium text-gray-800 mb-2 leading-snug">@sanpham.TenSanPham</h1>
                @{
                    double rating = ViewBag.DiemTrungBinh ?? 0;  
                    int total = Model.DanhSachBinhLuan?.Count() ?? 0;

                    int fullStars = (int)rating;                      
                    bool halfStar = (rating - fullStars) >= 0.5;     
                    int emptyStars = 5 - fullStars - (halfStar ? 1 : 0);
                }
                <div class="flex items-center gap-2 mb-4 cursor-pointer"
                     onclick="scrollToRating()">

                    <div class="flex text-yellow-400 text-sm">
                        @for (int i = 0; i < fullStars; i++)
                        {
                            <i class="fa-solid fa-star"></i>
                        }

                        @if (halfStar)
                        {
                            <i class="fa-solid fa-star-half-stroke"></i>
                        }

                        @for (int i = 0; i < emptyStars; i++)
                        {
                            <i class="fa-regular fa-star"></i>
                        }
                    </div>

                    <span class="text-yellow-500 text-sm font-medium">(@total đánh giá)</span>
                </div>
                <div class="flex flex-wrap gap-y-1 text-sm text-gray-600 mb-4">
                    <div class="mr-4">Nhà cung cấp: <span class="text-blue-600 font-medium">@(sanpham.MaDmNavigation.TenDanhMuc)</span></div>
                    <div class="mr-4">Tác giả: <span class="text-blue-600 font-medium">@(sanpham.TacGia ?? "N/A")</span></div>
                    <div class="mr-4">NXB: <span c lass="text-gray-900">@(sanpham.Nxb ?? "N/A")</span></div>
                </div>

                @if (isFlashSale && fsEndTime.HasValue)
                {
                    <div class="bg-red-50 border border-red-200 rounded-md p-3 mb-4 flex items-center justify-between">
                        <div class="flex items-center gap-2 text-fahasa-red font-bold">
                            <i class="fa-solid fa-clock"></i> KẾT THÚC TRONG:
                        </div>
                        <div class="flex gap-1 font-mono font-bold text-lg text-gray-800" id="detail-countdown">
                            <span class="bg-white px-2 py-1 rounded shadow-sm" id="cd-h">00</span> :
                            <span class="bg-white px-2 py-1 rounded shadow-sm" id="cd-m">00</span> :
                            <span class="bg-white px-2 py-1 rounded shadow-sm" id="cd-s">00</span>
                        </div>
                        <input type="hidden" id="fs-end-time" value="@fsEndTime.Value.ToString("yyyy-MM-ddTHH:mm:ss")" />
                    </div>
                }
                <div class="flex items-end gap-3 mb-2">
                    @{
                        // Logic này giữ nguyên, nhưng sẽ nhận giá trị từ ViewBag.GiaSauGiam nếu Controller đã tính Flash Sale
                        decimal giaSauGiam = ViewBag.GiaSauGiam ?? Model.SanPhamChiTiet.Gia;

                        // Nếu là Flash Sale thì ưu tiên hiển thị % của Flash Sale (đã gán vào ViewBag.PhanTramGiam ở Controller)
                        int? phanTramGiam = ViewBag.PhanTramGiam ?? Model.SanPhamChiTiet.PhanTramGiam;
                    }
                    @if (phanTramGiam.HasValue && phanTramGiam.Value > 0 && phanTramGiam.Value < 100)
                    {
                        <span class="text-3xl font-bold text-fahasa-red">
                            @giaSauGiam.ToString("#,##0") đ
                        </span>

                        <span class="text-xl text-gray-400 line-through">
                            @Model.SanPhamChiTiet.Gia.ToString("#,##0") đ
                        </span>

                        <span class="bg-red-100 text-red-600 text-sm font-semibold px-2 py-0.5 rounded-full">
                            -@phanTramGiam.Value%
                        </span>
                    }
                    else
                    {
                        <span class="text-3xl font-bold text-fahasa-red">
                            @Model.SanPhamChiTiet.Gia.ToString("#,##0") đ
                        </span>
                    }
                </div>

                <div class="flex items-center gap-4 mb-8 mt-4">
                    <span class="font-bold text-gray-800 text-sm">Số lượng:</span>
                    <div class="flex items-center border border-gray-300 rounded">
                        <button class="px-3 py-1 font-bold hover:bg-gray-100" onclick="updateQty(-1)">-</button>
                        <input type="number" id="qty" value="1" class="w-12 text-center font-bold border-l border-r py-1" readonly>
                        <button class="px-3 py-1 font-bold hover:bg-gray-100" onclick="updateQty(1)">+</button>
                    </div>
                </div>
                <i class="fa-solid fa-store mr-1.5"></i>Số Lượng còn: @sanpham.SoLuong
                <br /><br />
                <div class="bg-white">
                    <h3 class="font-bold text-gray-800 mb-3">Chính sách ưu đãi</h3>
                    <ul class="space-y-3 text-sm text-gray-600">
                        <li class="flex items-start"><i class="fa-solid fa-truck-fast text-fahasa-red mr-2 mt-1"></i><span>Giao hàng nhanh</span></li>
                        <li class="flex items-start"><i class="fa-solid fa-rotate text-fahasa-red mr-2 mt-1"></i><span>Đổi trả miễn phí</span></li>
                    </ul>
                </div>
            </div>
        }
    </div>

    @if (sanpham != null)
    {
        <div class="bg-white rounded-lg shadow-sm p-6 mt-4">
            <h2 class="text-xl font-bold text-gray-800 mb-4 border-l-4 border-fahasa-red pl-3 uppercase">Thông tin chi tiết</h2>
            <div class="grid grid-cols-1 gap-x-4 text-sm">
                <div class="grid grid-cols-3 py-2 border-b"><div class="text-gray-500">Mã hàng:</div><div>@sanpham.MaSp</div></div>
                <div class="grid grid-cols-3 py-2 border-b"><div class="text-gray-500">Tác giả:</div><div>@(sanpham.TacGia)</div></div>
                <div class="grid grid-cols-3 py-2 border-b"><div class="text-gray-500">Năm XB:</div><div>@(sanpham.NamXb)</div></div>
                <div class="grid grid-cols-3 py-2 border-b"><div class="text-gray-500">Số Trang:</div><div>@(sanpham.SoTrang)</div></div>
                <div class="grid grid-cols-3 py-2 border-b"><div class="text-gray-500">Trạng Thái:</div><div>@(sanpham.TrangThai)</div></div>
                <div class="grid grid-cols-3 py-2 border-b"><div class="text-gray-500">Ngôn ngữ: </div><div>@(sanpham.NgonNgu)</div></div>
            </div>
        </div>
    }

    <div id="ratingSection" class="bg-white rounded-lg shadow-sm p-6 mt-4">
        <div class="rv-wrapper">
            <h1 class="rv-title">Đánh giá sản phẩm</h1>

            <div class="rv-summary">
                <div class="rv-row">

                    <div class="rv-score-box">
                        <div class="rv-score-number">
                            <span>@(ViewBag.DiemTrungBinh ?? 0)</span>
                            <small>/ 5</small>
                        </div>
                        <div class="rv-stars">★★★★★</div>
                        <div class="rv-total-reviews">
                            @(Model.DanhSachBinhLuan?.Count() ?? 0) đánh giá
                        </div>
                    </div>

                    <div class="rv-filters">
                        <button type="button" class="rv-filter-btn rv-active" data-star="0">
                            Tất cả (@ViewBag.TongSoDanhGia)
                        </button>

                        <button type="button" class="rv-filter-btn" data-star="5">5 ★ (@ViewBag.StarCount[5])</button>
                        <button type="button" class="rv-filter-btn" data-star="4">4 ★ (@ViewBag.StarCount[4])</button>
                        <button type="button" class="rv-filter-btn" data-star="3">3 ★ (@ViewBag.StarCount[3])</button>
                        <button type="button" class="rv-filter-btn" data-star="2">2 ★ (@ViewBag.StarCount[2])</button>
                        <button type="button" class="rv-filter-btn" data-star="1">1 ★ (@ViewBag.StarCount[1])</button>
                    </div>

                </div>
            </div>

            <div class="mt-4 flex justify-end">
                @if (User.Identity.IsAuthenticated)
                {
                    if (ViewBag.DaDanhGia == true)
                    {
                        <div class="px-6 py-2 bg-gray-100 text-gray-500 rounded font-semibold border border-gray-300 cursor-not-allowed">
                            Bạn đã đánh giá sản phẩm này
                        </div>
                    }
                    else
                    {
                        <button onclick="openModal()"
                                class="px-6 py-2 bg-blue-600 text-white rounded font-semibold hover:bg-blue-700 transition shadow-md">
                            Viết đánh giá của bạn
                        </button>
                    }
                }
                else
                {
                    <a href="@Url.Action("Login", "Home")"
                       class="text-blue-600 hover:underline">
                        Đăng nhập để viết đánh giá
                    </a>
                }
            </div>

            @foreach (var binhluan in Model.DanhSachBinhLuan)
            {
                <div class="rv-item py-4" data-star="@binhluan.SoSao">
                    <div class="rv-header">
                        <div class="rv-header-left">
                            <div class="rv-info">
                                <div class="rv-username font-semibold text-gray-800">Đánh Giá:</div>
                                @{
                                    string tenKhachHang = "Khách hàng ẩn danh";
                                    if (binhluan.MaKhNavigation != null)
                                    {
                                        tenKhachHang = binhluan.MaKhNavigation.HoVaTen ?? "Khách hàng";
                                    }
                                }
                                <div class="rv-username font-semibold text-gray-800">
                                    Tên Khách Hàng: @tenKhachHang
                                </div>

                                <div class="rv-item-stars text-yellow-500">
                                    Số sao: @Html.Raw(RenderStars(binhluan.SoSao))
                                </div>

                                <div class="rv-date text-sm text-gray-500">
                                    Ngày đánh giá: @(binhluan.NgayDanhGia.ToString("yyyy-MM-dd HH:mm"))
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="rv-content mt-2 text-gray-700">
                        Nội dung: @binhluan.NoiDung
                    </div>

                    @* ẢNH ĐÍNH KÈM *@
                    @{
                        // 1. Xử lý và lọc danh sách ảnh hợp lệ
                        var validImages = !string.IsNullOrEmpty(binhluan.HinhAnh)
                        ? binhluan.HinhAnh.Split(new char[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
                        .Select(x => x.Trim())
                        .Where(x => !string.IsNullOrEmpty(x))
                        .ToArray()
                        : Array.Empty<string>();

                        // 2. CHỈ HIỂN THỊ KHI CÓ ẢNH (Length > 0)
                        // Nếu không có ảnh, khối lệnh này bị bỏ qua -> Web sẽ ẩn luôn phần này.
                        if (validImages.Length > 0)
                        {
                            const string basePath = "/images/reviews/";
                            foreach (var fileName in validImages)
                            {
                                string fullImageUrl = basePath + fileName;
                                <div class="rv-media-item mt-2">
                                    <div class="text-sm font-semibold text-gray-600 mb-1">Hình Ảnh:</div>
                                    <img src="@fullImageUrl"
                                         alt="Ảnh đính kèm"
                                         class="w-20 h-20 object-cover rounded-md border border-gray-200 cursor-pointer hover:opacity-80 transition"
                                         onclick="openLightbox('@fullImageUrl')"
                                         onerror="this.parentElement.style.display='none';">
                                    @* Thêm onerror để nếu ảnh lỗi link thì ẩn luôn cả div cha *@
                                </div>
                            }
                        }
                    }

                    <div class="rv-username font-semibold text-gray-800 mt-2">Phản hồi:</div>
                    <div class="rv-content mt-1 text-gray-700">
                        Nội dung: @binhluan.ShopPhanHoi
                    </div>
                    <div class="rv-date text-sm text-gray-500">
                        Ngày phản hồi: @(binhluan.NgayPhanHoi)
                    </div>
                </div>

                <hr class="mt-3 mb-3 border-gray-100" />
            }
        </div>
    </div>
</div>

<div id="reviewModal" class="fixed inset-0 z-50 hidden bg-black bg-opacity-50 flex items-center justify-center">
    <div class="bg-white w-full max-w-lg rounded-lg p-6 relative shadow-xl">

        <button onclick="closeModal()" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 text-xl">&times;</button>

        <h3 class="text-xl font-bold mb-4 text-center text-gray-800">Viết đánh giá sản phẩm</h3>

        @* Lỗi chung khác (nếu có) *@
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="text-red-500 text-sm mb-2">
                @TempData["ErrorMessage"]
            </div>
        }

        <form asp-controller="ChiTSP"
              asp-action="Them"
              method="post"
              enctype="multipart/form-data">

            <input asp-for="BinhLuan.MaSp" type="hidden" value="@Model.SanPhamChiTiet.MaSp" />

            <div class="mb-4 text-center">
                <p class="text-sm text-gray-600 mb-2">Bạn thấy sản phẩm thế nào?</p>

                <div id="starRating" class="flex justify-center gap-2 text-3xl cursor-pointer">
                    <i class="fa-solid fa-star text-gray-300" data-value="1"></i>
                    <i class="fa-solid fa-star text-gray-300" data-value="2"></i>
                    <i class="fa-solid fa-star text-gray-300" data-value="3"></i>
                    <i class="fa-solid fa-star text-gray-300" data-value="4"></i>
                    <i class="fa-solid fa-star text-gray-300" data-value="5"></i>
                </div>

                <input asp-for="BinhLuan.SoSao" type="hidden" id="ratingValue" />
                <span asp-validation-for="BinhLuan.SoSao" class="text-red-500 text-xs"></span>

                @* Lỗi số sao từ TempData – hiện đúng dưới sao *@
                @if (TempData["ErrorSoSao"] != null)
                {
                    <div class="text-red-500 text-xs mt-1">
                        @TempData["ErrorSoSao"]
                    </div>

                    <script>
                        window.addEventListener('load', function () {
                            if (typeof openModal === 'function') {
                                openModal();
                            }
                        });
                    </script>
                }
            </div>

            <div class="mb-4">
                <textarea asp-for="BinhLuan.NoiDung"
                          rows="4"
                          class="w-full border border-gray-300 rounded p-3"
                          placeholder="Hãy chia sẻ cảm nhận của bạn..."></textarea>

                <span asp-validation-for="BinhLuan.NoiDung" class="text-red-500 text-xs"></span>

                @* Lỗi nội dung từ TempData – hiện ngay dưới textarea *@
                @if (TempData["ErrorNoiDung"] != null)
                {
                    <div class="text-red-500 text-xs mt-1">
                        @TempData["ErrorNoiDung"]
                    </div>

                    <script>
                        window.addEventListener('load', function () {
                            if (typeof openModal === 'function') {
                                openModal();
                            }
                        });
                    </script>
                }
            </div>

            <div class="mb-6">
                <label class="block text-sm font-medium mb-2">Thêm hình ảnh (không bắt buộc)</label>

                <input asp-for="BinhLuan.HinhAnhFiles"
                       type="file"
                       accept="image/*"
                       class="block w-full"
                       onchange="previewSelectedImage(this)" />

                <span asp-validation-for="BinhLuan.HinhAnhFiles" class="text-red-500 text-xs"></span>

                <div id="imagePreview" class="mt-2"></div>
            </div>

            <div class="flex justify-end gap-3">
                <button type="button" onclick="closeModal()" class="px-4 py-2 border rounded">
                    Hủy bỏ
                </button>
                <button type="submit" class="px-6 py-2 bg-red-600 text-white rounded">
                    Gửi đánh giá
                </button>
            </div>
        </form>
    </div>
</div>


<div id="imageLightbox"
     class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-90 transition-opacity duration-300"
     onclick="closeLightbox()">

    <div class="max-w-4xl max-h-full p-4 relative">
        <button class="absolute top-0 right-0 text-white text-3xl font-bold p-4 opacity-75 hover:opacity-100 transition"
                onclick="closeLightbox()">
            &times;
        </button>
        <img id="lightboxImage"
             src=""
             alt="Ảnh phóng to"
             class="max-w-full max-h-[90vh] object-contain cursor-pointer"
             onclick="event.stopPropagation()">
    </div>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <partial name="_ValidationScriptsPartial" />

    <script>
        // --- 1. XỬ LÝ THÔNG BÁO (SWEETALERT2) ---
        document.addEventListener('DOMContentLoaded', () => {
            // Hiển thị thông báo thành công
            var successMsg = '@Html.Raw(TempData["SuccessMessage"])';
            if (successMsg && successMsg.length > 0) {
                Swal.fire({
                    title: 'Thành công!',
                    text: successMsg,
                    icon: 'success',
                    confirmButtonText: 'Tuyệt vời',
                    confirmButtonColor: '#C92127',
                    timer: 3000,
                    timerProgressBar: true
                });
            }

            // Hiển thị thông báo lỗi
            var errorMsg = '@Html.Raw(TempData["ErrorMessage"])';
            if (errorMsg && errorMsg.length > 0) {
                Swal.fire({
                    title: 'Rất tiếc...',
                    text: errorMsg,
                    icon: 'error',
                    confirmButtonText: 'Đóng',
                    confirmButtonColor: '#C92127'
                });
            }
        });

        // --- 2. LOGIC ẢNH VÀ CÁC CHỨC NĂNG KHÁC ---
        let allImages = [];
        let currentIndex = 0;

        document.addEventListener('DOMContentLoaded', () => {
            // 1. Khởi tạo danh sách ảnh
            const thumbDivs = document.querySelectorAll('#thumbSlider > div');

            thumbDivs.forEach((div, index) => {
                const img = div.querySelector('img');
                if (img) {
                    allImages.push({
                        src: img.getAttribute('src') || img.src,
                        alt: img.alt || "",
                        element: div
                    });
                    div.setAttribute('data-index', index);
                }
            });

            // 2. Mặc định chọn ảnh đầu tiên
            if (allImages.length > 0) {
                setActiveImage(0);
            }

            // 3. Khởi tạo Modal, Filter...
            if ('@ViewBag.OpenReviewModal' === 'True') openModal();
            initFilterButtons();
            initStarRating();
        });

        // --- HÀM SET ACTIVE IMAGE ---
        function setActiveImage(index) {
            if (index < 0 || index >= allImages.length) return;

            currentIndex = index;
            const imageData = allImages[index];

            // Đổi ảnh chính
            const mainImage = document.getElementById('mainImage');
            if (mainImage) {
                let imgSrc = imageData.src.replace('~', '');
                mainImage.src = imgSrc;
                mainImage.alt = imageData.alt || "Ảnh sản phẩm";
            }

            // Xử lý viền thumbnails
            const thumbnails = document.querySelectorAll('#thumbSlider > div');
            thumbnails.forEach(t => {
                t.classList.remove('active-thumb', 'border-fahasa-red');
                t.classList.add('border-transparent', 'hover:border-gray-300');
            });

            // Active ảnh hiện tại
            if (imageData.element) {
                imageData.element.classList.add('active-thumb', 'border-fahasa-red');
                imageData.element.classList.remove('border-transparent', 'hover:border-gray-300');

                imageData.element.scrollIntoView({
                    behavior: 'smooth',
                    block: 'nearest',
                    inline: 'center'
                });
            }
        }

        // --- SỰ KIỆN CLICK ---
        function changeImage(thumbnailElement) {
            const index = parseInt(thumbnailElement.getAttribute('data-index'));
            if (!isNaN(index)) {
                setActiveImage(index);
            }
        }

        function navigateGallery(direction) {
            let newIndex = currentIndex + direction;
            if (newIndex >= allImages.length) newIndex = 0;
            if (newIndex < 0) newIndex = allImages.length - 1;
            setActiveImage(newIndex);
        }

        // --- CÁC HÀM TIỆN ÍCH ---
        function openMainImage() {
            const mainImage = document.getElementById('mainImage');
            if(mainImage) window.open(mainImage.src, '_blank');
        }

        function updateQty(change) {
            const qtyInput = document.getElementById('qty');
            let currentQty = parseInt(qtyInput.value) || 1;
            let maxQty = @(sanpham?.SoLuong > 0 ? sanpham.SoLuong : 1);
            let newQty = currentQty + change;
            if (newQty < 1) newQty = 1;
            if (newQty > maxQty) newQty = maxQty;
            qtyInput.value = newQty;
        }

        // --- CÁC HÀM REVIEW ---
        function openModal() { document.getElementById('reviewModal')?.classList.remove('hidden'); }
        function closeModal() { document.getElementById('reviewModal')?.classList.add('hidden'); }

        function initFilterButtons() {
            document.querySelectorAll('.rv-filter-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.rv-filter-btn').forEach(b => b.classList.remove('rv-active'));
                    this.classList.add('rv-active');
                    const star = this.getAttribute("data-star");
                    document.querySelectorAll(".rv-item").forEach(item => {
                        const itemStar = item.getAttribute("data-star");
                        item.style.display = (star === "0" || itemStar === star) ? "block" : "none";
                    });
                });
            });
        }

        function initStarRating() {
            const starRating = document.getElementById('starRating');
            if(starRating){
                starRating.addEventListener('click', function(e) {
                    if (e.target.tagName === 'I') {
                        const rating = parseInt(e.target.dataset.value);
                        document.getElementById('ratingValue').value = rating;
                        this.querySelectorAll('i').forEach(star => {
                            if (parseInt(star.dataset.value) <= rating) {
                                star.classList.remove('text-gray-300'); star.classList.add('text-yellow-400');
                            } else {
                                star.classList.remove('text-yellow-400'); star.classList.add('text-gray-300');
                            }
                        });
                    }
                });
            }
        }

        function previewSelectedImage(input) {
            const preview = document.getElementById("imagePreview");
            preview.innerHTML = "";
            if (input.files && input.files[0]) {
                const img = document.createElement("img");
                img.src = URL.createObjectURL(input.files[0]);
                img.className = "w-20 h-20 object-cover rounded border";
                preview.appendChild(img);
            }
        }

        function openLightbox(url) {
            const lb = document.getElementById('imageLightbox');
            const img = document.getElementById('lightboxImage');
            if(lb && img) { img.src = url; lb.classList.remove('hidden'); }
        }
        function closeLightbox() { document.getElementById('imageLightbox')?.classList.add('hidden'); }
        function scrollToRating() { document.getElementById("ratingSection")?.scrollIntoView({ behavior: "smooth" }); }
        // --- [FLASH SALE] SCRIPT ĐẾM NGƯỢC (CHÈN THÊM) ---
        const endTimeInput = document.getElementById('fs-end-time');
        if (endTimeInput) {
            const endStr = endTimeInput.value;
            const countDownDate = new Date(endStr).getTime();

            const elH = document.getElementById("cd-h");
            const elM = document.getElementById("cd-m");
            const elS = document.getElementById("cd-s");
            const wrapper = document.getElementById("detail-countdown");

            const x = setInterval(function() {
                const now = new Date().getTime();
                const distance = countDownDate - now;

                if (distance < 0) {
                    clearInterval(x);
                    if(wrapper) wrapper.innerHTML = "<span class='text-fahasa-red font-bold'>ĐÃ KẾT THÚC</span>";
                    return;
                }

                const hours = Math.floor(distance / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                if(elH) elH.innerText = hours < 10 ? "0" + hours : hours;
                if(elM) elM.innerText = minutes < 10 ? "0" + minutes : minutes;
                if(elS) elS.innerText = seconds < 10 ? "0" + seconds : seconds;
            }, 1000);
        }
        // ----------------------------------------------------
    </script>
}
@functions {
    // Hàm Helper C# để chuyển đổi số sao thành chuỗi ký tự sao (★)
    public string RenderStars(int? soSao)
    {
        if (soSao == null) return string.Empty;

        int stars = Math.Min(5, Math.Max(0, soSao.Value));
        return new string('★', stars);
    }
}

