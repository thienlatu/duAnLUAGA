@{
    var hinhAnh = User.FindFirst("HinhAnh")?.Value ?? "user.jpg";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>DarkPan - Bootstrap 5 Admin Template</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Favicon -->
    <link href="~/templateAdmin/img/favicon.ico" rel="icon">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Roboto:wght@500;700&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="~/templateAdmin/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="~/templateAdmin/lib/tempusdominus/css/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />

    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/templateAdmin/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="~/templateAdmin/css/style.css" rel="stylesheet">
</head>

<body>
    <div class="container-fluid position-relative d-flex p-0">

        <!-- Spinner End -->
        <!-- Sidebar Start -->
        <div class="sidebar pe-4 pb-3">
            <nav class="navbar bg-secondary navbar-dark">
                <a href="index.html" class="navbar-brand mx-4 mb-3">
                    <h3 class="text-primary">LUAGA</h3>
                </a>
                <div class="d-flex align-items-center ms-4 mb-4">
                    <div class="position-relative">
                        <img class="rounded-circle" src="~/img/@hinhAnh" alt="" style="width: 40px; height: 40px; object-fit: cover;">
                        <div class="bg-success rounded-circle border border-2 border-white position-absolute end-0 bottom-0 p-1"></div>
                    </div>
                    <div class="ms-3">
                        <h6 class="mb-0">@(User.Identity?.Name ?? "N/A")</h6>

                        <span>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                    </div>
                </div>
                <div class="navbar-nav w-100">
                    <a asp-area="Employee" asp-controller="KhachHang" asp-action="Index" class="nav-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "KhachHang" ? "active" : "")">
                        <i class="fa fa-users me-2"></i>Khách Hàng
                    </a>
                 

                    <a asp-area="Employee" asp-controller="Order" asp-action="Index" class="nav-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")"><i class="fa fa-table me-2"></i>Đơn Hàng</a>
                    <a asp-area="Employee" asp-controller="QLDanhGia" asp-action="Index" class="nav-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "QLDanhGia" ? "active" : "")"><i class="fa fa-table me-2"></i>Đánh Giá</a>
                </div>
        </div>
        </nav>
    </div>
    <!-- Sidebar End -->
    <!-- Content Start -->
    <div class="content">
        <!-- Navbar Start -->
        <nav class="navbar navbar-expand bg-secondary navbar-dark sticky-top px-4 py-0">
            <a href="index.html" class="navbar-brand d-flex d-lg-none me-4">
                <h2 class="text-primary mb-0"><i class="fa fa-user-edit"></i></h2>
            </a>
            <a href="#" class="sidebar-toggler flex-shrink-0">
                <i class="fa fa-bars"></i>
            </a>
            <form class="d-none d-md-flex ms-4">
                <input class="form-control bg-dark border-0" type="search" placeholder="Search">
            </form>
            <div class="navbar-nav align-items-center ms-auto">

                <div class="nav-item dropdown">
                    <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                        <img class="rounded-circle me-lg-2" src="~/img/@hinhAnh" alt="" style="width: 40px; height: 40px; object-fit: cover;">
                        <span class="d-none d-lg-inline-flex">@User.Identity?.Name</span>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end bg-secondary border-0 rounded-0 rounded-bottom m-0">
                        <a asp-area="LoginArea" asp-controller="LoginArea" asp-action="Logout" class="dropdown-item">Đăng Xuất</a>
                    </div>
                </div>
            </div>
        </nav>

        <main class="main">
            @RenderBody()
        </main>

    </div>
    <!-- Content End -->
    <!-- Back to Top -->
    </div>

    <!-- JavaScript Libraries -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/templateAdmin/lib/chart/chart.min.js"></script>
    <script src="~/templateAdmin/lib/easing/easing.min.js"></script>
    <script src="~/templateAdmin/lib/waypoints/waypoints.min.js"></script>
    <script src="~/templateAdmin/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="~/templateAdmin/lib/tempusdominus/js/moment.min.js"></script>
    <script src="~/templateAdmin/lib/tempusdominus/js/moment-timezone.min.js"></script>
    <script src="~/templateAdmin/lib/tempusdominus/js/tempusdominus-bootstrap-4.min.js"></script>

    <!-- Template Javascript -->
    <script src="~/templateAdmin/js/main.js"></script>

    @RenderSection("Scripts", required: false)
</body>

</html>