@{
    ViewData["Title"] = "Welcome to LUAGA";
    var userName = User.Identity.Name ?? "Thành viên";
}

<div class="full-welcome-wrapper">
    <div class="bg-overlay"></div>

    <div class="welcome-content">
        <div class="top-accent"></div>

        <div class="text-group">
            <h2 class="sub-title">HỆ THỐNG QUẢN LÝ CỬA HÀNG SÁCH</h2>
            <h1 class="main-title">CHÀO MỪNG BẠN ĐẾN VỚI <span class="highlight">LUAGA</span></h1>
            <div class="luxury-line"></div>
            <p class="welcome-user">Xin chào, <strong>@userName</strong>. Bạn đang đăng nhập với quyền <strong>Nhân viên</strong>.</p>
        </div>

        <div class="dashboard-footer">
            <div class="info-box">
                <i class="fa-solid fa-calendar-day"></i>
                <span>@DateTime.Now.ToString("dd MMMM, yyyy")</span>
            </div>
            <div class="info-box">
                <i class="fa-solid fa-clock"></i>
                <span id="live-clock">00:00:00</span>
            </div>
            <div class="info-box">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Hệ thống bảo mật bởi LUAGA Security</span>
            </div>
        </div>
    </div>
</div>

<style>
    /* 1. Bao phủ toàn bộ vùng nội dung */
    .full-welcome-wrapper {
        position: relative;
        width: 100%;
        height: calc(100vh - 70px); /* Trừ đi chiều cao của Topbar nếu có */
        min-height: 500px;
        background-color: #0a0a0a;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        overflow: hidden;
        margin: 0;
        padding: 0;
    }

    /* 2. Hiệu ứng nền Luxury */
    .bg-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle at center, #1a0505 0%, #000000 100%);
        z-index: 1;
    }

    /* 3. Nội dung chính */
    .welcome-content {
        position: relative;
        z-index: 2;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        border: 2px solid #1a1a1a;
    }

    .top-accent {
        position: absolute;
        top: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, transparent, #ff0000, transparent);
    }

    .text-group {
        animation: fadeInUp 1.2s ease-out;
    }

    .sub-title {
        color: #888;
        font-size: 1rem;
        letter-spacing: 5px;
        margin-bottom: 15px;
        font-weight: 300;
    }

    .main-title {
        color: #fff;
        font-size: 3.5rem;
        font-weight: 900;
        margin: 0;
        letter-spacing: -1px;
    }

    .highlight {
        color: #ff0000;
        text-shadow: 0 0 20px rgba(255, 0, 0, 0.4);
    }

    .luxury-line {
        width: 150px;
        height: 3px;
        background: #ff0000;
        margin: 25px auto;
        box-shadow: 0 0 10px #ff0000;
    }

    .welcome-user {
        color: #ddd;
        font-size: 1.4rem;
        font-weight: 300;
    }

    /* 4. Footer thông tin bên dưới */
    .dashboard-footer {
        position: absolute;
        bottom: 40px;
        display: flex;
        gap: 50px;
        z-index: 3;
    }

    .info-box {
        color: #666;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .info-box i {
            color: #ff0000;
            font-size: 1.1rem;
        }

    /* 5. Hiệu ứng chuyển động */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .main-title {
            font-size: 2rem;
        }

        .dashboard-footer {
            flex-direction: column;
            gap: 15px;
            bottom: 20px;
        }
    }
</style>

<script>
    function updateLiveTime() {
        const timeDisplay = document.getElementById('live-clock');
        const now = new Date();
        timeDisplay.innerText = now.toLocaleTimeString('vi-VN', { hour12: false });
    }
    setInterval(updateLiveTime, 1000);
    updateLiveTime();
</script>