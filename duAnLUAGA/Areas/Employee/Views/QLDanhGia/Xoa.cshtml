@model duAnLUAGA.Domain.Entitie.Danhgium
@{
    Layout = "~/Areas/Employee/Views/Shared/_Layout.cshtml"; // Chuyển layout [cite: 2]
}

<style>
    body {
        background-color: #000;
        color: #fff;
    }

    .lux-box {
        max-width: 500px;
        background: #0a0a0a;
        border: 1px solid #1a1a1a;
        padding: 50px;
        text-align: center;
        margin: 100px auto;
        position: relative;
    }

        .lux-box::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: #e63946;
        }

    .warn-icon {
        font-size: 50px;
        color: #e63946;
        display: block;
        margin-bottom: 20px;
    }

    .title-lux {
        text-transform: uppercase;
        letter-spacing: 3px;
        font-weight: 200;
        font-size: 22px;
        margin-bottom: 10px;
    }

    .content-box {
        background: #111;
        border-left: 3px solid #e63946;
        padding: 20px;
        text-align: left;
        margin: 30px 0;
    }

    .btn-del-lux {
        background: #e63946;
        color: #fff;
        border: 1px solid #e63946;
        padding: 15px;
        width: 100%;
        text-transform: uppercase;
        font-weight: bold;
        cursor: pointer;
        transition: 0.4s;
    }

        .btn-del-lux:hover {
            background: transparent;
            color: #e63946;
        }
</style>

<div class="lux-box">
    <span class="warn-icon">!</span>
    <h4 class="title-lux">Xác nhận <b>Xóa</b></h4>
    <p style="color: #666; font-size: 13px;">Bạn có chắc chắn muốn xóa vĩnh viễn đánh giá này không?</p>

    <div class="content-box">
        <small style="color: #e63946; font-weight: bold; text-transform: uppercase;">Khách hàng: @Model.MaKhNavigation?.HoVaTen [cite: 3]</small>
        <p style="color: #fff; margin-top: 10px; font-style: italic;">"@Model.NoiDung" [cite: 3]</p>
    </div>

    <form asp-area="Employee" asp-controller="QLDanhGia" asp-action="Xoa" method="post">
        [cite: 5]
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn-del-lux">Đồng ý xóa vĩnh viễn</button>
        <div class="mt-3">
            <a asp-action="Index" style="color: #444; text-decoration: none; font-size: 11px; text-transform: uppercase; letter-spacing: 1px;">Hủy bỏ và quay lại</a>
        </div>
    </form>
</div>