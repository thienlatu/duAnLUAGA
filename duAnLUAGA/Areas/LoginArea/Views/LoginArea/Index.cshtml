@{
    Layout = null;
}

<h2>Đăng nhập</h2>

<form method="post">
    <input name="username" placeholder="User Employee" /><br />
    <input name="password" type="password" /><br />
    <button type="submit">Đăng nhập</button>
</form>

@if (ViewBag.Error != null)
{
    <p style="color:red">@ViewBag.Error</p>
}
