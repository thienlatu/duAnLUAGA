@model duAnLUAGA.Areas.Admin.ViewModels.NhanVienVM
@{
    ViewData["Title"] = "Sửa Nhân viên";
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-secondary rounded p-4">
        <h3 class="mb-4">Sửa Thông tin Nhân viên</h3>

        <form asp-area="Admin" asp-controller="NhanVien" asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MaNv" />
            <input type="hidden" asp-for="HinhAnh" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="TenNhanVien" class="form-label"></label>
                    <input asp-for="TenNhanVien" class="form-control" />
                    <span asp-validation-for="TenNhanVien" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="TenDangNhap" class="form-label"></label>
                    <input asp-for="TenDangNhap" class="form-control" />
                    <span asp-validation-for="TenDangNhap" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="MatKhau" class="form-label">Mật khẩu mới (để trống nếu không đổi)</label>
                    <div class="input-group">
                        <input asp-for="MatKhau" class="form-control" type="password" id="matKhauEdit" placeholder="Để trống nếu không đổi mật khẩu" data-val="false" />
                        <button class="btn btn-outline-secondary" type="button" id="togglePasswordEdit">
                            <i class="fa fa-eye" id="eyeIconEdit"></i>
                        </button>
                    </div>
                    <span asp-validation-for="MatKhau" class="text-danger"></span>
                    <small class="form-text text-muted">Để trống nếu không muốn đổi mật khẩu. Nếu nhập, mật khẩu phải từ 8 đến 11 ký tự</small>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="GioiTinh" class="form-label"></label>
                    <select asp-for="GioiTinh" class="form-select">
                        <option value="">-- Chọn --</option>
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                        <option value="Khác">Khác</option>
                    </select>
                    <span asp-validation-for="GioiTinh" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="NamSinh" class="form-label"></label>
                    <div class="row g-2">
                        <div class="col-4">
                            <select id="ngaySelect" class="form-select">
                                <option value="">Ngày</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <select id="thangSelect" class="form-select">
                                <option value="">Tháng</option>
                            </select>
                        </div>
                        <div class="col-4">
                            <select id="namSelect" class="form-select">
                                <option value="">Năm</option>
                            </select>
                        </div>
                    </div>
                    <input type="hidden" asp-for="NamSinh" id="namSinhInput" />
                    <span asp-validation-for="NamSinh" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Sdt" class="form-label"></label>
                    <input asp-for="Sdt" class="form-control" />
                    <span asp-validation-for="Sdt" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Cccd" class="form-label"></label>
                <input asp-for="Cccd" class="form-control" />
                <span asp-validation-for="Cccd" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Tỉnh/Thành phố</label>
                    <select id="tinhSelect" class="form-select">
                        <option value="">-- Chọn Tỉnh/Thành phố --</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Quận/Huyện</label>
                    <select id="quanHuyenSelect" class="form-select" disabled>
                        <option value="">-- Chọn Quận/Huyện --</option>
                    </select>
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Xã/Phường</label>
                    <select id="xaPhuongSelect" class="form-select" disabled>
                        <option value="">-- Chọn Xã/Phường --</option>
                    </select>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="DiaChi" class="form-label">Địa chỉ chi tiết</label>
                <input asp-for="DiaChi" class="form-control" placeholder="Số nhà, tên đường" />
                <span asp-validation-for="DiaChi" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="HinhAnhFile" class="form-label"></label>
                @if (!string.IsNullOrEmpty(Model.HinhAnh))
                {
                    <div class="mb-2">
                        <img src="~/img/@Model.HinhAnh" alt="Ảnh hiện tại" style="max-width: 150px; max-height: 150px;" class="img-thumbnail" />
                        <p class="text-muted small mt-1">Ảnh hiện tại</p>
                    </div>
                }
                <input asp-for="HinhAnhFile" class="form-control" type="file" accept="image/*" />
                <span asp-validation-for="HinhAnhFile" class="text-danger"></span>
                <small class="form-text text-muted">Chọn file ảnh mới để thay thế (JPG, PNG, GIF)</small>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="TrangThai" class="form-check-input" type="checkbox" />
                <label asp-for="TrangThai" class="form-check-label">
                    Kích hoạt tài khoản
                </label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save me-2"></i>Cập nhật
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fa fa-arrow-left me-2"></i>Quay lại
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            // Tạo dropdown ngày (1-31)
            for (let day = 1; day <= 31; day++) {
                $('#ngaySelect').append($('<option>', {
                    value: day.toString().padStart(2, '0'),
                    text: day
                }));
            }

            // Tạo dropdown tháng (1-12)
            const months = ['Tháng 1', 'Tháng 2', 'Tháng 3', 'Tháng 4', 'Tháng 5', 'Tháng 6', 
                           'Tháng 7', 'Tháng 8', 'Tháng 9', 'Tháng 10', 'Tháng 11', 'Tháng 12'];
            for (let month = 1; month <= 12; month++) {
                $('#thangSelect').append($('<option>', {
                    value: month.toString().padStart(2, '0'),
                    text: months[month - 1]
                }));
            }

            // Tạo dropdown năm (1950 - năm hiện tại)
            const currentYear = new Date().getFullYear();
            const startYear = 1950;
            const currentNamSinh = '@(Model.NamSinh?.ToString("yyyy-MM-dd"))';
            
            for (let year = currentYear; year >= startYear; year--) {
                $('#namSelect').append($('<option>', {
                    value: year,
                    text: year
                }));
            }

            // Pre-select giá trị hiện tại nếu có
            if (currentNamSinh) {
                const dateParts = currentNamSinh.split('-');
                if (dateParts.length === 3) {
                    $('#namSelect').val(dateParts[0]);
                    $('#thangSelect').val(dateParts[1]);
                    $('#ngaySelect').val(dateParts[2]);
                    $('#namSinhInput').val(currentNamSinh);
                }
            }

            // Hàm cập nhật ngày sinh
            function updateNamSinh() {
                const ngay = $('#ngaySelect').val();
                const thang = $('#thangSelect').val();
                const nam = $('#namSelect').val();

                if (ngay && thang && nam) {
                    const dateValue = nam + '-' + thang + '-' + ngay;
                    $('#namSinhInput').val(dateValue);
                } else {
                    $('#namSinhInput').val('');
                }
            }

            // Khi chọn ngày, tháng, năm
            $('#ngaySelect, #thangSelect, #namSelect').on('change', function () {
                updateNamSinh();
            });

            // API Địa chỉ
            let provinces = [];
            let districts = [];
            let wards = [];
            const currentDiaChi = '@Model.DiaChi';

            // Parse địa chỉ hiện tại nếu có
            let currentTinh = '';
            let currentQuanHuyen = '';
            let currentXaPhuong = '';
            let currentDiaChiChiTiet = '';

            if (currentDiaChi) {
                const parts = currentDiaChi.split(',').map(p => p.trim());
                if (parts.length >= 4) {
                    currentDiaChiChiTiet = parts[0];
                    currentXaPhuong = parts[1];
                    currentQuanHuyen = parts[2];
                    currentTinh = parts[3];
                } else if (parts.length >= 3) {
                    currentXaPhuong = parts[0];
                    currentQuanHuyen = parts[1];
                    currentTinh = parts[2];
                }
            }

            // Load danh sách tỉnh/thành phố
            $.getJSON('https://provinces.open-api.vn/api/?depth=1', function (data) {
                provinces = data;
                data.forEach(function (province) {
                    $('#tinhSelect').append($('<option>', {
                        value: province.name,
                        text: province.name
                    }).prop('selected', province.name === currentTinh));
                });

                // Nếu có tỉnh hiện tại, load quận/huyện
                if (currentTinh) {
                    const province = provinces.find(p => p.name === currentTinh);
                    if (province) {
                        loadDistricts(province.code);
                    }
                }
            });

            function loadDistricts(provinceCode) {
                $('#quanHuyenSelect').prop('disabled', false).html('<option value="">-- Chọn Quận/Huyện --</option>');
                
                $.getJSON(`https://provinces.open-api.vn/api/p/${provinceCode}?depth=2`, function (data) {
                    districts = data.districts || [];
                    districts.forEach(function (district) {
                        $('#quanHuyenSelect').append($('<option>', {
                            value: district.name,
                            text: district.name
                        }).prop('selected', district.name === currentQuanHuyen));
                    });

                    // Nếu có quận/huyện hiện tại, load xã/phường
                    if (currentQuanHuyen) {
                        const district = districts.find(d => d.name === currentQuanHuyen);
                        if (district) {
                            loadWards(district.code);
                        }
                    }
                });
            }

            function loadWards(districtCode) {
                $('#xaPhuongSelect').prop('disabled', false).html('<option value="">-- Chọn Xã/Phường --</option>');
                
                $.getJSON(`https://provinces.open-api.vn/api/d/${districtCode}?depth=2`, function (data) {
                    wards = data.wards || [];
                    wards.forEach(function (ward) {
                        $('#xaPhuongSelect').append($('<option>', {
                            value: ward.name,
                            text: ward.name
                        }).prop('selected', ward.name === currentXaPhuong));
                    });
                });
            }

            // Khi chọn tỉnh/thành phố
            $('#tinhSelect').on('change', function () {
                const provinceName = $(this).val();
                
                if (provinceName) {
                    const province = provinces.find(p => p.name === provinceName);
                    if (province) {
                        loadDistricts(province.code);
                    }
                } else {
                    $('#quanHuyenSelect').prop('disabled', true).html('<option value="">-- Chọn Quận/Huyện --</option>');
                    $('#xaPhuongSelect').prop('disabled', true).html('<option value="">-- Chọn Xã/Phường --</option>');
                }
            });

            // Khi chọn quận/huyện
            $('#quanHuyenSelect').on('change', function () {
                const districtName = $(this).val();
                
                if (districtName) {
                    const district = districts.find(d => d.name === districtName);
                    if (district) {
                        loadWards(district.code);
                    }
                } else {
                    $('#xaPhuongSelect').prop('disabled', true).html('<option value="">-- Chọn Xã/Phường --</option>');
                }
            });

            // Set địa chỉ chi tiết nếu có
            if (currentDiaChiChiTiet) {
                $('#DiaChi').val(currentDiaChiChiTiet);
            }

            // Khi submit form - ghép địa chỉ
            $('form').on('submit', function () {
                const tinh = $('#tinhSelect').val() || '';
                const quanHuyen = $('#quanHuyenSelect').val() || '';
                const xaPhuong = $('#xaPhuongSelect').val() || '';
                const diaChiChiTiet = $('#DiaChi').val() || '';
                
                const diaChiFull = [diaChiChiTiet, xaPhuong, quanHuyen, tinh].filter(x => x).join(', ');
                $('#DiaChi').val(diaChiFull);
            });

            // Toggle password visibility - Edit
            $('#togglePasswordEdit').on('click', function () {
                const passwordField = $('#matKhauEdit');
                const eyeIcon = $('#eyeIconEdit');
                if (passwordField.attr('type') === 'password') {
                    passwordField.attr('type', 'text');
                    eyeIcon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    passwordField.attr('type', 'password');
                    eyeIcon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            // Disable client-side validation cho mật khẩu khi để trống
            $('#matKhauEdit').on('input blur', function () {
                if ($(this).val() === '') {
                    $(this).removeAttr('data-val-required');
                    $(this).removeAttr('data-val-length');
                    $(this).removeAttr('data-val-length-min');
                    $(this).removeAttr('data-val-length-max');
                    $(this).removeClass('input-validation-error');
                    $(this).next('.field-validation-error').remove();
                } else {
                    // Nếu có nhập, validate lại
                    const val = $(this).val();
                    if (val.length < 8 || val.length > 11) {
                        $(this).addClass('input-validation-error');
                    } else {
                        $(this).removeClass('input-validation-error');
                    }
                }
            });

            // Khi form submit, nếu mật khẩu trống thì bỏ qua validation
            $('form').on('submit', function (e) {
                const matKhau = $('#matKhauEdit').val();
                if (matKhau === '') {
                    $('#matKhauEdit').removeAttr('data-val');
                    $('#matKhauEdit').removeAttr('data-val-required');
                    $('#matKhauEdit').removeAttr('data-val-length');
                }
            });
        });
    </script>
}

