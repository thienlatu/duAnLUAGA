@model duAnLUAGA.Areas.Admin.ViewModels.DiaChiVM
@{
    ViewData["Title"] = "Sửa Địa chỉ";
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-secondary rounded p-4">
        <h3 class="mb-4">Sửa Thông tin Địa chỉ</h3>

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MaKh" class="form-label"></label>
                    <select asp-for="MaKh" class="form-select" asp-items="ViewBag.KhachHangs">
                        <option value="">-- Chọn khách hàng --</option>
                    </select>
                    <span asp-validation-for="MaKh" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="TenNhanHang" class="form-label"></label>
                    <input asp-for="TenNhanHang" class="form-control" />
                    <span asp-validation-for="TenNhanHang" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Sdt" class="form-label"></label>
                    <input asp-for="Sdt" class="form-control" />
                    <span asp-validation-for="Sdt" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Tỉnh/Thành phố <span class="text-danger">*</span></label>
                    <select id="tinhSelect" class="form-select" required>
                        <option value="">-- Chọn Tỉnh/Thành phố --</option>
                    </select>
                    <input type="hidden" asp-for="Tinh" id="tinhInput" />
                    <span asp-validation-for="Tinh" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Quận/Huyện <span class="text-danger">*</span></label>
                    <select id="quanHuyenSelect" class="form-select" required disabled>
                        <option value="">-- Chọn Quận/Huyện --</option>
                    </select>
                    <input type="hidden" id="quanHuyenInput" />
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="XaPhuong" class="form-label">Xã/Phường <span class="text-danger">*</span></label>
                    <select id="xaPhuongSelect" class="form-select" required disabled>
                        <option value="">-- Chọn Xã/Phường --</option>
                    </select>
                    <input type="hidden" asp-for="XaPhuong" id="xaPhuongInput" />
                    <span asp-validation-for="XaPhuong" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 mb-3">
                    <label asp-for="DiaChiChiTiet" class="form-label"></label>
                    <input asp-for="DiaChiChiTiet" class="form-control" placeholder="Số nhà, tên đường" />
                    <span asp-validation-for="DiaChiChiTiet" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="MacDinh" class="form-check-input" type="checkbox" />
                <label asp-for="MacDinh" class="form-check-label">
                    Đặt làm địa chỉ mặc định
                </label>
                <small class="form-text text-muted d-block">Nếu chọn, địa chỉ này sẽ được đặt làm mặc định và các địa chỉ khác của khách hàng sẽ bị bỏ mặc định.</small>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save me-2"></i>Cập nhật
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fa fa-arrow-left me-2"></i>Quay lại
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            let provinces = [];
            let districts = [];
            let wards = [];
            const currentTinh = '@Model.Tinh';
            const currentXaPhuong = '@Model.XaPhuong';

            // Load danh sách tỉnh/thành phố
            $.getJSON('https://provinces.open-api.vn/api/?depth=1', function (data) {
                provinces = data;
                data.forEach(function (province) {
                    const selected = province.name === currentTinh ? 'selected' : '';
                    $('#tinhSelect').append($('<option>', {
                        value: province.name,
                        text: province.name,
                        selected: selected
                    }));
                });

                // Nếu có tỉnh hiện tại, load quận/huyện
                if (currentTinh) {
                    $('#tinhInput').val(currentTinh);
                    const province = provinces.find(p => p.name === currentTinh);
                    if (province) {
                        loadDistricts(province.code);
                    }
                }
            });

            function loadDistricts(provinceCode) {
                $('#quanHuyenSelect').prop('disabled', false).html('<option value="">-- Chọn Quận/Huyện --</option>');

                $.getJSON(`https://provinces.open-api.vn/api/p/${provinceCode}?depth=2`, function (data) {
                    districts = data.districts || [];
                    districts.forEach(function (district) {
                        $('#quanHuyenSelect').append($('<option>', {
                            value: district.name,
                            text: district.name
                        }));
                    });

                    // Tự động chọn quận/huyện đầu tiên và load xã/phường
                    if (districts.length > 0) {
                        $('#quanHuyenSelect').val(districts[0].name).trigger('change');
                    }
                });
            }

            function loadWards(districtCode) {
                $('#xaPhuongSelect').prop('disabled', false).html('<option value="">-- Chọn Xã/Phường --</option>');

                $.getJSON(`https://provinces.open-api.vn/api/d/${districtCode}?depth=2`, function (data) {
                    wards = data.wards || [];
                    wards.forEach(function (ward) {
                        const selected = ward.name === currentXaPhuong ? 'selected' : '';
                        $('#xaPhuongSelect').append($('<option>', {
                            value: ward.name,
                            text: ward.name,
                            selected: selected
                        }));
                    });

                    if (currentXaPhuong) {
                        $('#xaPhuongInput').val(currentXaPhuong);
                    }
                });
            }

            // Khi chọn tỉnh/thành phố
            $('#tinhSelect').on('change', function () {
                const provinceName = $(this).val();
                $('#tinhInput').val(provinceName);

                if (provinceName) {
                    const province = provinces.find(p => p.name === provinceName);
                    if (province) {
                        loadDistricts(province.code);
                    }
                } else {
                    $('#quanHuyenSelect').prop('disabled', true).html('<option value="">-- Chọn Quận/Huyện --</option>');
                    $('#xaPhuongSelect').prop('disabled', true).html('<option value="">-- Chọn Xã/Phường --</option>');
                }
            });

            // Khi chọn quận/huyện
            $('#quanHuyenSelect').on('change', function () {
                const districtName = $(this).val();
                $('#quanHuyenInput').val(districtName);

                if (districtName) {
                    const district = districts.find(d => d.name === districtName);
                    if (district) {
                        loadWards(district.code);
                    }
                } else {
                    $('#xaPhuongSelect').prop('disabled', true).html('<option value="">-- Chọn Xã/Phường --</option>');
                }
            });

            // Khi chọn xã/phường
            $('#xaPhuongSelect').on('change', function () {
                $('#xaPhuongInput').val($(this).val());
            });

            // Submit form - đảm bảo giá trị được set
            $('form').on('submit', function () {
                $('#tinhInput').val($('#tinhSelect').val());
                $('#xaPhuongInput').val($('#xaPhuongSelect').val());
            });
        });
    </script>

    <style>
        /* Tông chữ trắng cho form Sửa Địa chỉ */
        .bg-secondary.rounded.p-4 {
            color: #fff;
        }

        .bg-secondary.rounded.p-4 h3,
        .bg-secondary.rounded.p-4 label.form-label,
        .bg-secondary.rounded.p-4 small,
        .bg-secondary.rounded.p-4 .form-check-label {
            color: #fff !important;
        }

        .bg-secondary.rounded.p-4 .form-control,
        .bg-secondary.rounded.p-4 .form-select {
            color: #fff;
            background-color: rgba(0, 0, 0, 0.3);
            border-color: rgba(255, 255, 255, 0.15);
        }

        .bg-secondary.rounded.p-4 .form-control::placeholder {
            color: rgba(255, 255, 255, 0.8);
        }

        .bg-secondary.rounded.p-4 .form-select option {
            color: #000;
        }

        .bg-secondary.rounded.p-4 .text-muted {
            color: rgba(255, 255, 255, 0.75) !important;
        }
    </style>
}

