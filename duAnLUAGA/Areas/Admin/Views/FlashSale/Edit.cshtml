@model duAnLUAGA.Areas.Admin.ViewModels.FlashSaleVM

@{
    ViewData["Title"] = "Cập nhật Flash Sale";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --bg-dark: #121212;
        --card-bg: #1e1e1e;
        --accent-red: #e50914;
        --text-white: #e5e5e5;
    }

    body {
        background-color: var(--bg-dark) !important;
        color: var(--text-white);
    }

    .luxury-card {
        background-color: var(--card-bg);
        border: 1px solid #333;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.5);
    }

    .luxury-header {
        border-left: 4px solid var(--accent-red);
        padding-left: 15px;
        color: var(--text-white);
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 20px;
    }

    .input-luxury {
        background-color: #2b2b2b !important;
        border: 1px solid #444;
        color: #fff !important;
    }

        .input-luxury:focus {
            border-color: var(--accent-red);
            box-shadow: none;
        }

    .btn-luxury {
        background-color: var(--accent-red);
        color: white;
        border: none;
        font-weight: 600;
        transition: 0.3s;
    }

        .btn-luxury:hover {
            background-color: #b20710;
            color: white;
        }

    .table-dark-luxury th {
        border-top: none;
        border-bottom: 1px solid #444;
        color: #888;
        text-transform: uppercase;
        font-size: 0.85rem;
    }

    .table-dark-luxury td {
        border-top: 1px solid #333;
        vertical-align: middle;
        color: #ddd;
    }

    /* TOAST */
    #toast-container {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .luxury-toast {
        background: #1e1e1e;
        color: #fff;
        min-width: 300px;
        padding: 15px 20px;
        border-left: 4px solid var(--accent-red);
        border-radius: 4px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        opacity: 0;
        transform: translateX(100%);
        transition: all 0.4s ease-out;
    }

        .luxury-toast.show {
            opacity: 1;
            transform: translateX(0);
        }

        .luxury-toast.success {
            border-left-color: #00c851;
        }

        .luxury-toast.error {
            border-left-color: #ff3547;
        }
</style>

<div id="toast-container"></div>

<div class="container-fluid p-4" style="background-color: var(--bg-dark); min-height: 100vh;">
    <h2 class="luxury-header">Cập nhật chiến dịch #@Model.Idfls</h2>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Idfls" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-4">
                <div class="luxury-card p-4 mb-4">
                    <h5 class="text-white mb-4">1. Thời gian</h5>
                    <div class="form-group mb-3">
                        <label>Bắt đầu</label>
                        <input asp-for="NgayBatDau" class="form-control input-luxury" type="datetime-local" />
                    </div>
                    <div class="form-group mb-3">
                        <label>Kết thúc</label>
                        <input asp-for="NgayKetThuc" class="form-control input-luxury" type="datetime-local" />
                        <span asp-validation-for="NgayKetThuc" class="text-danger small"></span>
                    </div>
                    <div class="form-group mt-4 p-3 rounded" style="background: #252525; border: 1px dashed #444;">
                        <div class="custom-control custom-switch">
                            <input type="checkbox" class="custom-control-input" id="switchTrangThai" asp-for="TrangThai">
                            <label class="custom-control-label text-white" for="switchTrangThai">Đang hoạt động</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="luxury-card p-4">
                    <h5 class="text-white mb-4">2. Sản phẩm khuyến mãi</h5>

                    <div class="row align-items-end mb-4 p-3 rounded" style="background-color: #252525;">
                        <div class="col-md-5">
                            <label>Chọn thêm sản phẩm</label>
                            <select id="selectSanPham" class="form-control input-luxury">
                                <option value="" data-stock="0">-- Tìm kiếm sản phẩm --</option>
                                @if (Model.DanhSachSanPham != null)
                                {
                                    foreach (var item in Model.DanhSachSanPham)
                                    {
                                        <option value="@item.MaSp" data-name="@item.TenSanPham" data-stock="@item.SoLuong">
                                            @item.TenSanPham (Tồn: @item.SoLuong)
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label>% Giảm</label>
                            <input type="number" id="inputPhanTram" class="form-control input-luxury" value="10" />
                        </div>
                        <div class="col-md-2">
                            <label>Số lượng</label>
                            <input type="number" id="inputSoLuong" class="form-control input-luxury" value="1" />
                        </div>
                        <div class="col-md-3">
                            <button type="button" class="btn btn-luxury w-100" id="btnThemSp"><i class="fas fa-plus"></i> THÊM</button>
                        </div>
                        <div class="col-12 mt-2">
                            <small class="text-muted" id="stockHint">Vui lòng chọn sản phẩm...</small>
                        </div>
                    </div>

                    <table class="table table-dark-luxury">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Giảm giá</th>
                                <th>Số lượng Sale</th>
                                <th>Đã bán</th>
                                <th class="text-right">Xóa</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody">
                            @if (Model.Items != null && Model.Items.Count > 0)
                            {
                                for (int i = 0; i < Model.Items.Count; i++)
                                {
                                    <tr id="row_@i">
                                        <td>
                                            <strong class="text-white">@Model.Items[i].TenSanPham</strong>
                                            <input type="hidden" name="Items[@i].MaSp" value="@Model.Items[i].MaSp" />
                                            <input type="hidden" name="Items[@i].TenSanPham" value="@Model.Items[i].TenSanPham" />
                                        </td>
                                        <td>
                                            <span style="color: var(--accent-red); font-weight: bold;">-@Model.Items[i].PhanTramGiam.ToString("0")%</span>
                                            <input type="hidden" name="Items[@i].PhanTramGiam" value="@Model.Items[i].PhanTramGiam" />
                                        </td>
                                        <td>
                                            @Model.Items[i].SoLuong
                                            <input type="hidden" name="Items[@i].SoLuong" value="@Model.Items[i].SoLuong" />
                                        </td>
                                        <td class="text-muted">
                                            @Model.Items[i].SoLuongDaBan
                                            <input type="hidden" name="Items[@i].SoLuongDaBan" value="@Model.Items[i].SoLuongDaBan" />
                                        </td>
                                        <td class="text-right">
                                            <button type="button" class="btn btn-sm btn-outline-danger border-0" onclick="removeRow(@i)">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr id="emptyRow"><td colspan="5" class="text-center text-muted pt-4">Chưa có sản phẩm nào</td></tr>
                            }
                        </tbody>
                    </table>

                    <div class="mt-4 pt-3 border-top border-secondary text-right">
                        <a asp-action="Index" class="btn btn-outline-secondary mr-2" style="border: 1px solid #555; color: #ccc;">Hủy</a>
                        <button type="submit" class="btn btn-luxury px-5">LƯU THAY ĐỔI</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // 1. Toast Function
        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            let iconHtml = type === 'success' ? '<i class="fas fa-check-circle" style="color:#00c851; margin-right:10px;"></i>' : '<i class="fas fa-exclamation-triangle" style="color:#ff3547; margin-right:10px;"></i>';
            toast.className = `luxury-toast ${type}`;
            toast.innerHTML = `<div>${iconHtml} <span style="font-weight:500">${message}</span></div>`;
            container.appendChild(toast);
            setTimeout(() => toast.classList.add('show'), 10);
            setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 400); }, 3000);
        }

        // 2. Logic JS
        var rowIndex = @(Model.Items != null ? Model.Items.Count : 0);

        $(document).ready(function () {
            // Hint tồn kho
            $('#selectSanPham').change(function() {
                var stock = $(this).find(':selected').data('stock');
                var name = $(this).find(':selected').data('name');
                if(name) {
                    $('#stockHint').html(`Sản phẩm <strong>${name}</strong> hiện còn tồn: <span class="text-warning font-weight-bold">${stock}</span> cái.`);
                    $('#inputSoLuong').attr('max', stock);
                } else {
                    $('#stockHint').text("Vui lòng chọn sản phẩm...");
                }
            });

            $('#btnThemSp').click(function () {
                var selectedOption = $('#selectSanPham option:selected');
                var maSp = $('#selectSanPham').val();
                var tenSp = selectedOption.data('name');
                var stockKho = parseInt(selectedOption.data('stock')) || 0;
                var phanTram = parseInt($('#inputPhanTram').val());
                var soLuong = parseInt($('#inputSoLuong').val());

                if (!maSp) { showToast("Chưa chọn sản phẩm!", "error"); return; }

                // CHECK TỒN KHO
                if (soLuong > stockKho) {
                    showToast(`Kho chỉ còn ${stockKho} cái. Không đủ hàng!`, "error");
                    return;
                }

                if (phanTram <= 0 || phanTram >= 100) { showToast("% Giảm không hợp lệ", "error"); return; }
                if (soLuong <= 0) { showToast("Số lượng phải > 0", "error"); return; }

                var isExist = false;
                $('#tableBody input[name$=".MaSp"]').each(function() {
                    if ($(this).val() == maSp) { isExist = true; return false; }
                });
                if (isExist) { showToast("Sản phẩm đã có trong danh sách", "error"); return; }

                $('#emptyRow').remove();

                var newRow = `
                    <tr id="row_${rowIndex}">
                        <td>
                            <strong class="text-white">${tenSp}</strong>
                            <input type="hidden" name="Items[${rowIndex}].MaSp" value="${maSp}" />
                            <input type="hidden" name="Items[${rowIndex}].TenSanPham" value="${tenSp}" />
                        </td>
                        <td>
                            <span style="color: var(--accent-red); font-weight: bold;">-${phanTram}%</span>
                            <input type="hidden" name="Items[${rowIndex}].PhanTramGiam" value="${phanTram}" />
                        </td>
                        <td>
                            ${soLuong}
                            <input type="hidden" name="Items[${rowIndex}].SoLuong" value="${soLuong}" />
                        </td>
                        <td class="text-muted">
                            0
                            <input type="hidden" name="Items[${rowIndex}].SoLuongDaBan" value="0" />
                        </td>
                        <td class="text-right">
                            <button type="button" class="btn btn-sm btn-outline-danger border-0" onclick="removeRow(${rowIndex})">
                                <i class="fas fa-times"></i>
                            </button>
                        </td>
                    </tr>
                `;

                $('#tableBody').append(newRow);
                showToast("Đã thêm thành công!", "success");
                rowIndex++;

                $('#selectSanPham').val('').change();
                $('#inputPhanTram').val(10);
                $('#inputSoLuong').val(1);
            });
        });

        function removeRow(index) {
            $('#row_' + index).remove();
            showToast("Đã xóa dòng sản phẩm", "success");
        }
    </script>
}