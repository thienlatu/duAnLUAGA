@model IEnumerable<duAnLUAGA.Domain.Entitie.Danhmuc>

@{
    ViewData["Title"] = "Quản lý Danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    /* --- GIỮ NGUYÊN CSS CỦA BẠN --- */
    :root {
        --bg-dark: #121212;
        --card-bg: #1e1e1e;
        --accent-red: #e50914;
        --text-white: #e5e5e5;
    }

    body {
        background-color: var(--bg-dark) !important;
        color: var(--text-white);
    }

    .luxury-card {
        background-color: var(--card-bg);
        border: 1px solid #333;
        border-radius: 8px;
    }

    .luxury-header {
        border-left: 4px solid var(--accent-red);
        padding-left: 15px;
        color: var(--text-white);
        font-weight: 700;
        text-transform: uppercase;
    }

    /* Table */
    .table-luxury thead th {
        background: #000;
        border-bottom: 2px solid var(--accent-red);
        color: var(--accent-red);
        text-transform: uppercase;
        font-size: 0.85rem;
    }

    .table-luxury td {
        border-top: 1px solid #333;
        vertical-align: middle;
        color: #ddd;
    }

    .table-luxury tbody tr:hover {
        background-color: rgba(229, 9, 20, 0.05);
        transition: 0.2s;
    }

    /* Image styling specific for Category */
    .img-luxury {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 4px;
        border: 1px solid #444;
        background: #000;
    }

    /* Buttons */
    .btn-luxury {
        background-color: var(--accent-red);
        color: white;
        border: none;
        padding: 8px 20px;
        font-weight: 600;
        border-radius: 4px;
        transition: 0.3s;
    }

        .btn-luxury:hover {
            background-color: #b20710;
            color: white;
            transform: translateY(-2px);
        }

    .btn-icon {
        background: transparent;
        border: 1px solid #444;
        color: #ccc;
        padding: 6px 12px;
        border-radius: 4px;
        margin-right: 5px;
        transition: 0.2s;
    }

        .btn-icon:hover {
            border-color: #fff;
            color: #fff;
        }

    .btn-icon-del:hover {
        border-color: var(--accent-red);
        color: var(--accent-red);
        background: rgba(229, 9, 20, 0.1);
        cursor: pointer;
    }

    /* --- LUXURY DELETE MODAL --- */
    .modal-content-luxury {
        background-color: #1e1e1e;
        border: 1px solid #333;
        color: #fff;
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.8);
    }

    .modal-header-luxury {
        border-bottom: 1px solid #333;
        padding: 15px 20px;
    }

    .modal-footer-luxury {
        border-top: 1px solid #333;
        padding: 15px 20px;
    }

    .warning-icon-wrapper {
        width: 80px;
        height: 80px;
        margin: 0 auto 20px;
        background: rgba(229, 9, 20, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-cancel {
        background: transparent;
        border: 1px solid #555;
        color: #ccc;
        padding: 8px 20px;
        border-radius: 4px;
    }

        .btn-cancel:hover {
            background: #333;
            color: #fff;
            text-decoration: none;
        }

    .btn-confirm-del {
        background: var(--accent-red);
        border: none;
        color: #fff;
        padding: 8px 25px;
        border-radius: 4px;
        font-weight: 600;
        box-shadow: 0 4px 15px rgba(229, 9, 20, 0.3);
    }

        .btn-confirm-del:hover {
            background: #b20710;
            color: #fff;
            transform: translateY(-1px);
            text-decoration: none;
        }

    /* Toast */
    #toast-container {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .luxury-toast {
        background: #1e1e1e;
        color: #fff;
        min-width: 300px;
        padding: 15px 20px;
        border-left: 4px solid var(--accent-red);
        border-radius: 4px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.5);
        display: flex;
        align-items: center;
        opacity: 0;
        transform: translateX(100%);
        transition: all 0.4s ease-out;
    }

        .luxury-toast.show {
            opacity: 1;
            transform: translateX(0);
        }

        .luxury-toast.success {
            border-left-color: #00c851;
        }

        .luxury-toast.error {
            border-left-color: #ff3547;
        }
</style>

<div id="toast-container"></div>

<div class="container-fluid p-4" style="background-color: var(--bg-dark); min-height: 100vh;">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h2 class="luxury-header m-0">Danh sách Danh Mục</h2>
            <small class="text-muted ml-3">Quản lý phân loại sản phẩm</small>
        </div>
        <a asp-action="Create" class="btn btn-luxury"><i class="fas fa-plus mr-2"></i> THÊM DANH MỤC</a>
    </div>

    <div class="luxury-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-luxury mb-0">
                <thead>
                    <tr>
                        <th class="pl-4">ID</th>
                        <th>Hình ảnh</th>
                        <th>Tên danh mục</th>
                        <th>Trạng thái</th>
                        <th class="text-right pr-4">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="pl-4 font-weight-bold text-muted">#@item.MaDm</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.HinhAnh))
                                    {
                                        <img src="@item.HinhAnh" class="img-luxury" alt="@item.TenDanhMuc" />
                                    }
                                    else
                                    {
                                        <div class="img-luxury d-flex align-items-center justify-content-center text-muted">
                                            <i class="fas fa-image"></i>
                                        </div>
                                    }
                                </td>
                                <td class="font-weight-bold">@item.TenDanhMuc</td>
                                <td>
                                    @if (item.TrangThai)
                                    {
                                        <span class="badge badge-success" style="background:#00c851; color:#fff">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Ngưng hoạt động</span>
                                    }
                                </td>
                                <td class="text-right pr-4">
                                    <a asp-action="Edit" asp-route-id="@item.MaDm" class="btn-icon" title="Sửa">
                                        <i class="fas fa-pen"></i>
                                    </a>

                                    <a asp-action="Details" asp-route-id="@item.MaDm" class="btn-icon" title="Xem chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </a>

                                    <button type="button" class="btn-icon btn-icon-del"
                                            onclick="openDeleteModal(@item.MaDm)" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-center py-5 text-muted">Chưa có danh mục nào</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content modal-content-luxury">
            <div class="modal-body text-center pt-5 pb-4">
                <div class="warning-icon-wrapper">
                    <i class="fas fa-exclamation text-danger fa-3x"></i>
                </div>
                <h4 class="font-weight-bold mb-2">Xác nhận xóa?</h4>
                <p class="text-muted mb-0">Hành động này sẽ xóa vĩnh viễn danh mục.<br />Nếu có sản phẩm bên trong, việc xóa sẽ bị chặn.</p>
            </div>
            <div class="modal-footer-luxury d-flex justify-content-center pb-4">
                <button type="button" class="btn btn-cancel mr-3" data-dismiss="modal">Hủy bỏ</button>

                <form id="deleteForm" method="post" asp-action="Delete">
                    <input type="hidden" name="id" id="deleteIdInput" />
                    <button type="submit" class="btn btn-confirm-del">
                        <i class="fas fa-trash mr-2"></i> Xóa ngay
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDeleteModal(id) {

            $('#deleteIdInput').val(id);
            // Hiện Modal
            $('#deleteModal').modal('show');
        }

        function showToast(message, type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');

            let iconHtml = '';
            if (type === 'success') {
                iconHtml = '<i class="fas fa-check-circle" style="color:#00c851; margin-right:10px;"></i>';
            } else {
                iconHtml = '<i class="fas fa-exclamation-triangle" style="color:#ff3547; margin-right:10px;"></i>';
            }

            toast.className = `luxury-toast ${type}`;
            toast.innerHTML = `<div>${iconHtml} <span style="font-weight:500">${message}</span></div>`;
            container.appendChild(toast);

            setTimeout(() => toast.classList.add('show'), 10);
            setTimeout(() => { toast.classList.remove('show'); setTimeout(() => toast.remove(), 400); }, 3000);
        }

        $(document).ready(function() {
            // Lấy thông báo từ TempData của CategoryController
            var msg = '@TempData["Message"]';
            var type = '@TempData["MsgType"]';

            if (msg) {
                showToast(msg, type || 'success');
            }
        });
    </script>
}