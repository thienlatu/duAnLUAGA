@model duAnLUAGA.Areas.Admin.ViewModels.SanPhamUploadVM

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        background: #0a0e1a;
        color: #fff;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .wrapper {
        padding: 30px;
        max-width: 1400px;
        margin: 0 auto;
    }

    /* === HEADER === */
    .page-header {
        margin-bottom: 30px;
    }

        .page-header h1 {
            font-size: 28px;
            font-weight: 600;
            margin-bottom: 8px;
        }

    .page-subtitle {
        color: #8b92a7;
        font-size: 14px;
    }

    .product-name {
        color: #dc3545;
        font-weight: 600;
    }

    /* === ALERT === */
    .alert {
        padding: 16px 20px;
        border-radius: 8px;
        margin-bottom: 24px;
        font-size: 14px;
        font-weight: 500;
        animation: slideDown 0.3s ease;
    }

    .alert-success {
        background: rgba(40, 167, 69, 0.2);
        border: 1px solid #28a745;
        color: #28a745;
    }
    .form-card {
        background: #1a1f2e;
        border-radius: 12px;
        border: 1px solid #2a3142;
        padding: 30px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    }

    .form-header {
        margin-bottom: 30px;
        padding-bottom: 20px;
        border-bottom: 1px solid #2a3142;
    }

        .form-header h2 {
            font-size: 22px;
            font-weight: 600;
            margin-bottom: 8px;
            color: #fff;
        }

        .form-header p {
            font-size: 14px;
            color: #8b92a7;
        }

    /* === FORM GRID === */
    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        .form-group label {
            font-size: 14px;
            font-weight: 500;
            color: #d6dcff;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            padding: 10px 14px;
            border-radius: 8px;
            border: 1px solid #2a3142;
            background: #0a0e1a;
            color: #fff;
            font-size: 14px;
            outline: none;
            transition: all 0.2s;
            font-family: inherit;
        }

        .form-group textarea {
            resize: vertical;
            min-height: 80px;
        }

            .form-group input:focus,
            .form-group select:focus,
            .form-group textarea:focus {
                border-color: #dc3545;
                background: #0f1420;
            }

            .form-group input::placeholder,
            .form-group textarea::placeholder {
                color: #5a6172;
            }

        .form-group small {
            font-size: 12px;
            color: #8b92a7;
        }

    .text-danger {
        color: #dc3545;
        font-size: 16px;
        margin-top: 4px;
    }

    .required {
        color: #dc3545;
    }

    /* === IMAGE UPLOAD === */
    .image-section {
        background: #0f1420;
        border-radius: 8px;
        padding: 20px;
        border: 1px solid #2a3142;
    }

        .image-section h3 {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 16px;
            color: #fff;
        }

    .image-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 16px;
    }

    .image-upload-box {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .image-upload-box label {
            font-size: 13px;
            color: #8b92a7;
            font-weight: 500;
        }

        .image-upload-box input[type="file"] {
            padding: 8px;
            font-size: 13px;
        }

    .image-preview-grid {
        display: grid;
        grid-template-columns: 2fr 3fr;
        gap: 16px;
        margin-top: 20px;
    }

    .preview-main {
        background: #0a0e1a;
        border-radius: 8px;
        padding: 12px;
        border: 1px solid #2a3142;
    }

        .preview-main img {
            width: 100%;
            height: 280px;
            object-fit: cover;
            border-radius: 6px;
            background: #000;
        }

    .preview-sub {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }

    .preview-item {
        background: #0a0e1a;
        border-radius: 8px;
        padding: 10px;
        border: 1px solid #2a3142;
    }

        .preview-item img {
            width: 100%;
            height: 100px;
            object-fit: cover;
            border-radius: 6px;
            background: #000;
        }

    .preview-label {
        font-size: 12px;
        color: #8b92a7;
        margin-bottom: 8px;
        font-weight: 500;
    }

    /* === BUTTONS === */
    .form-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        padding-top: 20px;
        border-top: 1px solid #2a3142;
    }

    .btn {
        padding: 10px 24px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        border: none;
        transition: all 0.2s;
    }

    .btn-primary {
        background: #dc3545;
        color: white;
    }

        .btn-primary:hover {
            background: #c82333;
        }

    .btn-secondary {
        background: transparent;
        border: 1px solid #2a3142;
        color: #8b92a7;
    }

        .btn-secondary:hover {
            background: #2a3142;
        }
</style>

<div class="wrapper">

    <div class="page-header">
        <h1>✎ Sửa sản phẩm</h1>
        <div class="page-subtitle">
            Cập nhật thông tin sản phẩm: <span class="product-name">@Model.TenSanPham</span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            ✓ @TempData["SuccessMessage"]
        </div>
    }

    <form asp-action="Sua" method="post" enctype="multipart/form-data" asp-route-id="@Model.MaSp">
        <input type="hidden" asp-for="MaSp" />
        <input type="hidden" name="HinhDaiDienCu" value="@ViewBag.HinhDaiDienHienTai" />

        <div class="form-card">

            <div class="form-header">
                <h2>Thông tin cơ bản</h2>
                <p>Cập nhật các thông tin chính về sản phẩm</p>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="MaDm">Danh mục sản phẩm <span class="required">*</span></label>
                    <select asp-for="MaDm" asp-items="@ViewBag.DanhSachDanhMuc">
                        <option value="">-- Chọn danh mục --</option>
                    </select>
                    <span asp-validation-for="MaDm" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TenSanPham">Tên sản phẩm <span class="required">*</span></label>
                    <input type="text" asp-for="TenSanPham" placeholder="VD: Conan Tập 1" required>
                    <span asp-validation-for="TenSanPham" class="text-danger"></span>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Mota">Mô tả</label>
                    <textarea asp-for="Mota" placeholder="Nhập mô tả chi tiết về sản phẩm"></textarea>
                    <span asp-validation-for="Mota" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Gia">Giá (VNĐ) <span class="required">*</span></label>
                    @* Đã xóa min="0" và step="1000" để dùng [Range] C# và tránh lỗi 'multiple of 1000' tiếng Anh *@
                    <input type="number" asp-for="Gia" placeholder="VD: 50000">
                    <span asp-validation-for="Gia" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PhanTramGiam">% Giảm giá</label>
                    @* Đã xóa min="0" và max="100" để dùng [Range] C# và tránh lỗi tiếng Anh *@
                    <input type="number" asp-for="PhanTramGiam">
                    <span asp-validation-for="PhanTramGiam" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SoLuong">Số lượng <span class="required">*</span></label>
                    @* Đã xóa min="0" để dùng [Range] C# *@
                    <input type="number" asp-for="SoLuong">
                    <span asp-validation-for="SoLuong" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TrangThai">Trạng thái</label>
                    <select asp-for="TrangThai">
                        <option value="Còn hàng">Còn hàng</option>
                        <option value="Ngừng bán">Ngừng bán</option>
                        <option value="Hết hàng">Hết hàng</option>
                    </select>
                </div>
            </div>

            <div class="form-header" style="margin-top: 30px;">
                <h2>Chi tiết sản phẩm</h2>
                <p>Cập nhật thông tin bổ sung về sản phẩm</p>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label asp-for="TacGia">Tác giả</label>
                    <input type="text" asp-for="TacGia" placeholder="Nhập tên tác giả">
                    <span asp-validation-for="TacGia" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Nxb">Nhà xuất bản</label>
                    <input type="text" asp-for="Nxb" placeholder="VD: NXB Kim Đồng">
                    <span asp-validation-for="Nxb" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NamXb">Năm xuất bản</label>
                    @* Đã xóa min="1900" và max="2100" để dùng [Range] C# *@
                    <input type="number" asp-for="NamXb" placeholder="VD: 2024">
                    <span asp-validation-for="NamXb" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NgonNgu">Ngôn ngữ</label>
                    <input type="text" asp-for="NgonNgu" placeholder="VD: Tiếng Việt">
                    <span asp-validation-for="NgonNgu" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SoTrang">Số trang</label>
                    @* Đã xóa min="1" để dùng [Range] C# *@
                    <input type="number" asp-for="SoTrang" placeholder="VD: 300">
                    <span asp-validation-for="SoTrang" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TrongLuong">Trọng lượng (gram)</label>
                    @* Đã xóa min="0" để dùng [Range] C# *@
                    <input type="number" asp-for="TrongLuong" placeholder="VD: 500">
                    <span asp-validation-for="TrongLuong" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="KichThuoc">Kích thước</label>
                    <input type="text" asp-for="KichThuoc" placeholder="VD: 15cm x 20cm x 3cm">
                    <span asp-validation-for="KichThuoc" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="HinhThuc">Hình thức</label>
                    <input type="text" asp-for="HinhThuc" placeholder="VD: Bìa cứng, Bìa mềm">
                    <span asp-validation-for="HinhThuc" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group full-width" style="margin-top: 30px;">
                <div class="image-section">
                    <h3>📷 Cập nhật hình ảnh sản phẩm</h3>

                    <div class="image-grid">
                        <div class="image-upload-box">
                            <label>Ảnh chính</label>
                            <input type="file" id="AnhChinh" asp-for="AnhChinh" accept="image/*">
                            <span asp-validation-for="AnhChinh" class="text-danger"></span>
                        </div>

                        <div class="image-upload-box">
                            <label>Ảnh phụ 1</label>
                            <input type="file" id="AnhPhu1" asp-for="AnhPhu1" accept="image/*">
                        </div>

                        <div class="image-upload-box">
                            <label>Ảnh phụ 2</label>
                            <input type="file" id="AnhPhu2" asp-for="AnhPhu2" accept="image/*">
                        </div>

                        <div class="image-upload-box">
                            <label>Ảnh phụ 3</label>
                            <input type="file" id="AnhPhu3" asp-for="AnhPhu3" accept="image/*">
                        </div>
                    </div>

                    <small style="display: block; margin-bottom: 16px;">
                        💡 Chỉ chọn ảnh nếu muốn thay đổi. Để trống để giữ nguyên ảnh hiện tại.
                    </small>

                    <div class="image-preview-grid">
                        <div class="preview-main">
                            <div class="preview-label">Ảnh chính (Hiện tại)</div>
                            <img id="previewAnhChinh" src="@ViewBag.AnhChinhUrlHienTai" alt="Ảnh chính">
                        </div>
                        <div class="preview-sub">
                            @{
                                var anhPhuHienTai = ViewBag.AnhPhuHienTai as List<string> ?? new List<string>();
                                for (int i = 0; i < 3; i++)
                                {
                                    string url = (anhPhuHienTai.Count > i)
                                    ? $"/image/{anhPhuHienTai[i]}"
                                    : "/image/placeholder.jpg";
                                    <div class="preview-item">
                                        <div class="preview-label">Ảnh phụ @(i + 1)</div>
                                        <img id="previewAnhPhu@(i + 1)" src="@url" alt="Ảnh phụ @(i + 1)">
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-secondary" onclick="history.back()">
                    Hủy
                </button>
                <button type="submit" class="btn btn-primary">
                    💾 Cập nhật sản phẩm
                </button>
            </div>
        </div>
    </form>

</div>

<script>
    // Preview ảnh khi chọn file mới
    function bindImagePreview(inputId, imgId) {
        const input = document.getElementById(inputId);
        const img = document.getElementById(imgId);

        if (!input || !img) return;

        input.addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function (ev) {
                img.src = ev.target.result;
            };
            reader.readAsDataURL(file);
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        bindImagePreview('AnhChinh', 'previewAnhChinh');
        bindImagePreview('AnhPhu1', 'previewAnhPhu1');
        bindImagePreview('AnhPhu2', 'previewAnhPhu2');
        bindImagePreview('AnhPhu3', 'previewAnhPhu3');

        // Cần đảm bảo các script jQuery Validation đã được tải ở _Layout.cshtml
    });
</script>