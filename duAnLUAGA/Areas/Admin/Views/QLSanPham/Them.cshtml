@model duAnLUAGA.Areas.Admin.ViewModels.SanPhamUploadVM

@{
    ViewData["Title"] = "Thêm sản phẩm mới";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    /* === 1. GIAO DIỆN CHUNG LUXURY (GIỮ NGUYÊN) === */
    :root {
        --bg-dark: #121212;
        --card-bg: #1e1e1e;
        --accent-red: #e50914;
        --text-white: #e5e5e5;
        --text-muted: #8b92a7;
        --border-color: #333;
        --input-bg: #0f1420;
    }

    body {
        background-color: var(--bg-dark) !important;
        color: var(--text-white);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .wrapper {
        padding: 30px;
        max-width: 1400px;
        margin: 0 auto;
    }

    /* === HEADER & CARD === */
    .page-header {
        margin-bottom: 25px;
    }

    .luxury-header {
        border-left: 4px solid var(--accent-red);
        padding-left: 15px;
        color: var(--text-white);
        font-weight: 700;
        text-transform: uppercase;
        margin: 0;
        font-size: 24px;
    }

    .luxury-card {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 25px;
        margin-bottom: 30px;
    }

    /* === INPUT STYLES === */
    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        font-size: 13px;
        color: var(--text-muted);
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
        text-transform: uppercase;
    }

    .form-control-lux {
        width: 100%;
        background: var(--input-bg);
        border: 1px solid var(--border-color);
        color: #fff;
        padding: 10px 15px;
        border-radius: 6px;
        font-size: 14px;
        outline: none;
        transition: 0.3s;
    }

        .form-control-lux:focus {
            border-color: var(--accent-red);
        }

    textarea.form-control-lux {
        min-height: 120px;
        resize: vertical;
    }

    /* Style cho dòng thông báo lỗi */
    .text-danger {
        font-size: 12px;
        color: #ff4d4d;
        margin-top: 5px;
        display: block;
        font-style: italic; /* In nghiêng cho đẹp */
    }

    /* === UPLOAD & PREVIEW ĐƠN GIẢN === */
    .upload-box {
        background: var(--input-bg);
        border: 1px dashed var(--border-color);
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        text-align: center;
    }

    .btn-upload {
        display: inline-block;
        padding: 8px 20px;
        background: #333;
        color: #fff;
        border-radius: 4px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        border: 1px solid #555;
        transition: 0.2s;
        margin-bottom: 10px;
    }

        .btn-upload:hover {
            background: var(--accent-red);
            border-color: var(--accent-red);
        }

    input[type="file"] {
        display: none;
    }

    /* Preview Ảnh Chính */
    .preview-main-box {
        width: 100%;
        height: 300px;
        background: #000;
        border: 1px solid #333;
        border-radius: 6px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 10px;
    }

        .preview-main-box img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

    /* Preview Ảnh Phụ (Lưới đơn giản) */
    .preview-sub-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
        gap: 10px;
        margin-top: 15px;
    }

    .preview-sub-item {
        height: 80px;
        border: 1px solid #333;
        border-radius: 4px;
        overflow: hidden;
        background: #000;
    }

        .preview-sub-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    /* === BUTTONS === */
    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 15px;
        margin-top: 20px;
        border-top: 1px solid #333;
        padding-top: 20px;
    }

    .btn-submit {
        background: var(--accent-red);
        color: #fff;
        border: none;
        padding: 12px 30px;
        border-radius: 6px;
        font-weight: 700;
        cursor: pointer;
    }

    .btn-back {
        background: transparent;
        border: 1px solid #555;
        color: #ccc;
        padding: 12px 25px;
        border-radius: 6px;
        text-decoration: none;
    }
</style>

<div class="wrapper">
    <div class="page-header">
        <h2 class="luxury-header">Thêm sản phẩm mới</h2>
    </div>

    <form asp-action="Them" method="post" enctype="multipart/form-data">
        <div class="row" style="display:flex; flex-wrap:wrap; margin: -15px;">

            <div class="col-lg-4" style="flex: 0 0 35%; max-width: 35%; padding: 15px;">
                <div class="luxury-card">
                    <h3 style="font-size:18px; font-weight:700; margin-bottom:20px; color:#fff;">Hình ảnh</h3>

                    <div class="form-group">
                        <label class="form-label">Ảnh đại diện *</label>
                        <div class="upload-box">
                            <label class="btn-upload" for="AnhChinh">Chọn ảnh</label>
                            <input asp-for="AnhChinh" type="file" accept="image/*" onchange="previewMain(this)">

                            <div class="preview-main-box">
                                <img id="imgMainPreview" src="/image/default.jpg" alt="Chưa chọn ảnh">
                            </div>
                        </div>
                        <span asp-validation-for="AnhChinh" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Ảnh chi tiết (Nhiều ảnh)</label>
                        <div class="upload-box">
                            <label class="btn-upload" for="DanhSachAnhPhu">Chọn nhiều ảnh</label>
                            <input asp-for="DanhSachAnhPhu" type="file" multiple accept="image/*" onchange="previewSub(this)">

                            <div id="divSubPreview" class="preview-sub-grid"></div>
                            <small style="color:#666; display:block; margin-top:10px;">(Tối đa 20 ảnh)</small>
                        </div>
                        <span asp-validation-for="DanhSachAnhPhu" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="col-lg-8" style="flex: 0 0 65%; max-width: 65%; padding: 15px;">
                <div class="luxury-card">
                    <h3 style="font-size:18px; font-weight:700; margin-bottom:20px; color:#fff; border-bottom:1px solid #333; padding-bottom:10px;">Thông tin chi tiết</h3>

                    <div class="row" style="display:flex; flex-wrap:wrap; margin: -10px;">

                        <div class="col-md-6" style="width:50%; padding:10px;">
                            <div class="form-group">
                                <label asp-for="MaDm" class="form-label">Danh mục <span style="color:red">*</span></label>
                                <select asp-for="MaDm" asp-items="@ViewBag.DanhSachDanhMuc" class="form-control-lux">
                                    <option value="">-- Chọn danh mục --</option>
                                </select>
                                <span asp-validation-for="MaDm" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6" style="width:50%; padding:10px;">
                            <div class="form-group">
                                <label asp-for="TenSanPham" class="form-label">Tên sản phẩm <span style="color:red">*</span></label>
                                <input asp-for="TenSanPham" class="form-control-lux" placeholder="Nhập tên sản phẩm...">
                                <span asp-validation-for="TenSanPham" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4" style="width:33.33%; padding:10px;">
                            <div class="form-group">
                                <label asp-for="Gia" class="form-label">Giá bán</label>
                                <input asp-for="Gia" type="number" class="form-control-lux">
                                <span asp-validation-for="Gia" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4" style="width:33.33%; padding:10px;">
                            <div class="form-group">
                                <label asp-for="PhanTramGiam" class="form-label">% Giảm</label>
                                <input asp-for="PhanTramGiam" type="number" class="form-control-lux" value="0">
                                <span asp-validation-for="PhanTramGiam" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4" style="width:33.33%; padding:10px;">
                            <div class="form-group">
                                <label asp-for="SoLuong" class="form-label">Số lượng</label>
                                <input asp-for="SoLuong" type="number" class="form-control-lux" value="0">
                                <span asp-validation-for="SoLuong" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-12" style="width:100%; padding:10px;">
                            <div class="form-group">
                                <label asp-for="TrangThai" class="form-label">Trạng thái</label>
                                <select asp-for="TrangThai" class="form-control-lux">
                                    <option value="Còn hàng">Còn hàng</option>
                                    <option value="Ngừng bán">Ngừng bán</option>
                                    <option value="Hết hàng">Hết hàng</option>
                                </select>
                                <span asp-validation-for="TrangThai" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-12" style="width:100%; padding:10px;">
                            <div class="form-group">
                                <label asp-for="Mota" class="form-label">Mô tả</label>
                                <textarea asp-for="Mota" class="form-control-lux"></textarea>
                                <span asp-validation-for="Mota" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <h4 style="font-size:15px; color:#ccc; border-bottom:1px dashed #333; margin:20px 0 15px 0; padding-bottom:5px;">Thông số bổ sung</h4>

                    <div class="row" style="display:flex; flex-wrap:wrap; margin: -10px;">

                        <div class="col-md-4" style="width:33.33%; padding:10px;">
                            <div class="form-group">
                                <label class="form-label">Tác giả</label>
                                <input asp-for="TacGia" class="form-control-lux">
                                <span asp-validation-for="TacGia" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4" style="width:33.33%; padding:10px;">
                            <div class="form-group">
                                <label class="form-label">NXB</label>
                                <input asp-for="Nxb" class="form-control-lux">
                                <span asp-validation-for="Nxb" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4" style="width:33.33%; padding:10px;">
                            <div class="form-group">
                                <label class="form-label">Năm XB</label>
                                <input asp-for="NamXb" type="number" class="form-control-lux">
                                <span asp-validation-for="NamXb" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4" style="width:33.33%; padding:10px;">
                            <div class="form-group">
                                <label class="form-label">Ngôn ngữ</label>
                                <select asp-for="NgonNgu" class="form-control-lux">
                                    <option value="Tiếng Việt">Tiếng Việt</option>
                                    <option value="Tiếng Anh">Tiếng Anh</option>
                                    <option value="Tiếng Trung">Tiếng Trung</option>
                                    <option value="Tiếng Nhật">Tiếng Nhật</option>
                                    <option value="Tiếng Hàn">Tiếng Hàn</option>
                                    <option value="Tiếng Pháp">Tiếng Pháp</option>
                                    <option value="Tiếng Đức">Tiếng Đức</option>
                                    <option value="Tiếng Nga">Tiếng Nga</option>
                                    <option value="Tiếng Tây Ban Nha">Tiếng Tây Ban Nha</option>
                                    <option value="Tiếng Ý">Tiếng Ý</option>
                                    <option value="Tiếng Thái">Tiếng Thái</option>
                                </select>
                                <span asp-validation-for="NgonNgu" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4" style="width:33.33%; padding:10px;">
                            <div class="form-group">
                                <label class="form-label">Số trang</label>
                                <input asp-for="SoTrang" type="number" class="form-control-lux">
                                <span asp-validation-for="SoTrang" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4" style="width:33.33%; padding:10px;">
                            <div class="form-group">
                                <label class="form-label">Trọng lượng</label>
                                <input asp-for="TrongLuong" type="number" class="form-control-lux">
                                <span asp-validation-for="TrongLuong" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4" style="width:33.33%; padding:10px;">
                            <div class="form-group">
                                <label class="form-label">Kích thước</label>
                                <select asp-for="KichThuoc" class="form-control-lux">
                                    <option value="10cm x 14cm">10cm x 14cm</option>
                                    <option value="13cm x 19cm">13cm x 19cm</option>
                                    <option value="14.5cm x 20.5cm">14.5cm x 20.5cm</option>
                                    <option value="16cm x 24cm">16cm x 24cm</option>
                                    <option value="19cm x 27cm">19cm x 27cm</option>
                                    <option value="21cm x 29.7cm">21cm x 29.7cm</option>
                                </select>
                                <span asp-validation-for="KichThuoc" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-4" style="width:33.33%; padding:10px;">
                            <div class="form-group">
                                <label class="form-label">Hình thức</label>
                                <select asp-for="HinhThuc" class="form-control-lux">
                                    <option value="Bìa mềm">Bìa mềm</option>
                                    <option value="Bìa cứng">Bìa cứng</option>
                                </select>
                                <span asp-validation-for="HinhThuc" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions">
                        <a asp-action="Index" class="btn-back">Hủy bỏ</a>
                        <button type="submit" class="btn-submit">💾 Lưu sản phẩm</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script>
    // 1. Preview Ảnh Chính
    function previewMain(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('imgMainPreview').src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    // 2. Preview Danh Sách Ảnh Phụ (Dạng lưới)
    function previewSub(input) {
        var container = document.getElementById('divSubPreview');
        container.innerHTML = ''; // Xóa cũ

        if (input.files) {
            Array.from(input.files).forEach(file => {
                var reader = new FileReader();
                reader.onload = function (e) {
                    var div = document.createElement('div');
                    div.className = 'preview-sub-item';
                    var img = document.createElement('img');
                    img.src = e.target.result;
                    div.appendChild(img);
                    container.appendChild(div);
                }
                reader.readAsDataURL(file);
            });
        }
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}