@model duAnLUAGA.Areas.Admin.ViewModels.SanPhamUploadVM

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<style>
    /* === STYLE CHUNG LUXURY (ĐEN - ĐỎ) - GIỮ NGUYÊN === */
    :root {
        --bg-dark: #121212;
        --card-bg: #1e1e1e;
        --accent-red: #e50914;
        --text-white: #e5e5e5;
        --text-muted: #8b92a7;
        --border-color: #333;
    }

    body {
        background-color: var(--bg-dark) !important;
        color: var(--text-white);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* === HEADER & CARD (GIỮ NGUYÊN) === */
    .luxury-header {
        border-left: 4px solid var(--accent-red);
        padding-left: 15px;
        color: var(--text-white);
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 0;
    }

    .luxury-card {
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.4);
        padding: 30px;
        margin-bottom: 30px;
    }

    .section-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--text-white);
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 10px;
        margin-bottom: 20px;
    }

    /* === INFO DISPLAY (GIỮ NGUYÊN) === */
    .info-group {
        margin-bottom: 20px;
    }

    .info-label {
        font-size: 13px;
        color: var(--text-muted);
        font-weight: 500;
        display: block;
        margin-bottom: 5px;
        text-transform: uppercase;
    }

    .info-value {
        font-size: 15px;
        color: #fff;
        font-weight: 500;
    }

        .info-value.highlight {
            color: var(--accent-red);
            font-size: 20px;
            font-weight: 700;
        }

        .info-value.desc {
            line-height: 1.6;
            color: #ccc;
            font-size: 14px;
            background: #151a27;
            padding: 15px;
            border-radius: 4px;
            border: 1px solid #333;
        }

    /* === IMAGES === */
    .main-image-box {
        width: 100%;
        height: 400px;
        background: #000;
        border: 1px solid #333;
        border-radius: 8px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 15px;
    }

        .main-image-box img {
            width: 100%;
            height: 100%;
            object-fit: contain; /* Dùng contain để thấy toàn bộ ảnh */
            transition: transform 0.3s;
        }

    /* Thanh trượt Thumbnails */
    .thumbs-wrapper {
        position: relative;
        padding: 0 30px; /* Chừa chỗ cho nút mũi tên */
    }

    .thumb-slider {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        scroll-behavior: smooth;
        padding-bottom: 5px;
    }
        /* Ẩn thanh cuộn cho đẹp */
        .thumb-slider::-webkit-scrollbar {
            height: 4px;
        }

        .thumb-slider::-webkit-scrollbar-thumb {
            background: #333;
            border-radius: 2px;
        }

        .thumb-slider::-webkit-scrollbar-track {
            background: transparent;
        }

    .thumb-item {
        min-width: 80px;
        width: 80px;
        height: 80px;
        border: 2px solid transparent;
        border-radius: 4px;
        overflow: hidden;
        cursor: pointer;
        opacity: 0.6;
        transition: all 0.2s;
        background: #000;
    }

        .thumb-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .thumb-item:hover {
            opacity: 1;
            border-color: #666;
        }

        /* Thumb đang chọn */
        .thumb-item.active {
            opacity: 1;
            border-color: var(--accent-red);
            box-shadow: 0 0 10px rgba(229, 9, 20, 0.3);
        }

    /* Nút mũi tên Slider */
    .slider-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 25px;
        height: 50px;
        background: rgba(0,0,0,0.5);
        color: #fff;
        border: none;
        cursor: pointer;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
        border-radius: 4px;
    }

        .slider-btn:hover {
            background: var(--accent-red);
        }

    .slider-prev {
        left: 0;
    }

    .slider-next {
        right: 0;
    }

    /* === BADGES === */
    .badge-luxury {
        padding: 6px 12px;
        border-radius: 4px;
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        display: inline-block;
    }

    .badge-success-lux {
        background: rgba(40, 167, 69, 0.2);
        color: #28a745;
        border: 1px solid #28a745;
    }

    .badge-warning-lux {
        background: rgba(255, 193, 7, 0.2);
        color: #ffc107;
        border: 1px solid #ffc107;
    }

    .badge-danger-lux {
        background: rgba(220, 53, 69, 0.2);
        color: #dc3545;
        border: 1px solid #dc3545;
    }

    /* === BUTTONS === */
    .btn-luxury {
        background-color: var(--accent-red);
        color: white;
        border: none;
        padding: 10px 25px;
        font-weight: 600;
        border-radius: 4px;
        transition: 0.3s;
        text-decoration: none;
        display: inline-block;
    }

        .btn-luxury:hover {
            background-color: #b20710;
            color: white;
            transform: translateY(-2px);
        }

    .btn-cancel {
        background: transparent;
        border: 1px solid #555;
        color: #ccc;
        padding: 10px 25px;
        border-radius: 4px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
        transition: 0.2s;
    }

        .btn-cancel:hover {
            background: #333;
            color: #fff;
            border-color: #fff;
        }

</style>

<div class="container-fluid p-4" style="min-height: 100vh;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="luxury-header">Chi tiết sản phẩm</h2>
            <small class="text-muted ml-3">Thông tin chi tiết: #@Model.MaSp</small>
        </div>
        <div>
            <a asp-action="Index" asp-controller="QLSanPham" class="btn-cancel mr-2">
                <i class="fas fa-arrow-left mr-2"></i> Quay lại
            </a>
            <a asp-action="Sua" asp-controller="QLSanPham" asp-route-id="@Model.MaSp" class="btn-luxury">
                <i class="fas fa-pen mr-2"></i> Chỉnh sửa
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-4 col-md-12">
            <div class="luxury-card">
                <div class="section-title">Hình ảnh sản phẩm</div>

                <div class="gallery-container">
                    <div class="main-image-box">
                        <img id="mainImage" src="@ViewBag.AnhChinhUrl" alt="@Model.TenSanPham"
                             onerror="this.onerror=null; this.src='/image/default.jpg'">
                    </div>

                    <div class="thumbs-wrapper">
                        <button class="slider-btn slider-prev" onclick="navigateImage(-1)">
                            <i class="fas fa-chevron-left"></i>
                        </button>

                        <div id="thumbSlider" class="thumb-slider">
                            <div class="thumb-item active" onclick="changeImage(this, '@ViewBag.AnhChinhUrl')">
                                <img src="@ViewBag.AnhChinhUrl" onerror="this.onerror=null; this.src='/image/default.jpg';">
                            </div>

                            @{
                                var anhPhuUrls = ViewBag.AnhPhuUrls as List<string>;
                                if (anhPhuUrls != null && anhPhuUrls.Count > 0)
                                {
                                    foreach (var url in anhPhuUrls)
                                    {
                                        <div class="thumb-item" onclick="changeImage(this, '@url')">
                                            <img src="@url" onerror="this.onerror=null; this.src='/image/default.jpg';">
                                        </div>
                                    }
                                }
                            }
                        </div>

                        <button class="slider-btn slider-next" onclick="navigateImage(1)">
                            <i class="fas fa-chevron-right"></i>
                        </button>
                    </div>

                    @if (anhPhuUrls == null || anhPhuUrls.Count == 0)
                    {
                        <p class="text-muted mt-3 text-center" style="font-style:italic; font-size:13px;">Chỉ có ảnh đại diện</p>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8 col-md-12">
            <div class="luxury-card">
                <div class="section-title">Thông tin chung</div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="info-group">
                            <span class="info-label">Tên sản phẩm</span>
                            <div class="info-value" style="font-size: 24px; font-weight: 700;">@Model.TenSanPham</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="info-group">
                            <span class="info-label">Giá bán</span>
                            <div class="info-value highlight">@Model.Gia.ToString("N0") đ</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-group">
                            <span class="info-label">Giảm giá</span>
                            <div class="info-value text-danger">
                                @(Model.PhanTramGiam > 0 ? $"{Model.PhanTramGiam}%" : "Không giảm")
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-group">
                            <span class="info-label">Danh mục</span>
                            <div class="info-value">@ViewBag.TenDanhMuc</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="info-group">
                            <span class="info-label">Trạng thái</span>
                            @if (Model.TrangThai == "Còn hàng")
                            {
                                <span class="badge-luxury badge-success-lux">Còn hàng</span>
                            }
                            else if (Model.TrangThai == "Sắp hết" || Model.TrangThai == "Ngừng bán")
                            {
                                <span class="badge-luxury badge-warning-lux">@Model.TrangThai</span>
                            }
                            else
                            {
                                <span class="badge-luxury badge-danger-lux">Hết hàng</span>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-group">
                            <span class="info-label">Số lượng tồn kho</span>
                            <div class="info-value">@Model.SoLuong</div>
                        </div>
                    </div>
                </div>

                <div class="info-group mt-3">
                    <span class="info-label">Mô tả sản phẩm</span>
                    <div class="info-value desc">
                        @(string.IsNullOrEmpty(Model.Mota) ? "Chưa cập nhật mô tả cho sản phẩm này." : Model.Mota)
                    </div>
                </div>
            </div>

            <div class="luxury-card">
                <div class="section-title">Thông số chi tiết</div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="info-group">
                            <span class="info-label">Tác giả</span>
                            <div class="info-value">@(Model.TacGia ?? "---")</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-group">
                            <span class="info-label">Nhà xuất bản</span>
                            <div class="info-value">@(Model.Nxb ?? "---")</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-group">
                            <span class="info-label">Năm xuất bản</span>
                            <div class="info-value">@(Model.NamXb?.ToString() ?? "---")</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="info-group">
                            <span class="info-label">Ngôn ngữ</span>
                            <div class="info-value">@(Model.NgonNgu ?? "---")</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-group">
                            <span class="info-label">Số trang</span>
                            <div class="info-value">@(Model.SoTrang?.ToString() ?? "---") trang</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-group">
                            <span class="info-label">Trọng lượng</span>
                            <div class="info-value">@(Model.TrongLuong?.ToString() ?? "---") gram</div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="info-group">
                            <span class="info-label">Kích thước</span>
                            <div class="info-value">@(Model.KichThuoc ?? "---")</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="info-group">
                            <span class="info-label">Hình thức</span>
                            <div class="info-value">@(Model.HinhThuc ?? "---")</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
        // Thay thế hàm changeImage cũ bằng hàm này (an toàn hơn)
    function changeImage(thumbElement, newSrc) {
        const mainImage = document.getElementById('mainImage');

        // Kiểm tra xem ảnh nguồn (thumbnail) có đang bị lỗi (đang hiển thị default.jpg) hay không
        const thumbImg = thumbElement.querySelector('img');
        if (thumbImg.src.includes('default.jpg')) {
            mainImage.src = '/image/default.jpg';
        } else {
            mainImage.src = newSrc;
        }

        // Xử lý active class (giữ nguyên)
        document.querySelectorAll('.thumb-item').forEach(t => t.classList.remove('active'));
        thumbElement.classList.add('active');
        thumbElement.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    }

    // 2. Hàm điều hướng (Next/Prev) khi bấm nút mũi tên
    function navigateImage(direction) {
        // Lấy danh sách tất cả các thumbnail
        const thumbs = document.querySelectorAll('.thumb-item');
        let activeIndex = 0;

        // Tìm vị trí của ảnh đang active
        thumbs.forEach((thumb, index) => {
            if (thumb.classList.contains('active')) {
                activeIndex = index;
            }
        });

        // Tính toán vị trí ảnh tiếp theo (có vòng lặp)
        let newIndex = activeIndex + direction;

        // Nếu lùi quá đầu -> nhảy về cuối
        if (newIndex < 0) {
            newIndex = thumbs.length - 1;
        }
        // Nếu tiến quá cuối -> nhảy về đầu
        if (newIndex >= thumbs.length) {
            newIndex = 0;
        }

        // Lấy thẻ thumbnail mới
        const nextThumb = thumbs[newIndex];
        // Lấy đường dẫn ảnh từ thẻ img bên trong thumbnail
        const nextSrc = nextThumb.querySelector('img').src;

        // Gọi hàm đổi ảnh
        changeImage(nextThumb, nextSrc);
    }
</script>