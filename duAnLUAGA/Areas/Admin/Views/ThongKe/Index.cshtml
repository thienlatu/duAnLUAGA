@model duAnLUAGA.ViewModel.StatisticsVM
@{
    ViewData["Title"] = "Dashboard Thống Kê";
    var formatMoney = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    var currentFilter = ViewBag.FilterType as string;

    string HienThiTrangThai(string status)
    {
        return status switch
        {
            "ChoXacNhan" => "Chờ xác nhận",
            "DaThanhToan" => "Đã thanh toán",
            "DaGiao" => "Đã giao hàng",
            "DangGiao" => "Đang giao",
            "DaHuy" => "Đã hủy",
            "ChoLayHang" => "Chờ lấy hàng",
            "dangchuanbi" => "Đang chuẩn bị",
            _ => status
        };
    }
}

<style>
    .dashboard-container {
        background-color: #191C24;
        color: #6C7293;
        padding: 20px;
        border-radius: 10px;
        min-height: 100vh;
    }

    .stat-card {
        background-color: #262b36;
        border-radius: 8px;
        padding: 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 0 10px rgba(0,0,0,0.3);
        transition: transform 0.3s;
    }

        .stat-card:hover {
            transform: translateY(-5px);
        }

    .stat-icon {
        font-size: 3rem;
        color: #EB1616;
    }

    .stat-text p {
        margin: 0;
        font-size: 14px;
        color: #a0a0a0;
    }

    .stat-text h6 {
        margin: 5px 0 0;
        font-size: 24px;
        color: #fff;
        font-weight: bold;
    }

    .chart-container {
        background-color: #262b36;
        border-radius: 8px;
        padding: 20px;
        margin-top: 20px;
        box-shadow: 0 0 10px rgba(0,0,0,0.3);
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 10px;
    }

    /* --- CSS NÚT BỘ LỌC --- */
    .filter-btn {
        display: inline-block;
        padding: 6px 16px;
        margin-left: 5px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        border-radius: 4px;
        transition: all 0.3s ease;
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: #e0e0e0;
        background-color: rgba(255, 255, 255, 0.05);
        cursor: pointer;
    }

        .filter-btn:hover {
            background-color: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.5);
            color: #fff;
        }

        .filter-btn.active {
            background-color: #EB1616;
            border-color: #EB1616;
            color: #fff;
            box-shadow: 0 0 8px rgba(235, 22, 22, 0.5);
        }

    /* --- STYLE CHO FORM TÌM KIẾM --- */
    .search-input {
        background-color: #000 !important;
        border: 1px solid #444;
        color: #fff !important;
        border-radius: 4px 0 0 4px !important;
    }

        .search-input:focus {
            border-color: #EB1616;
            box-shadow: none;
        }

    .btn-search {
        background-color: #EB1616;
        color: #fff;
        border: 1px solid #EB1616;
        border-radius: 0 4px 4px 0 !important;
    }

        .btn-search:hover {
            background-color: #c90d0d;
        }

    /* --- STYLE CHO NÚT CHI TIẾT --- */
    .btn-detail {
        padding: 4px 10px;
        font-size: 12px;
        border: 1px solid #444;
        color: #a0a0a0;
        border-radius: 4px;
        transition: 0.2s;
        background: transparent;
    }

        .btn-detail:hover {
            border-color: #EB1616;
            color: #EB1616;
            background: rgba(235, 22, 22, 0.1);
        }

    /* Bảng */
    .table-dark-custom {
        width: 100%;
        border-collapse: collapse;
        color: #a0a0a0;
    }

        .table-dark-custom th {
            text-align: left;
            padding: 15px;
            border-bottom: 1px solid #444;
            color: #fff;
            font-weight: 600;
        }

        .table-dark-custom td {
            padding: 12px 15px;
            border-bottom: 1px solid #333;
            vertical-align: middle;
        }

        .table-dark-custom tr:hover {
            background-color: #2c323f;
        }

    .badge-status {
        padding: 5px 10px;
        border-radius: 4px;
        font-size: 11px;
        color: #fff;
        font-weight: bold;
    }

    .bg-wait {
        background-color: #ffc107;
        color: #000;
    }

    .bg-done {
        background-color: #198754;
    }

    .bg-cancel {
        background-color: #dc3545;
    }

    .bg-info {
        background-color: #0dcaf0;
        color: #000;
    }
</style>

<div class="dashboard-container">
    <h3 style="color: #fff; margin-bottom: 20px;">Dashboard Quản Lý</h3>

    <div class="row g-4">
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <i class="fa fa-chart-line stat-icon"></i>
                <div class="text-end"><p>Tổng Doanh Thu</p><h6>@Model.TongDoanhThu.ToString("C0", formatMoney)</h6></div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <i class="fa fa-file-invoice-dollar stat-icon"></i>
                <div class="text-end"><p>Tổng Đơn Hàng</p><h6>@Model.TongDonHang</h6></div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <i class="fa fa-box stat-icon"></i>
                <div class="text-end"><p>Tổng Sản Phẩm</p><h6>@Model.TongSanPham</h6></div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="stat-card">
                <i class="fa fa-users stat-icon"></i>
                <div class="text-end"><p>Khách Hàng</p><h6>@Model.TongKhachHang</h6></div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-sm-12 col-xl-8">
            <div class="chart-container">
                <div class="chart-header">
                    <h6 style="color:#fff; margin:0;">Biểu đồ Doanh thu</h6>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <div class="d-flex align-items-center">
                            <span style="font-size:12px; color:#888; margin-right:5px;">Ngày:</span>
                            <input type="date" id="chartDateInput" value="@ViewBag.ChartDate"
                                   class="form-control form-control-sm search-input"
                                   style="width: 130px; height: 30px; font-size: 12px; border-radius: 4px !important;"
                                   onchange="filterChartByDate(this.value)">
                        </div>

                        <div>
                            <a href="@Url.Action("Index", new { filterType = "7days" })" class="filter-btn @(currentFilter == "7days" || currentFilter == null ? "active" : "")">7 Ngày</a>
                            <a href="@Url.Action("Index", new { filterType = "month" })" class="filter-btn @(currentFilter == "month" ? "active" : "")">Tháng này</a>
                            <a href="@Url.Action("Index", new { filterType = "year" })" class="filter-btn @(currentFilter == "year" ? "active" : "")">Năm nay</a>
                        </div>
                    </div>
                </div>
                <canvas id="revenue-chart" style="max-height: 300px;"></canvas>
            </div>
        </div>
        <div class="col-sm-12 col-xl-4">
            <div class="chart-container">
                <div class="chart-header"><h6 style="color:#fff; margin:0;">Tỷ lệ đơn hàng</h6></div>
                <canvas id="status-chart" style="max-height: 300px;"></canvas>
            </div>
        </div>
    </div>

    <div class="chart-container mt-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <h6 class="text-white m-0">Danh sách đơn hàng (@(Model.DonHangMoiNhat?.Count ?? 0) đơn)</h6>

            <form method="get" action="@Url.Action("Index")" class="d-flex flex-wrap gap-2 align-items-center mt-2 mt-md-0">
                <input type="hidden" name="filterType" value="@ViewBag.FilterType" />
                @{
                    var fDate = ViewBag.FilterDateOrder as string;
                }

                <div>
                    <button type="submit" name="filterDateOrder" value="all" class="filter-btn @(fDate == "all" || fDate == null ? "active" : "")">Tất cả</button>
                    <button type="submit" name="filterDateOrder" value="today" class="filter-btn @(fDate == "today" ? "active" : "")">Hôm nay</button>
                    <button type="submit" name="filterDateOrder" value="this_week" class="filter-btn @(fDate == "this_week" ? "active" : "")">Tuần này</button>
                    <button type="submit" name="filterDateOrder" value="this_month" class="filter-btn @(fDate == "this_month" ? "active" : "")">Tháng này</button>
                </div>

                <div class="input-group input-group-sm" style="width: 250px; margin-left: 10px;">
                    <input type="text" name="searchOrder" value="@ViewBag.SearchOrder" class="form-control search-input" placeholder="Tìm Mã HĐ, Tên khách...">
                    <button class="btn btn-search" type="submit"><i class="fa fa-search"></i></button>
                </div>
                <a href="@Url.Action("Index")" class="filter-btn" style="padding: 6px 10px;" title="Làm mới"><i class="fa fa-sync"></i></a>
            </form>
        </div>

        <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
            <table class="table-dark-custom">
                <thead style="position: sticky; top: 0; background-color: #262b36; z-index: 5;">
                    <tr>
                        <th>Ngày đặt</th>
                        <th>Mã HĐ</th>
                        <th>Khách hàng</th>
                        <th>Tổng tiền</th>
                        <th>Thanh toán</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DonHangMoiNhat != null && Model.DonHangMoiNhat.Any())
                    {
                        foreach (var item in Model.DonHangMoiNhat)
                        {
                            <tr>
                                <td>@item.NgayXuatHoaDon.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-white">#@item.MaHd</td>
                                <td>@(item.MaKhNavigation?.HoVaTen ?? "Khách lẻ")</td>
                                <td style="color:#EB1616; font-weight:bold;">@item.ThanhTien.ToString("N0")₫</td>
                                <td>@item.Httt</td>
                                <td>
                                    @{
                                        var sttTV = HienThiTrangThai(item.TrangThai);
                                        var css = "bg-info";
                                        if (item.TrangThai == "ChoXacNhan") css = "bg-wait";
                                        if (item.TrangThai == "DaThanhToan" || item.TrangThai == "DaGiao") css = "bg-done";
                                        if (item.TrangThai == "DaHuy") css = "bg-cancel";
                                    }
                                    <span class="badge-status @css">@sttTV</span>
                                </td>
                                <td>
                                    <button type="button" class="btn-detail" onclick="openOrderDetail(@item.MaHd)">
                                        <i class="fa fa-eye"></i> Chi tiết
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted">Không tìm thấy đơn hàng nào phù hợp.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="orderDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div id="modalContentContainer" style="width: 100%;"></div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    Chart.defaults.color = "#a0a0a0";
    Chart.defaults.borderColor = "#444";

    // 1. Revenue Chart
    new Chart(document.getElementById("revenue-chart"), {
        type: "bar",
        data: {
            labels: @Html.Raw(Json.Serialize(Model.NgayBaoCao)),
            datasets: [{
                label: "Doanh thu (VNĐ)",
                data: @Html.Raw(Json.Serialize(Model.DoanhThuNgay)),
                backgroundColor: "#EB1616",
                borderRadius: 4,
                barPercentage: 0.6
            }]
        },
        options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, grid: { color: "#333" }, ticks: { callback: function(v){ return v.toLocaleString() + 'đ'; } } }, x: { grid: { display: false } } }, plugins: { legend: { display: false }, tooltip: { callbacks: { label: function(c){ return c.parsed.y.toLocaleString() + ' đ'; } } } } }
    });

    // 2. Status Chart
    function generateColors(count) {
        const p = ["#EB1616", "#ffc107", "#198754", "#0dcaf0", "#6c757d", "#6610f2", "#d63384"];
        let c = []; for(let i=0; i<count; i++) c.push(p[i % p.length]); return c;
    }
    var sData = @Html.Raw(Json.Serialize(Model.SoLuongTrangThai));
    new Chart(document.getElementById("status-chart"), {
        type: "doughnut",
        data: {
            labels: @Html.Raw(Json.Serialize(Model.LabelTrangThai)),
            datasets: [{ data: sData, backgroundColor: generateColors(sData.length), borderWidth: 0 }]
        },
        options: { responsive: true, maintainAspectRatio: false, cutout: '70%', plugins: { legend: { position: 'right', labels: { padding: 20, color: "#fff", font: { size: 11 } } } } }
    });

    // 3. AJAX Open Modal
    function openOrderDetail(orderId) {
        $.get('/Admin/ThongKe/GetOrderDetails?id=' + orderId)
        .done(function (data) {
            $('#modalContentContainer').html(data);
            var myModal = new bootstrap.Modal(document.getElementById('orderDetailModal'));
            myModal.show();
        })
        .fail(function(jqXHR, textStatus, errorThrown) {
            alert("Lỗi tải dữ liệu! Kiểm tra xem file _OrderDetailPartial.cshtml đã tạo chưa?");
        });
    }

    // 4. Filter Chart By Date
    function filterChartByDate(dateVal) {
        // Chuyển hướng với tham số chartDate
        var currentUrl = new URL(window.location.href);
        currentUrl.searchParams.set("filterType", "date");
        currentUrl.searchParams.set("chartDate", dateVal);
        window.location.href = currentUrl.toString();
    }
</script>