@model duAnLUAGA.Areas.Admin.ViewModels.KhachHangVM
@{
    ViewData["Title"] = "Sửa Khách hàng";
}

<div class="container-fluid pt-4 px-4">
    <div class="bg-secondary rounded p-4">
        <h3 class="mb-4">Sửa Thông tin Khách hàng</h3>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MaKh" />
            <input type="hidden" asp-for="NgayTao" />
            <input type="hidden" asp-for="HinhAnh" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="HoVaTen" class="form-label"></label>
                    <input asp-for="HoVaTen" class="form-control" />
                    <span asp-validation-for="HoVaTen" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MatKhau" class="form-label">Mật khẩu mới (để trống nếu không đổi)</label>
                    <div class="input-group">
                        <input asp-for="MatKhau" class="form-control" type="password" id="matKhauEditKH" placeholder="Để trống nếu không đổi mật khẩu" data-val="false" />
                        <button class="btn btn-outline-secondary" type="button" id="togglePasswordEditKH">
                            <i class="fa fa-eye" id="eyeIconEditKH"></i>
                        </button>
                    </div>
                    <span asp-validation-for="MatKhau" class="text-danger"></span>
                    <small class="form-text text-muted">Để trống nếu không muốn đổi mật khẩu. Nếu nhập, mật khẩu phải từ 8 đến 11 ký tự</small>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="GioiTinh" class="form-label"></label>
                    <select asp-for="GioiTinh" class="form-select">
                        <option value="">-- Chọn --</option>
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                        <option value="Khác">Khác</option>
                    </select>
                    <span asp-validation-for="GioiTinh" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="HinhAnhFile" class="form-label"></label>
                <div class="kh-photo-wrapper text-center">
                    <div class="kh-photo-display">
                        @{
                            var khEditImageUrl = string.IsNullOrEmpty(Model.HinhAnh)
                                ? string.Empty
                                : Url.Content($"~/img/{Model.HinhAnh}");
                        }
                        @if (!string.IsNullOrEmpty(khEditImageUrl))
                        {
                            <img id="khEditImgPreview" src="@khEditImageUrl" alt="Ảnh khách hàng" />
                            <div class="kh-photo-empty d-none">
                                <i class="fa fa-image"></i>
                                <p>HÌNH ẢNH KHÁCH HÀNG</p>
                            </div>
                        }
                        else
                        {
                            <img id="khEditImgPreview" src="#" alt="Ảnh khách hàng" style="display:none;" />
                            <div class="kh-photo-empty">
                                <i class="fa fa-image"></i>
                                <p>HÌNH ẢNH KHÁCH HÀNG</p>
                            </div>
                        }
                    </div>
                    <div class="mt-3">
                        <label asp-for="HinhAnhFile" class="btn btn-outline-light kh-photo-button" for="HinhAnhFileEditInput">
                            <i class="fa fa-camera me-2"></i> CHỌN ẢNH TỪ MÁY
                        </label>
                        <input asp-for="HinhAnhFile" id="HinhAnhFileEditInput" class="d-none" type="file" accept="image/*" />
                        <p id="khEditFileName" class="kh-photo-info text-muted small mb-0">
                            @(!string.IsNullOrEmpty(Model.HinhAnh) ? $"Ảnh hiện tại: {Model.HinhAnh}" : "Chưa chọn tệp")
                        </p>
                        <span asp-validation-for="HinhAnhFile" class="text-danger d-block mt-1"></span>
                        <small class="form-text text-muted">
                            Chọn file ảnh mới để thay thế (JPG, JPEG, PNG, GIF), dung lượng tối đa 5MB
                        </small>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Ngày tạo:</label>
                <input type="text" class="form-control" value="@Model.NgayTao.ToString("dd/MM/yyyy")" readonly />
            </div>

            <div class="mb-3 form-check">
                <input asp-for="TrangThai" class="form-check-input" type="checkbox" />
                <label asp-for="TrangThai" class="form-check-label">
                    Kích hoạt tài khoản
                </label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save me-2"></i>Cập nhật
                </button>
                <a asp-area="Admin" asp-controller="DiaChi" asp-action="Index" asp-route-maKh="@Model.MaKh" class="btn btn-info">
                    <i class="fa fa-map-marker-alt me-2"></i>Quản lý Địa chỉ
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fa fa-arrow-left me-2"></i>Quay lại
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            // Toggle password visibility - Edit
            $('#togglePasswordEditKH').on('click', function () {
                const passwordField = $('#matKhauEditKH');
                const eyeIcon = $('#eyeIconEditKH');
                if (passwordField.attr('type') === 'password') {
                    passwordField.attr('type', 'text');
                    eyeIcon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    passwordField.attr('type', 'password');
                    eyeIcon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            // Disable client-side validation cho mật khẩu khi để trống
            $('#matKhauEditKH').on('input blur', function () {
                if ($(this).val() === '') {
                    $(this).removeAttr('data-val-required');
                    $(this).removeAttr('data-val-length');
                    $(this).removeAttr('data-val-length-min');
                    $(this).removeAttr('data-val-length-max');
                    $(this).removeClass('input-validation-error');
                    $(this).next('.field-validation-error').remove();
                } else {
                    // Nếu có nhập, validate lại
                    const val = $(this).val();
                    if (val.length < 8 || val.length > 11) {
                        $(this).addClass('input-validation-error');
                    } else {
                        $(this).removeClass('input-validation-error');
                    }
                }
            });

            // Khi form submit, nếu mật khẩu trống thì bỏ qua validation
            $('form').on('submit', function (e) {
                const matKhau = $('#matKhauEditKH').val();
                if (matKhau === '') {
                    $('#matKhauEditKH').removeAttr('data-val');
                    $('#matKhauEditKH').removeAttr('data-val-required');
                    $('#matKhauEditKH').removeAttr('data-val-length');
                }
            });

            var originalImgUrl = '@(string.IsNullOrEmpty(Model.HinhAnh) ? "" : Url.Content($"~/img/{Model.HinhAnh}"))';

            // Preview ảnh khách hàng (Edit)
            $('#HinhAnhFileEditInput').on('change', function (e) {
                const file = e.target.files[0];
                const $preview = $('#khEditImgPreview');
                const $empty = $('.kh-photo-empty');
                const $fileName = $('#khEditFileName');

                if (file) {
                    // Kiểm tra dung lượng tối đa 5MB
                    if (file.size > 5 * 1024 * 1024) {
                        alert('File ảnh không được vượt quá 5MB. Vui lòng chọn file khác.');
                        $(this).val('');
                        if (originalImgUrl) {
                            $preview.attr('src', originalImgUrl).show();
                            $empty.addClass('d-none');
                        } else {
                            $preview.hide();
                            $empty.removeClass('d-none');
                        }
                        $fileName.text(originalImgUrl ? 'Ảnh hiện tại: ' + '@Model.HinhAnh' : 'Chưa chọn tệp');
                        return;
                    }

                    // Kiểm tra định dạng file
                    const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
                    if (!validTypes.includes(file.type)) {
                        alert('Chỉ chấp nhận file ảnh (JPG, JPEG, PNG, GIF). Vui lòng chọn file khác.');
                        $(this).val('');
                        if (originalImgUrl) {
                            $preview.attr('src', originalImgUrl).show();
                            $empty.addClass('d-none');
                        } else {
                            $preview.hide();
                            $empty.removeClass('d-none');
                        }
                        $fileName.text(originalImgUrl ? 'Ảnh hiện tại: ' + '@Model.HinhAnh' : 'Chưa chọn tệp');
                        return;
                    }

                    $fileName.text('Tệp: ' + file.name);

                    const reader = new FileReader();
                    reader.onload = function (ev) {
                        $preview.attr('src', ev.target.result).show();
                        $empty.addClass('d-none');
                    };
                    reader.readAsDataURL(file);
                } else {
                    if (originalImgUrl) {
                        $preview.attr('src', originalImgUrl).show();
                        $empty.addClass('d-none');
                        $fileName.text('Ảnh hiện tại: ' + '@Model.HinhAnh');
                    } else {
                        $preview.hide();
                        $empty.removeClass('d-none');
                        $fileName.text('Chưa chọn tệp');
                    }
                }
            });
        });
    </script>

    <style>
        /* Tông chữ trắng cho form Sửa Khách hàng */
        .bg-secondary.rounded.p-4 {
            color: #fff;
        }

        .bg-secondary.rounded.p-4 h3,
        .bg-secondary.rounded.p-4 label.form-label,
        .bg-secondary.rounded.p-4 small,
        .bg-secondary.rounded.p-4 .form-check-label {
            color: #fff !important;
        }

        .bg-secondary.rounded.p-4 .form-control,
        .bg-secondary.rounded.p-4 .form-select {
            color: #fff;
            background-color: rgba(0, 0, 0, 0.3);
            border-color: rgba(255, 255, 255, 0.15);
        }

        .bg-secondary.rounded.p-4 .form-control::placeholder {
            color: rgba(255, 255, 255, 0.8);
        }

        .bg-secondary.rounded.p-4 .form-select option {
            color: #000;
        }

        .bg-secondary.rounded.p-4 .text-muted {
            color: rgba(255, 255, 255, 0.75) !important;
        }

        .kh-photo-wrapper {
            display: inline-block;
            max-width: 100%;
        }

        .kh-photo-display {
            background: #000;
            border: 1px solid rgba(255, 255, 255, 0.15);
            min-height: 220px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 10px;
        }

        .kh-photo-display img {
            max-width: 100%;
            max-height: 360px;
            border: 1px solid #800020;
            object-fit: contain;
        }

        .kh-photo-empty {
            color: rgba(255, 255, 255, 0.25);
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 11px;
        }

        .kh-photo-empty i {
            font-size: 3rem;
            margin-bottom: 8px;
        }

        .kh-photo-button {
            border-radius: 0;
            border-color: #800020;
            color: #fff;
        }

        .kh-photo-button:hover {
            background-color: #800020;
            color: #fff;
        }

        .kh-photo-info {
            margin-top: 8px;
        }
    </style>
}

