<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"] - LUAGA Admin</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <link href="~/templateAdmin/img/favicon.ico" rel="icon">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Roboto:wght@500;700&display=swap" rel="stylesheet">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <link href="~/templateAdmin/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="~/templateAdmin/lib/tempusdominus/css/tempusdominus-bootstrap-4.min.css" rel="stylesheet" />

    <link href="~/templateAdmin/css/bootstrap.min.css" rel="stylesheet">

    <link href="~/templateAdmin/css/style.css" rel="stylesheet">
</head>

<body>
    <div class="container-fluid position-relative d-flex p-0">

        <div id="spinner" class="show bg-dark position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="sr-only">Loading...</span>
            </div>
        </div>
        <div class="sidebar pe-4 pb-3">
            <nav class="navbar bg-secondary navbar-dark">
                <a href="@Url.Action("Index", "ThongKe", new { area = "Admin" })" class="navbar-brand mx-4 mb-3">
                    <h3 class="text-primary"><i class="fa fa-user-edit me-2"></i>LUAGA</h3>
                </a>
                <div class="d-flex align-items-center ms-4 mb-4">
                    <div class="position-relative">
                        <img class="rounded-circle" src="~/templateAdmin/img/user.jpg" alt="" style="width: 40px; height: 40px;">
                        <div class="bg-success rounded-circle border border-2 border-white position-absolute end-0 bottom-0 p-1"></div>
                    </div>
                    <div class="ms-3">
                        <h6 class="mb-0">Admin</h6>
                        <span>Quản trị viên</span>
                    </div>
                </div>
                <div class="navbar-nav w-100">
                    <a asp-area="Admin" asp-controller="ThongKe" asp-action="Index" class="nav-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ThongKe" ? "active" : "")">
                        <i class="fa fa-tachometer-alt me-2"></i>Dashboard
                    </a>

                    <a asp-area="Admin" asp-controller="QLSanPham" asp-action="Index" class="nav-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SanPham" ? "active" : "")">
                        <i class="fa fa-box me-2"></i>Sản Phẩm
                    </a>
                   
                    <a asp-area="Admin" asp-controller="DanhMuc" asp-action="Index" class="nav-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DanhMuc" ? "active" : "")">
                        <i class="fa fa-table me-2"></i>Danh Mục
                    </a>

                    <a asp-area="Admin" asp-controller="Order" asp-action="Index" class="nav-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")">
                        <i class="fa fa-file-invoice-dollar me-2"></i>Đơn Hàng
                    </a>

                    <a asp-area="Admin" asp-controller="KhachHang" asp-action="Index" class="nav-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "KhachHang" ? "active" : "")">
                        <i class="fa fa-users me-2"></i>Khách Hàng
                    </a>

                    <a asp-area="Admin" asp-controller="VoucherManager" asp-action="Index" class="nav-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "VoucherManager" ? "active" : "")">
                        <i class="fa fa-ticket-alt me-2"></i>Mã Giảm Giá
                    </a>

                    <a asp-area="Admin"asp-controller="NhanVien" asp-action="Index" class="nav-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "NhanVien" ? "active" : "")"> 
                       <i class="fa fa-chart-bar me-2"></i>Nhân Viên
                    </a>

                    <a href="#" class="nav-item nav-link"><i class="fa fa-bolt me-2"></i>Flash Sale</a>
                    <a asp-area="Admin" asp-controller="QLDanhGia" asp-action="Index" class="nav-item nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "QLDanhGia" ? "active" : "")">
                        <i class="fa fa-star me-2"></i>Đánh Giá
                    </a>
                </div>
            </nav>
        </div>
        <div class="content">
            <nav class="navbar navbar-expand bg-secondary navbar-dark sticky-top px-4 py-0">
                <a href="index.html" class="navbar-brand d-flex d-lg-none me-4">
                    <h2 class="text-primary mb-0"><i class="fa fa-user-edit"></i></h2>
                </a>
                <a href="#" class="sidebar-toggler flex-shrink-0">
                    <i class="fa fa-bars"></i>
                </a>
                <form class="d-none d-md-flex ms-4">
                    <input class="form-control bg-dark border-0" type="search" placeholder="Search">
                </form>
                <div class="navbar-nav align-items-center ms-auto">
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                            <img class="rounded-circle me-lg-2" src="~/templateAdmin/img/user.jpg" alt="" style="width: 40px; height: 40px;">
                            <span class="d-none d-lg-inline-flex">Admin</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end bg-secondary border-0 rounded-0 rounded-bottom m-0">
                            <a href="#" class="dropdown-item">Hồ sơ</a>
                            <a href="#" class="dropdown-item">Cài đặt</a>
                            <a asp-area="" asp-controller="Home" asp-action="Index" class="dropdown-item">Về trang chủ</a>
                            <div class="dropdown-divider"></div>
                            <a asp-area="LoginArea" asp-controller="LoginArea" asp-action="Logout" class="dropdown-item text-danger">Đăng Xuất</a>
                        </div>
                    </div>
                </div>
            </nav>
            <div class="container-fluid pt-4 px-4">
                @RenderBody()
            </div>
            <div class="container-fluid pt-4 px-4">
                <div class="bg-secondary rounded-top p-4">
                    <div class="row">
                        <div class="col-12 col-sm-6 text-center text-sm-start">
                            &copy; <a href="#">LUAGA</a>, All Right Reserved.
                        </div>
                        <div class="col-12 col-sm-6 text-center text-sm-end">
                            Designed By <a href="#">LUAGA Team</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <a href="#" class="btn btn-lg btn-primary btn-lg-square back-to-top"><i class="bi bi-arrow-up"></i></a>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/templateAdmin/lib/chart/chart.min.js"></script>
    <script src="~/templateAdmin/lib/easing/easing.min.js"></script>
    <script src="~/templateAdmin/lib/waypoints/waypoints.min.js"></script>
    <script src="~/templateAdmin/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="~/templateAdmin/lib/tempusdominus/js/moment.min.js"></script>
    <script src="~/templateAdmin/lib/tempusdominus/js/moment-timezone.min.js"></script>
    <script src="~/templateAdmin/lib/tempusdominus/js/tempusdominus-bootstrap-4.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/templateAdmin/js/main.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>