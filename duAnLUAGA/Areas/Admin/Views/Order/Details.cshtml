@model duAnLUAGA.Domain.Entitie.Hoadon
@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng #" + Model.MaHd;
    var formatMoney = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<div class="container-fluid" style="background-color: #191C24; min-height: 100vh; padding: 30px; color: #a0a0a0;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-white">Chi Tiết Đơn Hàng <span class="text-danger">#@Model.MaHd</span></h3>
        <a href="/Admin/Order" class="btn btn-outline-secondary">Quay lại danh sách</a>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="bg-secondary rounded p-4 mb-4">
                <h5 class="text-white mb-3">Sản phẩm</h5>
                <div class="table-responsive">
                    <table class="table table-dark table-bordered">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Đơn giá</th>
                                <th class="text-center">SL</th>
                                <th class="text-end">Tổng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Chitiethoadons)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@(item.MaSpNavigation.HinhDaiDien ?? "/img/no-image.png")" style="width:50px; height:50px; border-radius:4px; margin-right:10px;">
                                            <div>
                                                <div class="text-white fw-bold">@item.MaSpNavigation.TenSanPham</div>
                                                <small>Mã: @item.MaSp</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center align-middle">@item.DonGia.ToString("N0")₫</td>
                                    <td class="text-center align-middle">x @item.SoLuong</td>
                                    <td class="text-end align-middle text-white">@((item.DonGia * item.SoLuong).ToString("N0"))₫</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="bg-secondary rounded p-4">
                <div class="d-flex justify-content-between mb-2"><span>Tổng tiền hàng:</span> <span class="text-white">@Model.TongTien.ToString("N0")₫</span></div>
                <div class="d-flex justify-content-between mb-2"><span>Phí vận chuyển:</span> <span class="text-white">@Model.PhiVanChuyen.ToString("N0")₫</span></div>
                <div class="d-flex justify-content-between mb-3"><span>Giảm giá:</span> <span class="text-danger">-@Model.TienGiamGia.ToString("N0")₫</span></div>
                <div class="d-flex justify-content-between border-top border-dark pt-3">
                    <strong class="text-white fs-5">TỔNG THANH TOÁN:</strong>
                    <strong class="text-danger fs-4">@Model.ThanhTien.ToString("N0")₫</strong>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="bg-secondary rounded p-4 mb-4">
                <h5 class="text-white mb-3">Trạng thái đơn hàng</h5>

                <div class="alert alert-dark text-center mb-3">
                    @{
                        var stt = Model.TrangThai?.Trim().ToLower();
                        var sttText = stt switch
                        {
                            "choxacnhan" => "Chờ xác nhận",
                            "cholayhang" => "Chờ lấy hàng",
                            "danggiao" => "Đang giao hàng",
                            "dagiao" => "Đã giao thành công",
                            "dathanhtoan" => "Đã thanh toán",
                            "chuathanhtoan" => "Chưa thanh toán",
                            "dahuy" => "Đã hủy",
                            "deogiao" => "Giao thất bại",
                            _ => Model.TrangThai
                        };
                    }
                    <strong class="text-uppercase fs-5 text-info">@sttText</strong>
                </div>

                @if (stt == "dahuy" && !string.IsNullOrEmpty(Model.LyDoHuy))
                {
                    <div class="alert alert-danger mb-3 p-2 small">
                        <strong>Lý do hủy:</strong> @Model.LyDoHuy
                    </div>
                }

                <div class="d-grid gap-2">
                    @if (stt == "choxacnhan" || stt == "dathanhtoan")
                    {
                        <button class="btn btn-success" onclick="updateStatus('ChoLayHang')">Duyệt đơn hàng</button>
                        <button class="btn btn-outline-danger" onclick="updateStatus('DaHuy')">Hủy đơn hàng</button>
                    }

                    @if (stt == "chuathanhtoan")
                    {
                        <button class="btn btn-info text-white" onclick="updateStatus('DaThanhToan')">Xác nhận đã thu tiền</button>
                        <button class="btn btn-outline-danger" onclick="updateStatus('DaHuy')">Hủy bỏ đơn này</button>
                    }

                    @if (stt == "cholayhang")
                    {
                        <button class="btn btn-primary" onclick="updateStatus('DangGiao')">Giao cho vận chuyển</button>
                    }

                    @if (stt == "danggiao")
                    {
                        <button class="btn btn-success" onclick="updateStatus('DaGiao')">Xác nhận giao thành công</button>
                        <button class="btn btn-warning text-dark" onclick="updateStatus('DeoGiao')">Báo giao thất bại</button>
                    }

                    @if (stt == "deogiao")
                    {
                        <div class="alert alert-warning text-center small py-1 mb-2">Xử lý sự cố:</div>
                        <button class="btn btn-primary btn-sm" onclick="updateStatus('DangGiao')">Giao lại lần nữa</button>
                        <button class="btn btn-success btn-sm" onclick="updateStatus('DaGiao')">Đã giao (Sửa sai)</button>
                        <button class="btn btn-danger btn-sm" onclick="updateStatus('DaHuy')">Hủy đơn (Hoàn hàng)</button>
                    }
                </div>
            </div>

            <div class="bg-secondary rounded p-4">
                <h5 class="text-white mb-3">Thông tin giao hàng</h5>
                <p class="mb-1 text-white fw-bold">@Model.MaKhNavigation.HoVaTen</p>
                <p class="mb-3">@Model.MaKhNavigation.Email</p>
                <h6 class="text-primary small text-uppercase fw-bold">Người nhận:</h6>
                @if (Model.IdNavigation != null)
                {
                    <p class="mb-1 text-white">@Model.IdNavigation.TenNhanHang</p>
                    <p class="mb-1">@Model.IdNavigation.Sdt</p>
                    <p class="small">@Model.IdNavigation.DiaChiChiTiet, @Model.IdNavigation.XaPhuong, @Model.IdNavigation.Tinh</p>
                }
                else
                {

                    <span class="text-warning">Không có địa chỉ</span>
                }
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const Toast = Swal.mixin({
        toast: true, position: 'top-end', showConfirmButton: false, timer: 1500, timerProgressBar: true
    });

    function updateStatus(status) {
        let actionName = status === 'DaHuy' ? 'Hủy đơn hàng' : 'Cập nhật trạng thái';
        let iconType = status === 'DaHuy' ? 'warning' : 'info';
        let btnColor = status === 'DaHuy' ? '#d33' : '#28a745';
        let reason = "";

        // Nếu là hủy -> Hiện ô nhập lý do
        if (status === 'DaHuy') {
            Swal.fire({
                title: 'Hủy Đơn Hàng',
                input: 'text',
                inputLabel: 'Nhập lý do hủy đơn:',
                inputPlaceholder: 'Ví dụ: Khách bom hàng, Hết kho...',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Xác nhận Hủy',
                cancelButtonText: 'Quay lại',
                background: '#262b36', color: '#fff',
                inputValidator: (value) => { if (!value) return 'Vui lòng nhập lý do!' }
            }).then((result) => {
                if (result.isConfirmed) {
                    callUpdateApi(status, result.value);
                }
            });
        } else {
            // Các trạng thái khác -> Xác nhận thường
            Swal.fire({
                title: 'Xác nhận',
                text: `Bạn có chắc chắn muốn ${actionName}?`,
                icon: iconType,
                showCancelButton: true,
                confirmButtonColor: btnColor,
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý',
                background: '#262b36', color: '#fff'
            }).then((result) => {
                if (result.isConfirmed) {
                    callUpdateApi(status, "");
                }
            });
        }
    }

    function callUpdateApi(status, reason) {
        $.post('/Admin/Order/UpdateStatus', {
            id: @Model.MaHd,
            newStatus: status,
            lyDo: reason
        }, function(res) {
            if(res.success) {
                Swal.fire({
                    title: 'Thành công!', text: 'Cập nhật thành công.', icon: 'success',
                    confirmButtonColor: '#EB1616', background: '#262b36', color: '#fff'
                }).then(() => { location.reload(); });
            } else {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: res.message, background: '#262b36', color: '#fff' });
            }
        });
    }
</script>