@model IEnumerable<duAnLUAGA.Domain.Entitie.Hoadon>
@{
    ViewData["Title"] = "Quản Lý Đơn Hàng";
    var formatMoney = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    var currentStatus = ViewBag.StatusFilter as string;
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;

    string GetBadgeClass(string status)
    {
        return status switch
        {
            "ChoXacNhan" => "bg-warning text-dark",
            "ChoLayHang" => "bg-info text-dark",
            "DangGiao" => "bg-primary",
            "DaGiao" => "bg-success",
            "DaHuy" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    string GetStatusName(string status)
    {
        var s = status?.Trim().ToLower();
        return s switch
        {
            "choxacnhan" => "Chờ xác nhận",
            "cholayhang" => "Chờ lấy hàng",
            "danggiao" => "Đang giao",
            "dagiao" => "Hoàn thành", // Fix ở đây
            "dahuy" => "Đã hủy",
            _ => status
        };
    }
}

<style>
    .order-container {
        background-color: #191C24;
        color: #6C7293;
        padding: 20px;
        border-radius: 10px;
        min-height: 100vh;
    }

    /* Tabs Trạng Thái */
    .status-tabs {
        display: flex;
        gap: 10px;
        border-bottom: 1px solid #444;
        padding-bottom: 15px;
        margin-bottom: 20px;
        overflow-x: auto;
    }

    .tab-btn {
        padding: 8px 16px;
        border-radius: 20px;
        color: #a0a0a0;
        text-decoration: none;
        font-size: 13px;
        white-space: nowrap;
        border: 1px solid transparent;
        transition: 0.3s;
    }

        .tab-btn:hover {
            background: #2c323f;
            color: #fff;
        }

        .tab-btn.active {
            background: #EB1616;
            color: #fff;
            border-color: #EB1616;
        }

    /* Search Box */
    .search-box {
        background: #000;
        border: 1px solid #444;
        color: #fff;
        border-radius: 4px;
        padding: 8px 12px;
        width: 300px;
    }

    .btn-action {
        padding: 4px 10px;
        font-size: 12px;
        border-radius: 4px;
    }

    .table-dark-custom th {
        background-color: #262b36;
        color: #fff;
        border-bottom: 2px solid #444;
        padding: 15px;
    }

    .table-dark-custom td {
        border-bottom: 1px solid #333;
        padding: 15px;
        vertical-align: middle;
        color: #a0a0a0;
    }

    .table-dark-custom tr:hover td {
        background-color: #22262f;
    }

    /* Pagination */
    .page-link {
        background: #262b36;
        border-color: #444;
        color: #a0a0a0;
    }

    .page-item.active .page-link {
        background-color: #EB1616;
        border-color: #EB1616;
        color: #fff;
    }
</style>

<div class="order-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="text-white m-0">Quản Lý Đơn Hàng</h3>
        <form method="get" class="d-flex">
            <input type="hidden" name="statusFilter" value="@currentStatus" />
            <input type="text" name="searchString" class="search-box me-2" placeholder="Tìm Mã HĐ hoặc Tên khách..." value="@ViewBag.SearchString">
            <button type="submit" class="btn btn-danger"><i class="fa fa-search"></i></button>
        </form>
    </div>

    <div class="status-tabs">
        <a href="@Url.Action("Index", new { statusFilter = "all" })" class="tab-btn @(string.IsNullOrEmpty(currentStatus) || currentStatus == "all" ? "active" : "")">Tất cả</a>
        <a href="@Url.Action("Index", new { statusFilter = "ChoXacNhan" })" class="tab-btn @(currentStatus == "ChoXacNhan" ? "active" : "")">Chờ xác nhận</a>
        <a href="@Url.Action("Index", new { statusFilter = "ChoLayHang" })" class="tab-btn @(currentStatus == "ChoLayHang" ? "active" : "")">Chờ lấy hàng</a>
        <a href="@Url.Action("Index", new { statusFilter = "DangGiao" })" class="tab-btn @(currentStatus == "DangGiao" ? "active" : "")">Đang giao</a>
        <a href="@Url.Action("Index", new { statusFilter = "DaGiao" })" class="tab-btn @(currentStatus == "DaGiao" ? "active" : "")">Hoàn thành</a>
        <a href="@Url.Action("Index", new { statusFilter = "DaHuy" })" class="tab-btn @(currentStatus == "DaHuy" ? "active" : "")">Đã hủy</a>
        <a href="@Url.Action("Index", new { statusFilter = "DaThanhToan" })" class="tab-btn @(currentStatus == "DaThanhToan" ? "active" : "")">Đã thanh toán</a>
        <a href="@Url.Action("Index", new { statusFilter = "ChuaThanhToan" })" class="tab-btn @(currentStatus == "ChuaThanhToan" ? "active" : "")">Chưa thanh toán</a>
    </div>

    <div class="table-responsive">
        <table class="table table-dark-custom w-100">
            <thead>
                <tr>
                    <th>Mã HĐ</th>
                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Thanh toán</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-white fw-bold">#@item.MaHd</td>
                            <td>
                                <div class="text-white">@(item.MaKhNavigation?.HoVaTen ?? "Khách lẻ")</div>
                                <small>@item.MaKh</small>
                            </td>
                            <td>@item.NgayXuatHoaDon.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-danger fw-bold">@item.ThanhTien.ToString("N0")₫</td>
                            <td><span class="badge bg-secondary text-uppercase">@item.Httt</span></td>
                            <td>
                                <span class="badge @GetBadgeClass(item.TrangThai)">@GetStatusName(item.TrangThai)</span>
                            </td>
                            <td class="text-end">

                                @if (item.TrangThai == "ChoXacNhan" || item.TrangThai == "DaThanhToan")
                                {
                                    <button class="btn btn-sm btn-success btn-action" onclick="updateStatus(@item.MaHd, 'ChoLayHang')">
                                        <i class="fa fa-check"></i> Duyệt
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger btn-action" onclick="updateStatus(@item.MaHd, 'DaHuy')">
                                        <i class="fa fa-times"></i> Hủy
                                    </button>
                                }

                                @if (item.TrangThai == "ChuaThanhToan")
                                {
                                    <button class="btn btn-sm btn-info btn-action text-white" onclick="updateStatus(@item.MaHd, 'DaThanhToan')" title="Xác nhận đã nhận tiền">
                                        <i class="fa fa-dollar-sign"></i> Đã thu tiền
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger btn-action" onclick="updateStatus(@item.MaHd, 'DaHuy')">
                                        <i class="fa fa-trash"></i> Hủy
                                    </button>
                                }

                                @if (item.TrangThai == "ChoLayHang")
                                {
                                    <button class="btn btn-sm btn-primary btn-action" onclick="updateStatus(@item.MaHd, 'DangGiao')">
                                        Giao
                                    </button>
                                }

                                @if (item.TrangThai == "DangGiao")
                                {
                                    <button class="btn btn-sm btn-success btn-action" onclick="updateStatus(@item.MaHd, 'DaGiao')">
                                        <i class="fa fa-check-circle"></i> Xong
                                    </button>
                                }


                                <a href="/Admin/Order/Details/@item.MaHd" class="btn btn-sm btn-outline-light btn-action ms-1">
                                    <i class="fa fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center py-5">Không tìm thấy đơn hàng nào.</td></tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i, statusFilter = currentStatus, searchString = ViewBag.SearchString })">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script>
        // Cấu hình Toast thông báo
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 1500,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });

        // Hàm cập nhật trạng thái (Phiên bản đẹp)
        function updateStatus(id, status) {
            // 1. Dịch tên trạng thái để hiện thông báo cho thân thiện
            let statusName = "";
            switch(status) {
                case 'ChoLayHang': statusName = "Duyệt đơn (Chờ lấy hàng)"; break;
                case 'DangGiao': statusName = "Giao hàng"; break;
                case 'DaGiao': statusName = "Hoàn thành đơn"; break;
                case 'DaHuy': statusName = "Hủy đơn hàng"; break;
                default: statusName = status;
            }

            // 2. Hiện Popup xác nhận
            Swal.fire({
                title: 'Xác nhận hành động?',
                text: `Bạn có chắc chắn muốn chuyển sang trạng thái: "${statusName}"?`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#EB1616', // Màu đỏ chủ đạo
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Đồng ý',
                cancelButtonText: 'Hủy bỏ',
                background: '#262b36', // Nền tối cho hợp theme
                color: '#fff'
            }).then((result) => {
                if (result.isConfirmed) {
                    // 3. Gọi Ajax
                    $.post('/Admin/Order/UpdateStatus', { id: id, newStatus: status }, function(res) {
                        if(res.success) {
                            // 4. Thông báo thành công
                            Toast.fire({
                                icon: 'success',
                                title: 'Cập nhật thành công!'
                            });

                            // Đợi 1.5s rồi reload trang
                            setTimeout(() => { location.reload(); }, 1500);
                        } else {
                            // Thông báo lỗi
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi',
                                text: res.message,
                                background: '#262b36',
                                color: '#fff'
                            });
                        }
                    });
                }
            });
        }
    </script>
}